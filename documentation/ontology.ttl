                                                                  rdfs:label "is rule enabled" .


###  http://www.geneontology.org/formats/oboInOwl#hasAlternativeId
<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> rdf:type owl:AnnotationProperty ;
                                                                rdfs:comment "An alternative identifier of a term, typically that of a term merged into it." ;
                                                                rdfs:label "has alternative identifier" .


###  http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym
<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> rdf:type owl:AnnotationProperty ;
                                                               rdfs:comment "A synonym that is broader in meaning than the label of the term." ;
                                                               rdfs:label "has broad synonym" .


###  http://www.geneontology.org/formats/oboInOwl#hasDbXref
<http://www.geneontology.org/formats/oboInOwl#hasDbXref> rdf:type owl:AnnotationProperty ;
                                                         rdfs:comment "A cross-reference from a term to an equivalent or related entry in another database or ontology, given as a prefixed identifier." ;
                                                         rdfs:label "has database cross-reference" .


###  http://www.geneontology.org/formats/oboInOwl#hasExactSynonym
<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> rdf:type owl:AnnotationProperty ;
                                                               rdfs:comment "A synonym with exactly the same meaning as the label of the term." ;
                                                               rdfs:label "has exact synonym" .


###  http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym
<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> rdf:type owl:AnnotationProperty ;
                                                                rdfs:comment "A synonym that is narrower in meaning than the label of the term." ;
                                                                rdfs:label "has narrow synonym" .


###  http://www.geneontology.org/formats/oboInOwl#hasOBONamespace
<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> rdf:type owl:AnnotationProperty ;
                                                               rdfs:comment "The OBO namespace that a term belongs to." ;
                                                               rdfs:label "has OBO namespace" .


###  http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym
<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> rdf:type owl:AnnotationProperty ;
                                                                 rdfs:comment "A synonym that is related to, but not exactly the same as, the label of the term." ;
                                                                 rdfs:label "has related synonym" .


###  http://www.geneontology.org/formats/oboInOwl#hasSynonymType
<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> rdf:type owl:AnnotationProperty ;
                                                              rdfs:comment "The type of a synonym, as defined by the source ontology." ;
                                                              rdfs:label "has synonym type" .


###  http://www.geneontology.org/formats/oboInOwl#id
<http://www.geneontology.org/formats/oboInOwl#id> rdf:type owl:AnnotationProperty ;
                                                  rdfs:comment "The OBO identifier of a term, e.g. DOID:0060224." ;
                                                  rdfs:label "id" .


###  http://www.geneontology.org/formats/oboInOwl#inSubset
<http://www.geneontology.org/formats/oboInOwl#inSubset> rdf:type owl:AnnotationProperty ;
                                                        rdfs:comment "A subset (slim) of the source ontology that a term belongs to." ;
                                                        rdfs:label "in subset" .


###  http://www.w3.org/2002/07/owl#equivalentClass
owl:equivalentClass rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#priorVersion
owl:priorVersion rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/06/sw-vocab-status/nsterm_status
<http://www.w3.org/2003/06/sw-vocab-status/nsterm_status> rdf:type owl:AnnotationProperty ;
                                                          rdfs:comment "The status of a vocabulary term, as used in some imported terms; a variant of the term status property." ;
                                                          rdfs:label "term status (variant)" .


###  http://www.w3.org/2003/06/sw-vocab-status/ns#term_status
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> rdf:type owl:AnnotationProperty ;
                                                           rdfs:comment "The status of a vocabulary term, e.g. stable, testing or unstable." ;
                                                           rdfs:label "term status" .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty ;
                                               rdfs:comment "An alternative lexical label for a resource." ;
                                               rdfs:label "alternative label" .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty ;
                                                 rdfs:comment "A statement or formal explanation of the meaning of a concept." ;
                                                 rdfs:label "definition" .


###  http://www.w3.org/2004/02/skos/core#editorialNote
<http://www.w3.org/2004/02/skos/core#editorialNote> rdf:type owl:AnnotationProperty ;
                                                    rdfs:comment "A note for an editor, translator or maintainer of the vocabulary." ;
                                                    rdfs:label "editorial note" .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty ;
                                                 rdfs:comment "A link between two concepts, indicating a high degree of confidence that they can be used interchangeably." ;
                                                 rdfs:label "exact match" .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty ;
                                              rdfs:comment "An example of the use of a concept." ;
                                              rdfs:label "example" .


