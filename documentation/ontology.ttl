[ rdf:type owl:Restriction ;
  owl:onProperty :hasBMI ;
  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                       owl:onDatatype xsd:decimal ;
                       owl:withRestrictions ( [ xsd:minInclusive 18.5
                                              ]
                                              [ xsd:maxExclusive 25.0
                                              ]
                                            )
                     ] ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty :hasBMICategory ;
                    owl:hasValue :Normal
                  ]
] .


[ rdf:type owl:Restriction ;
