:AnthropometricFactor rdfs:comment "A class to group risk factors for atrial fribrillation related to a person's body, e.g. height and BMI." ;
                      rdfs:label "Anthropometric factor" .


:BMICategory rdfs:comment """For adults, BMI falls into the following categories:

- Underweight: below 18.5
- Normal: 18.5 - 24.9
- Overweight: 25.0 - 29.9
- Obese I: 30.0 - 34.9
- Obese II: 35.0 - 39.9
- Obese III: above 40.0""" ;
             rdfs:label "BMI category" .


:DemographicFactor rdfs:comment "A class to group risk factors for atrial fribrillation related to a person's demographics. Demographics: the qualities (such as age and sex) of a specific group of people."@en ;
                   rdfs:label "Demographic factor" .


:LifestyleFactor rdfs:comment "A class to group risk factors for atrial fribrillation related to a person's lifestyle and choices."@en ;
                 rdfs:label "Lifestyle factor" .


:Sex rdfs:comment "Summary sex classification element based on one or more clinical observations such as an organ survey, hormone levels, and chromosomal analysis." ;
     rdfs:label "Sex" ;
     <http://www.w3.org/2004/02/skos/core#definition> "Summary sex classification element based on one or more clinical observations such as an organ survey, hormone levels, and chromosomal analysis." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Sex ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "Summary sex classification element based on one or more clinical observations such as an organ survey, hormone levels, and chromosomal analysis." ;
   rdfs:isDefinedBy "McClure, Robert C., et al. \"Gender harmony: improved standards to support affirmative care of gender-marginalized people through inclusive gender and sex representation.\" Journal of the American Medical Informatics Association 29.2 (2022): 354-363. https://doi-org.ezproxy.uct.ac.za/10.1093/jamia/ocab196"
 ] .


