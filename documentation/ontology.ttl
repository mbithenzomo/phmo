<http://www.w3.org/2004/02/skos/core#historyNote> rdf:type owl:AnnotationProperty ;
                                                  rdfs:comment "A note about the past state, use or meaning of a concept." ;
                                                  rdfs:label "history note" .


###  http://www.w3.org/2004/02/skos/core#note
<http://www.w3.org/2004/02/skos/core#note> rdf:type owl:AnnotationProperty ;
                                           rdfs:comment "A general note, for any purpose." ;
                                           rdfs:label "note" .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty ;
                                                rdfs:comment "The preferred lexical label for a resource, in a given language." ;
                                                rdfs:label "preferred label" .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
<http://www.w3.org/2004/02/skos/core#relatedMatch> rdf:type owl:AnnotationProperty ;
                                                   rdfs:comment "A link between two concepts in different schemes, indicating an associative, non-hierarchical relationship." ;
                                                   rdfs:label "related match" .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty ;
                                                rdfs:comment "A note that helps to clarify the meaning or use of a concept." ;
                                                rdfs:label "scope note" .


###  http://www.w3.org/2008/05/skos#note
<http://www.w3.org/2008/05/skos#note> rdf:type owl:AnnotationProperty ;
                                      rdfs:comment "A general note, for any purpose, using an earlier SKOS namespace." ;
                                      rdfs:label "note (SKOS 2008)" .


