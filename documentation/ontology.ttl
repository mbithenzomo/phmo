                       owl:onDatatype xsd:decimal ;
                       owl:withRestrictions ( [ xsd:minInclusive 25.0
                                              ]
                                              [ xsd:maxExclusive 30.0
                                              ]
                                            )
                     ] ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty :hasBMICategory ;
                    owl:hasValue :Overweight
                  ]
] .


