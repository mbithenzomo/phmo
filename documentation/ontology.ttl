xsd:duration rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYearMonth
xsd:gYearMonth rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn
<http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> rdf:type owl:ObjectProperty ;
                                                            owl:inverseOf :isBasisOf ;
                                                            rdfs:domain <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                            rdfs:range <https://purl.org/heals/eo#SystemRecommendation> ;
                                                            <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                            rdfs:comment "The relationship between an explanation and the system recommendation it is based on. The domain, range and inverse are added in AFMO." ;
                                                            rdfs:isDefinedBy <http://linkedu.eu/dedalo/explanationPattern.owl> ;
                                                            rdfs:label "is based on" .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:ObjectProperty ;
                                   rdfs:domain :Publication ;
                                   rdfs:range [ rdf:type owl:Class ;
                                                owl:unionOf ( :Author
                                                              <http://xmlns.com/foaf/0.1/Organization>
                                                            )
                                              ] .


###  http://purl.org/phmo#approvalStatusDeterminedByClinician
:approvalStatusDeterminedByClinician rdf:type owl:ObjectProperty ;
                                     owl:inverseOf :determinedApprovalStatusForIntervention ;
                                     rdfs:domain :HealthIntervention ;
                                     rdfs:range :Clinician ;
                                     rdfs:comment "The relationship between a health intervention and the clinician that determined its approval status." ;
                                     rdfs:label "approval status determined by clinician" .


###  http://purl.org/phmo#calculatedExpectedUtilityForIntervention
:calculatedExpectedUtilityForIntervention rdf:type owl:ObjectProperty ;
                                          owl:inverseOf :expectedUtilityCalculatedByModel ;
                                          rdfs:domain :BayesianDecisionNetwork ;
                                          rdfs:range :HealthIntervention ;
                                          rdfs:comment "The relationship between a model (specifically a Bayesian decision network) and a health intervention whose expected utility it calculated." ;
                                          rdfs:label "recommended intervention" .


###  http://purl.org/phmo#determinedApprovalStatusForIntervention
:determinedApprovalStatusForIntervention rdf:type owl:ObjectProperty ;
                                         rdfs:domain :Clinician ;
                                         rdfs:range :HealthIntervention ;
                                         rdfs:comment "The relationship between a clinician and a health intervention that they approved, pre-approved, or rejected." ;
                                         rdfs:label "determined approval status for intervention" .


###  http://purl.org/phmo#expectedUtilityCalculatedByModel
:expectedUtilityCalculatedByModel rdf:type owl:ObjectProperty ;
                                  rdfs:domain :HealthIntervention ;
                                  rdfs:range :BayesianDecisionNetwork ;
                                  rdfs:comment "The relationship between a health intervention and the model (specifically a Bayesian decision network) that calculated its expected utility." ;
                                  rdfs:label "expected utility calculated by model" .


###  http://purl.org/phmo#hasApprovalStatus
:hasApprovalStatus rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isApprovalStatusOfIntervention ;
                   rdfs:domain :HealthIntervention ;
                   rdfs:range :ApprovalStatus ;
                   rdfs:comment "The relationship between a health intervention and its approval status (approved, pre-approved, rejected, or pending)." ;
                   rdfs:label "has approval status" .


###  http://purl.org/phmo#hasBMICategory
:hasBMICategory rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasRiskFactorStatus ;
                owl:inverseOf :isBMICategoryOf ;
                rdfs:domain :MonitoredPerson ;
                rdfs:range :BMICategory ;
                rdfs:comment "The relationship between a monitored person and their BMI category." ;
                rdfs:label "has BMI category" .


###  http://purl.org/phmo#hasComorbidityStatus
:hasComorbidityStatus rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasRiskFactorStatus ;
                      owl:inverseOf :isComorbidityStatusOf ;
                      rdfs:domain :MonitoredPerson ;
                      rdfs:range :ComorbidityFactor ;
                      rdfs:comment "The relationship between a monitored person and a comorbidity risk factor status." ;
                      rdfs:label "has comorbidity status" .


###  http://purl.org/phmo#hasEffectModifier
:hasEffectModifier rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isEffectModifierInRelationship ;
                   rdfs:domain :StateRiskRelationship ;
                   rdfs:range :HealthRiskFactor ;
                   rdfs:comment "Links a health risk relationship to another risk factor state that modifies the risk associated with the relationship's primary risk factor state." ;
                   rdfs:label "has effect modifier" .


###  http://purl.org/phmo#hasHigherBMIThan
:hasHigherBMIThan rdf:type owl:ObjectProperty ;
                  owl:inverseOf :hasLowerBMIThan ;
                  rdf:type owl:TransitiveProperty ;
                  rdfs:domain :BMICategory ;
                  rdfs:range :BMICategory ;
                  rdfs:comment "Transitive property to add order to the BMICategory class." ;
                  rdfs:label "has higher BMI than" .


###  http://purl.org/phmo#hasInputObservation
:hasInputObservation rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isInputOfPrediction ;
                     rdfs:domain :HealthEventPrediction ;
                     rdfs:range :ContinuousObservation ;
                     rdfs:comment "The relationship between a health event prediction and the continuous observation used as input to the model that computes it." ;
                     rdfs:label "has input observation" .


###  http://purl.org/phmo#hasInputRiskFactor
:hasInputRiskFactor rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isInputRiskFactorOf ;
                    rdfs:domain :Model ;
                    rdfs:range :HealthRiskFactor ;
                    rdfs:comment "The relationship between a model and a risk factor it takes as input." ;
                    rdfs:label "has input risk factor" .


###  http://purl.org/phmo#hasInputRiskFactorState
:hasInputRiskFactorState rdf:type owl:ObjectProperty ;
                         owl:inverseOf :isInputRiskFactorStateOf ;
                         rdfs:domain :HealthRiskAssessment ;
                         rdfs:range :HealthRiskFactor ;
                         rdfs:comment "The relationship between a health risk assessment and a risk factor state used as input to the model that computes it." ;
                         rdfs:label "has input risk factor state" .


###  http://purl.org/phmo#hasLowerBMIThan
:hasLowerBMIThan rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain :BMICategory ;
                 rdfs:range :BMICategory ;
                 rdfs:comment "Transitive property to add order to the BMICategory class." ;
                 rdfs:label "has lower BMI than" .


###  http://purl.org/phmo#hasMedicalAction
:hasMedicalAction rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isMedicalActionInIntervention ;
                  rdfs:domain :HealthIntervention ;
                  rdfs:range <http://purl.obolibrary.org/obo/MAXO_0000001> ;
                  rdfs:comment "The relationship between a health intervention and the medical action it involves." ;
                  rdfs:label "has medical action" .


###  http://purl.org/phmo#hasPrediction
:hasPrediction rdf:type owl:ObjectProperty ;
               owl:inverseOf :isPredictionOf ;
               rdfs:domain :MonitoredPerson ;
               rdfs:range :HealthEventPrediction ;
               rdfs:comment "The relationship betweena monitored person and a health event prediction." ;
               rdfs:label "has prediction" .


###  http://purl.org/phmo#hasPredictionStatus
:hasPredictionStatus rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isPredictionStatusOf ;
                     rdfs:domain :HealthEventPrediction ;
                     rdfs:range :HealthEventPredictionStatus ;
                     rdfs:comment "The relationship between a health event prediction and its status (present or absent)." ;
                     rdfs:label "has prediction status" .


###  http://purl.org/phmo#hasRecommendedIntervention
:hasRecommendedIntervention rdf:type owl:ObjectProperty ;
                            owl:inverseOf :isRecommendedFor ;
                            rdfs:domain :MonitoredPerson ;
                            rdfs:range :HealthIntervention ;
                            rdfs:comment "The relationship between a monitored person and a health intervention that has been recommended for them." ;
                            rdfs:label "has recommended intervention" .


###  http://purl.org/phmo#hasResponseIntervention
:hasResponseIntervention rdf:type owl:ObjectProperty ;
                         owl:inverseOf :isInResponseTo ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :HealthEventPrediction
                                                     :HealthRiskAssessment
                                                   )
                                     ] ;
                         rdfs:range :HealthIntervention ;
                         rdfs:comment "The relationship between a health risk assessment or health event prediction and the health intervention that responds to it." ;
                         rdfs:label "has response intervention" .


###  http://purl.org/phmo#hasRiskAssessment
:hasRiskAssessment rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isRiskAssessmentOf ;
                   rdfs:domain :MonitoredPerson ;
                   rdfs:range :HealthRiskAssessment ;
                   rdfs:comment "The relationship betweena monitored person and a health risk assessment." ;
                   rdfs:label "has risk assessment" .


###  http://purl.org/phmo#hasRiskFactor
:hasRiskFactor rdf:type owl:ObjectProperty ;
               owl:inverseOf :isRiskFactorInRelationship ;
               rdfs:domain :FactorRiskRelationship ;
               rdfs:range :HealthRiskFactor ;
               rdfs:comment "The link between a factor risk relationship and a risk factor." ;
               rdfs:label "has risk factor" .


###  http://purl.org/phmo#hasRiskFactorCategory
:hasRiskFactorCategory rdf:type owl:ObjectProperty ;
                       owl:inverseOf :isRiskFactorCategoryInRelationship ;
                       rdfs:domain :CategoryRiskRelationship ;
                       rdfs:range :HealthRiskFactor ;
                       rdfs:comment "The link between a category risk relationship and risk factor category." ;
                       rdfs:label "has risk factor category" .


###  http://purl.org/phmo#hasRiskFactorState
:hasRiskFactorState rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isRiskFactorStateInRelationship ;
                    rdfs:domain :StateRiskRelationship ;
                    rdfs:range :HealthRiskFactor ;
                    rdfs:comment "The link between a state risk relationship and the risk factor state." ;
                    rdfs:label "has risk factor state" .


###  http://purl.org/phmo#hasRiskFactorStatus
:hasRiskFactorStatus rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isRiskFactorStatusOf ;
                     rdfs:domain :MonitoredPerson ;
                     rdfs:range :HealthRiskFactor ;
                     rdfs:comment "The relationship between a monitored person and their status for a specific risk factor." ;
                     rdfs:label "has risk factor status" .


###  http://purl.org/phmo#hasRiskOfCondition
:hasRiskOfCondition rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isConditionInRiskRelationship ;
                    rdfs:domain :HealthRiskRelationship ;
                    rdfs:range :MedicalCondition ;
                    rdfs:comment "The relationship between a health risk relationship and a medical condition." ;
                    rdfs:label "has risk of condition" .


###  http://purl.org/phmo#hasRiskStatus
:hasRiskStatus rdf:type owl:ObjectProperty ;
               owl:inverseOf :isRiskStatusOf ;
               rdfs:domain :HealthRiskAssessment ;
               rdfs:range :HealthRiskStatus ;
               rdfs:comment "The relationship between a health risk assessment and a risk status (present or absent)." ;
               rdfs:label "has risk status" .


###  http://purl.org/phmo#hasSex
:hasSex rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasRiskFactorStatus ;
        owl:inverseOf :isSexOf ;
        rdfs:domain :MonitoredPerson ;
        rdfs:range :Sex ;
        rdfs:comment "The relationship between a monitored person and their sex." ;
        rdfs:label "has sex" .


###  http://purl.org/phmo#isApprovalStatusOfIntervention
:isApprovalStatusOfIntervention rdf:type owl:ObjectProperty ;
                                rdfs:domain :ApprovalStatus ;
                                rdfs:range :HealthIntervention ;
                                rdfs:comment "The relationship between an approval status (approved, pre-approved, rejected, or pending) and a health intervention." ;
                                rdfs:label "is approval status of intervention" .


###  http://purl.org/phmo#isBMICategoryOf
:isBMICategoryOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isRiskFactorStatusOf ;
                 rdfs:domain :BMICategory ;
                 rdfs:range :MonitoredPerson ;
                 rdfs:comment "The relationship between a BMI category and a person who belongs to it." ;
                 rdfs:label "is BMI category of" .


###  http://purl.org/phmo#isBasisOf
:isBasisOf rdf:type owl:ObjectProperty ;
           rdfs:domain <https://purl.org/heals/eo#SystemRecommendation> ;
           rdfs:range <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
           rdfs:comment "The relationship between a system recommendation, knowledge or other entity and an explanation that is based on it." ;
           rdfs:label "is basis of" .


###  http://purl.org/phmo#isCareRecipientOf
:isCareRecipientOf rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isCaregiverOf ;
                   rdfs:domain :MonitoredPerson ;
                   rdfs:range :Caregiver ;
                   rdfs:comment "The relationship between a monitored person and their caregiver." ;
                   rdfs:label "is care recipient of" .


###  http://purl.org/phmo#isCaregiverOf
:isCaregiverOf rdf:type owl:ObjectProperty ;
               rdfs:domain :Caregiver ;
               rdfs:range :MonitoredPerson ;
               rdfs:comment "The relationship between a caregiver and their care recipient, a monitored person." ;
               rdfs:label "is caregiver of" .


###  http://purl.org/phmo#isClinicianOf
:isClinicianOf rdf:type owl:ObjectProperty ;
               owl:inverseOf :isPatientOf ;
               rdfs:domain :Clinician ;
               rdfs:range :MonitoredPerson ;
               rdfs:comment "The relationship between a clinician and their patient, a monitored person." ;
               rdfs:label "is clinician of" .


###  http://purl.org/phmo#isComorbidityStatusOf
:isComorbidityStatusOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :isRiskFactorStatusOf ;
                       rdfs:domain :ComorbidityFactor ;
                       rdfs:range :MonitoredPerson ;
                       rdfs:comment "The relationship between  a comorbidity risk factor status and a monitored person." ;
                       rdfs:label "is comorbidity status of" .


###  http://purl.org/phmo#isComorbidityStatusOfCondition
:isComorbidityStatusOfCondition rdf:type owl:ObjectProperty ;
                                owl:inverseOf :isConditionInComorbidityStatus ;
                                rdfs:domain :ComorbidityFactor ;
                                rdfs:range :MedicalCondition ;
                                rdfs:comment "The relationship between a comorbidity factor status (i.e. present or absent) and a medical condition." ;
                                rdfs:label "is comorbidity status of condition" .


###  http://purl.org/phmo#isComponentOf
:isComponentOf rdf:type owl:ObjectProperty ;
               owl:inverseOf <https://saref.etsi.org/core/consistsOf> ;
               rdfs:domain <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( <https://saref.etsi.org/saref4ehaw/HealthDevice>
                                          <https://saref.etsi.org/saref4ehaw/HealthWearable>
                                        )
                          ] ;
               rdfs:comment "The relationship between a component sensor and a wearable device." ;
               rdfs:label "is component of" .


###  http://purl.org/phmo#isConditionInComorbidityStatus
:isConditionInComorbidityStatus rdf:type owl:ObjectProperty ;
                                rdfs:domain :MedicalCondition ;
                                rdfs:range :ComorbidityFactor ;
                                rdfs:comment "The relationship between a medical condition and its status as a comorbidity (i.e. present or absent)." ;
                                rdfs:label "is condition in comorbidity status" .


###  http://purl.org/phmo#isConditionInHealthEvent
:isConditionInHealthEvent rdf:type owl:ObjectProperty ;
                          owl:inverseOf :isHealthEventOfCondition ;
                          rdfs:domain :MedicalCondition ;
                          rdfs:range :HealthEvent ;
                          rdfs:comment "The relationship between a medical condition and a health event" ;
                          rdfs:label "is condition in health event" .


###  http://purl.org/phmo#isConditionInPrediction
:isConditionInPrediction rdf:type owl:ObjectProperty ;
                         owl:inverseOf :isPredictionOfCondition ;
                         rdfs:domain :MedicalCondition ;
                         rdfs:range :HealthEventPrediction ;
                         rdfs:comment "The relationship between medical condition and a health event prediction." ;
                         rdfs:label "is condition in prediction" .


###  http://purl.org/phmo#isConditionInPredictionStatus
:isConditionInPredictionStatus rdf:type owl:ObjectProperty ;
                               owl:inverseOf :isPredictionStatusOfCondition ;
                               rdfs:domain :MedicalCondition ;
                               rdfs:range :HealthEventPredictionStatus ;
                               rdfs:comment "The relationship between a medical condition and a health event prediction status (i.e. present or absent)." ;
                               rdfs:label "is condition in prediction status" .


###  http://purl.org/phmo#isConditionInRiskAssessment
:isConditionInRiskAssessment rdf:type owl:ObjectProperty ;
                             owl:inverseOf :isRiskAssessmentOfCondition ;
                             rdfs:domain :MedicalCondition ;
                             rdfs:range :HealthRiskAssessment ;
                             rdfs:comment "The relationship between medical condition and a health risk assessment." ;
                             rdfs:label "is condition in risk assessment" .


###  http://purl.org/phmo#isConditionInRiskRelationship
:isConditionInRiskRelationship rdf:type owl:ObjectProperty ;
                               rdfs:domain :MedicalCondition ;
                               rdfs:range :HealthRiskRelationship ;
                               rdfs:comment "The relationship between a medical condition and a health risk relationship." ;
                               rdfs:label "is condition in risk relationship" .


###  http://purl.org/phmo#isConditionInRiskStatus
:isConditionInRiskStatus rdf:type owl:ObjectProperty ;
                         owl:inverseOf :isRiskStatusOfCondition ;
                         rdfs:domain :MedicalCondition ;
                         rdfs:range :HealthRiskStatus ;
                         rdfs:comment "The relationship between a medical condition and its status as a risk in a monitored person  (i.e. present or absent)." ;
                         rdfs:label "is condition in risk status" .


###  http://purl.org/phmo#isConsumedBy
:isConsumedBy rdf:type owl:ObjectProperty ;
              owl:inverseOf <https://purl.org/heals/eo#consumes> ;
              rdfs:domain <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
              rdfs:range <https://purl.org/heals/eo#user> ;
              rdfs:comment "The relationship between an explanation and a user it is provided to." ;
              rdfs:label "is consumed by" .


###  http://purl.org/phmo#isCreatorOf
:isCreatorOf rdf:type owl:ObjectProperty ;
             owl:inverseOf <http://purl.org/dc/terms/creator> ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Author
                                         <http://xmlns.com/foaf/0.1/Organization>
                                       )
                         ] ;
             rdfs:range :Publication ;
             rdfs:comment "The relationship between an agent (author or organisation) and a publication they created or contributed to." ;
             rdfs:label "is creator of" .


###  http://purl.org/phmo#isDeterminantOf
:isDeterminantOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf :isDeterminedBy ;
                 rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                 rdfs:range :HealthRiskFactor ;
                 rdfs:comment "The relationship between an observation and a risk factor.  E.g. a BMI observation is a determinant of the BMI category." ;
                 rdfs:label "is determinant of" .


###  http://purl.org/phmo#isDeterminedBy
:isDeterminedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :HealthRiskFactor ;
                rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                rdfs:comment "The relationship between a risk factor and an observation that is determined by it. E.g. BMI category is determined by a BMI observation." ;
                rdfs:label "is determined by" .


###  http://purl.org/phmo#isEffectModifierInRelationship
:isEffectModifierInRelationship rdf:type owl:ObjectProperty ;
                                rdfs:domain :HealthRiskFactor ;
                                rdfs:range :StateRiskRelationship ;
                                rdfs:comment "Links a risk factor state to a health risk relationship whose associated risk it modifies." ;
                                rdfs:label "is effect modifier in relationship" .


###  http://purl.org/phmo#isEvidenceFor
:isEvidenceFor rdf:type owl:ObjectProperty ;
               owl:inverseOf :isEvidencedBy ;
               rdfs:domain <http://purl.obolibrary.org/obo/ECO_0000000> ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :HealthIntervention
                                          :HealthRiskRelationship
                                        )
                          ] ;
               rdfs:comment "The relationship between supporting evidence and a health risk relationship or health intervention." ;
               rdfs:label "is evidence for" .


###  http://purl.org/phmo#isEvidencedBy
:isEvidencedBy rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :HealthIntervention
                                           :HealthRiskRelationship
                                         )
                           ] ;
               rdfs:range <http://purl.obolibrary.org/obo/ECO_0000000> ;
               rdfs:comment "The relationship between a health risk relationship or health intervention and the  evidence that supports it." ;
               rdfs:label "is evidenced by" .


###  http://purl.org/phmo#isHealthEventInPrediction
:isHealthEventInPrediction rdf:type owl:ObjectProperty ;
                           owl:inverseOf :isPredictionOfHealthEvent ;
                           rdfs:domain :HealthEvent ;
                           rdfs:range :HealthEventPrediction ;
                           rdfs:comment "The relationship between a health event and a health event prediction" ;
                           rdfs:label "is health event in prediction" .


###  http://purl.org/phmo#isHealthEventOfCondition
:isHealthEventOfCondition rdf:type owl:ObjectProperty ;
                          rdfs:domain :HealthEvent ;
                          rdfs:range :MedicalCondition ;
                          rdfs:comment "The relationship between a health event and a medical condition." ;
                          rdfs:label "is health event of condition" .


###  http://purl.org/phmo#isInResponseTo
:isInResponseTo rdf:type owl:ObjectProperty ;
                rdfs:domain :HealthIntervention ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :HealthEventPrediction
                                           :HealthRiskAssessment
                                         )
                           ] ;
                rdfs:comment "The relationship between a health intervention and the health risk assessment or health event prediction that it responds to." ;
                rdfs:label "is in response to" .


###  http://purl.org/phmo#isInputOfPrediction
:isInputOfPrediction rdf:type owl:ObjectProperty ;
                     rdfs:domain :ContinuousObservation ;
                     rdfs:range :HealthEventPrediction ;
                     rdfs:comment "The relationship between a continuous observation and a health event prediction for which it was the input." ;
                     rdfs:label "is input of prediction" .


###  http://purl.org/phmo#isInputRiskFactorOf
:isInputRiskFactorOf rdf:type owl:ObjectProperty ;
                     rdfs:domain :HealthRiskFactor ;
                     rdfs:range :Model ;
                     rdfs:comment "The relationship between a risk factor and a model that takes it as input." ;
                     rdfs:label "is input risk factor of" .


###  http://purl.org/phmo#isInputRiskFactorStateOf
:isInputRiskFactorStateOf rdf:type owl:ObjectProperty ;
                          rdfs:domain :HealthRiskFactor ;
                          rdfs:range :HealthRiskAssessment ;
                          rdfs:comment "The relationship between a risk factor state and a health risk assessment for which it was an input." ;
                          rdfs:label "is input risk factor state of" .


###  http://purl.org/phmo#isMedicalActionInIntervention
:isMedicalActionInIntervention rdf:type owl:ObjectProperty ;
                               rdfs:domain <http://purl.obolibrary.org/obo/MAXO_0000001> ;
                               rdfs:range :HealthIntervention ;
                               rdfs:comment "The relationship between a medical action and a health intervention that involves it." ;
                               rdfs:label "is medical action in intervention" .


###  http://purl.org/phmo#isPatientOf
:isPatientOf rdf:type owl:ObjectProperty ;
             rdfs:domain :MonitoredPerson ;
             rdfs:range :Clinician ;
             rdfs:comment "The relationship between a monitored person and their clinician." ;
             rdfs:label "is patient of" .


###  http://purl.org/phmo#isPredictionOf
:isPredictionOf rdf:type owl:ObjectProperty ;
                rdfs:domain :HealthEventPrediction ;
                rdfs:range :MonitoredPerson ;
                rdfs:comment "The relationship between a prediction of a health event and the monitored person for whom the event is predicted to occur." ;
                rdfs:label "is prediction of" .


###  http://purl.org/phmo#isPredictionOfCondition
:isPredictionOfCondition rdf:type owl:ObjectProperty ;
                         rdfs:domain :HealthEventPrediction ;
                         rdfs:range :MedicalCondition ;
                         rdfs:comment "The relationship between a health event prediction and the medical condition it is associated with." ;
                         rdfs:label "is prediction of condition" .


###  http://purl.org/phmo#isPredictionOfHealthEvent
:isPredictionOfHealthEvent rdf:type owl:ObjectProperty ;
                           rdfs:domain :HealthEventPrediction ;
                           rdfs:range :HealthEvent ;
                           rdfs:comment "The relationship between a health event prediction and the health event it predicts, e.g. an AF episode." ;
                           rdfs:label "is prediction of health event" .


###  http://purl.org/phmo#isPredictionStatusOf
:isPredictionStatusOf rdf:type owl:ObjectProperty ;
                      rdfs:domain :HealthEventPredictionStatus ;
                      rdfs:range :HealthEventPrediction ;
                      rdfs:comment "The relationship between a health event prediction status (present or absent) and a health event prediction." ;
                      rdfs:label "is prediction status of" .


###  http://purl.org/phmo#isPredictionStatusOfCondition
:isPredictionStatusOfCondition rdf:type owl:ObjectProperty ;
                               rdfs:domain :HealthEventPredictionStatus ;
                               rdfs:range :MedicalCondition ;
                               rdfs:comment "The relationship between a health event prediction status (i.e. present or absent) and a medical condition." ;
                               rdfs:label "is prediction status of condition" .


###  http://purl.org/phmo#isPublicationOf
:isPublicationOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isPublishedAs ;
                 rdfs:domain :Publication ;
                 rdfs:range <http://purl.obolibrary.org/obo/ECO_0000000> ;
                 rdfs:comment "The relationship between a publication and the work (evidence) that is expressed within it." ;
                 rdfs:label "is publication of" .


###  http://purl.org/phmo#isPublishedAs
:isPublishedAs rdf:type owl:ObjectProperty ;
               rdfs:domain <http://purl.obolibrary.org/obo/ECO_0000000> ;
               rdfs:range :Publication ;
               rdfs:comment "The relationship between evidence and the publication that reports it." ;
               rdfs:label "is published as" .


###  http://purl.org/phmo#isRecommendedFor
:isRecommendedFor rdf:type owl:ObjectProperty ;
                  rdfs:domain :HealthIntervention ;
                  rdfs:range :MonitoredPerson ;
                  rdfs:comment "The relationship between a health intervention and the monitored person for whom it is recommended." ;
                  rdfs:label "is recommended for" .


###  http://purl.org/phmo#isRiskAssessmentOf
:isRiskAssessmentOf rdf:type owl:ObjectProperty ;
                    rdfs:domain :HealthRiskAssessment ;
                    rdfs:range :MonitoredPerson ;
                    rdfs:comment "The relationship between a health risk assessment and the monitored person it assesses." ;
                    rdfs:label "is risk assessment of" .


###  http://purl.org/phmo#isRiskAssessmentOfCondition
:isRiskAssessmentOfCondition rdf:type owl:ObjectProperty ;
                             rdfs:domain :HealthRiskAssessment ;
                             rdfs:range :MedicalCondition ;
                             rdfs:comment "The relationship between a health risk assessment and the medical condition it assesses." ;
                             rdfs:label "is risk assessment of condition" .


###  http://purl.org/phmo#isRiskFactorCategoryInRelationship
:isRiskFactorCategoryInRelationship rdf:type owl:ObjectProperty ;
                                    rdfs:domain :HealthRiskFactor ;
                                    rdfs:range :CategoryRiskRelationship ;
                                    rdfs:comment "The link between a risk factor category and a category risk relationship." ;
                                    rdfs:label "is risk factor category in relationship" .


###  http://purl.org/phmo#isRiskFactorInRelationship
:isRiskFactorInRelationship rdf:type owl:ObjectProperty ;
                            rdfs:domain :HealthRiskFactor ;
                            rdfs:range :FactorRiskRelationship ;
                            rdfs:comment "The link between a risk factor and a factor risk relationship." ;
                            rdfs:label "is risk factor in relationship" .


###  http://purl.org/phmo#isRiskFactorStateInRelationship
:isRiskFactorStateInRelationship rdf:type owl:ObjectProperty ;
                                 rdfs:domain :HealthRiskFactor ;
                                 rdfs:range :StateRiskRelationship ;
                                 rdfs:comment "The link between a risk factor state and a state risk relationship." ;
                                 rdfs:label "is risk factor state in relationship" .


###  http://purl.org/phmo#isRiskFactorStatusOf
:isRiskFactorStatusOf rdf:type owl:ObjectProperty ;
                      rdfs:domain :HealthRiskFactor ;
                      rdfs:range :MonitoredPerson ;
                      rdfs:comment "A generalised relationship between a risk factor and a monitored person." ;
                      rdfs:label "is risk factor status of" .


###  http://purl.org/phmo#isRiskStatusOf
:isRiskStatusOf rdf:type owl:ObjectProperty ;
                rdfs:domain :HealthRiskStatus ;
                rdfs:range :HealthRiskAssessment ;
                rdfs:comment "The relationship between a risk status (present or absent) and a health risk assessment." ;
                rdfs:label "is risk status of" .


###  http://purl.org/phmo#isRiskStatusOfCondition
:isRiskStatusOfCondition rdf:type owl:ObjectProperty ;
                         rdfs:domain :HealthRiskStatus ;
                         rdfs:range :MedicalCondition ;
                         rdfs:comment "The relationship between a risk status in a monitored individual (i.e. present or absent) and a medical condition." ;
                         rdfs:label "is risk status of condition" .


###  http://purl.org/phmo#isSexOf
:isSexOf rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :isRiskFactorStatusOf ;
         rdfs:domain :Sex ;
         rdfs:range :MonitoredPerson ;
         rdfs:comment "The relationship between a sex category and a person who belongs to it." ;
         rdfs:label "is sex of" .


###  http://purl.org/phmo#isUnitOfMeasureOf
:isUnitOfMeasureOf rdf:type owl:ObjectProperty ;
                   owl:inverseOf <https://saref.etsi.org/core/isMeasuredIn> ;
                   rdfs:domain <https://saref.etsi.org/core/UnitOfMeasure> ;
                   rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                   rdfs:comment "The relationship between a unit of measure and a measurement." ;
                   rdfs:label "is unit of measure of" .


###  http://purl.org/phmo#madeEventPrediction
:madeEventPrediction rdf:type owl:ObjectProperty ;
                     owl:inverseOf :wasPredictedByModel ;
                     rdfs:domain :Model ;
                     rdfs:range :HealthEventPrediction ;
                     rdfs:comment "The relationship between a model and a health event prediction that it made." ;
                     rdfs:label "made event prediction" .


###  http://purl.org/phmo#madeRiskAssessment
:madeRiskAssessment rdf:type owl:ObjectProperty ;
                    owl:inverseOf :wasAssessedByModel ;
                    rdfs:domain :Model ;
                    rdfs:range :HealthRiskAssessment ;
                    rdfs:comment "The relationship between a model and a health risk assessment that it made." ;
                    rdfs:label "made risk assessment" .


###  http://purl.org/phmo#wasAssessedByModel
:wasAssessedByModel rdf:type owl:ObjectProperty ;
                    rdfs:domain :HealthRiskAssessment ;
                    rdfs:range :Model ;
                    rdfs:comment "The relationship between a health risk assessment and the model that made it." ;
                    rdfs:label "was assessed by model" .


###  http://purl.org/phmo#wasPredictedByModel
:wasPredictedByModel rdf:type owl:ObjectProperty ;
                     rdfs:domain :HealthEventPrediction ;
                     rdfs:range :Model ;
                     rdfs:comment "The relationship between a health event prediction and the model that made it." ;
                     rdfs:label "was predicted by model" .


###  http://purl.org/phmo#wasTestDataFor
:wasTestDataFor rdf:type owl:ObjectProperty ;
                owl:inverseOf :wasTestedOn ;
                rdfs:domain <http://www.w3.org/ns/dcat#Dataset> ;
                rdfs:range :Model ;
                rdfs:comment "The relationship between a dataset and a model whose performance was evaluated on it." ;
                rdfs:label "was test data for" .


###  http://purl.org/phmo#wasTestedOn
:wasTestedOn rdf:type owl:ObjectProperty ;
             rdfs:domain :Model ;
             rdfs:range <http://www.w3.org/ns/dcat#Dataset> ;
             rdfs:comment "The relationship between a model and a dataset on which its performance was evaluated." ;
             rdfs:label "was tested on" .


###  http://purl.org/phmo#wasTrainedOn
:wasTrainedOn rdf:type owl:ObjectProperty ;
              owl:inverseOf :wasTrainingDataFor ;
              rdfs:domain :Model ;
              rdfs:range <http://www.w3.org/ns/dcat#Dataset> ;
              rdfs:comment "The relationship between a model and a dataset from which it was constructed or trained." ;
              rdfs:label "was trained on" .


###  http://purl.org/phmo#wasTrainingDataFor
:wasTrainingDataFor rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.w3.org/ns/dcat#Dataset> ;
                    rdfs:range :Model ;
                    rdfs:comment "The relationship between a dataset and a model that was constructed or trained from it." ;
                    rdfs:label "was training data for" .


###  http://purl.org/phmo#wearsDevice
:wearsDevice rdf:type owl:ObjectProperty ;
             owl:inverseOf <https://saref.etsi.org/saref4wear/isLocatedOn> ;
             rdfs:domain :MonitoredPerson ;
             rdfs:range <https://saref.etsi.org/saref4wear/WearableDevice> ;
             rdfs:comment "The relationship between a person and the wearable device that is located on them." ;
             rdfs:label "wears device" .


###  http://purl.org/vocab/frbr/core#part
<http://purl.org/vocab/frbr/core#part> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf <http://purl.org/vocab/frbr/core#partOf> ;
                                       rdf:type owl:TransitiveProperty ;
                                       rdfs:domain :Publication ;
                                       rdfs:range :Publication ;
                                       <http://purl.org/vocab/vann/example> """
        :my-journal-issue a fabio:JournalIssue ;
            frbr:part :my-journal-article .
        """ ;
                                       rdfs:comment "A part of an endeavour."@en ,
                                                    "A property indicating that one entity includes another entity."@en ;
                                       rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                       rdfs:label "has part"@en ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                       <http://www.w3.org/2008/05/skos#note> "Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive."@en .


###  http://purl.org/vocab/frbr/core#partOf
<http://purl.org/vocab/frbr/core#partOf> rdf:type owl:ObjectProperty ,
                                                  owl:TransitiveProperty ;
                                         rdfs:domain :Publication ;
                                         rdfs:range :Publication ;
                                         <http://purl.org/vocab/vann/example> """
        :my-journal-article a fabio:JournalArticle ;
            frbr:partOf :my-journal-issue .
    """ ;
                                         rdfs:comment "A property indicating that one entity is a part of another entity."@en ,
                                                      "An endeavour incorporating another endeavour."@en ;
                                         rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                         rdfs:label "is part of"@en ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                         <http://www.w3.org/2008/05/skos#note> "Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive."@en .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <http://www.w3.org/ns/sosa/Observation>
                                                                             <http://www.w3.org/ns/sosa/ObservationCollection>
                                                                           )
                                                             ] ;
                                                 rdfs:range <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                 <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                                    <http://www.w3.org/ns/sosa/Execution> ,
                                                                                    <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                                 <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                 rdfs:comment "relation from an Execution or Deployment to its subject entity i.e., from an Actuation to the entity whose property was modified; from an Observation to the entity whose quality was observed; from an act of Sampling to the entity that was sampled; or from a Deployment to its target" ;
                                                 rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                                 rdfs:label "has feature of interest"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an Execution or Deployment to its subject entity

  i.e., from an Actuation to the entity whose property was modified;
  from an Observation to the entity whose quality was observed;
  from an act of Sampling to the entity that was sampled;
  or from a Deployment to its target
  """@en ;
                                                 <http://www.w3.org/2004/02/skos/core#example> "For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight."@en ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the _proximate_ feature of interest, which may be a proxy entity such as a sample of the _ultimate_ feature of interest. Use `hasUltimateFeatureOfInterest` if the intention is to link to the _ultimate_ feature of interest. " .


###  http://www.w3.org/ns/sosa/hasMember
<http://www.w3.org/ns/sosa/hasMember> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <http://www.w3.org/ns/sosa/isMemberOf> ;
                                      rdfs:domain <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                      <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Execution> ,
                                                                        <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                        <http://www.w3.org/ns/sosa/Observation> ,
                                                                        <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      rdfs:comment "link from a Collection to an Execution or Sample or Collection of these that is part of it" ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                      rdfs:label "has member of collection" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
  link from a Collection to an Execution or Sample or Collection of these that is part of it
  """ ;
                                      <http://www.w3.org/2004/02/skos/core#editorialNote> "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types" ;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "rules for the consistency of values of properties of collections and properties of their members are given for each collection type" .


###  http://www.w3.org/ns/sosa/hasProperty
<http://www.w3.org/ns/sosa/hasProperty> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <http://www.w3.org/ns/sosa/isPropertyOf> ;
                                        rdfs:domain <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                        rdfs:range <http://www.w3.org/ns/sosa/Property> ;
                                        <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                        rdfs:comment "relation from an entity to a Property of that entity" ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                        rdfs:label "has property"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an entity to a Property of that entity
  """@en .


###  http://www.w3.org/ns/sosa/isFeatureOfInterestOf
<http://www.w3.org/ns/sosa/isFeatureOfInterestOf> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                  rdfs:range [ rdf:type owl:Class ;
                                                               owl:unionOf ( <http://www.w3.org/ns/sosa/Observation>
                                                                             <http://www.w3.org/ns/sosa/ObservationCollection>
                                                                           )
                                                             ] ;
                                                  <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                  <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                                    <http://www.w3.org/ns/sosa/Execution> ,
                                                                                    <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                                  rdfs:comment "relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it, or to a Deployment for which it is the subject." ;
                                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                                  rdfs:label "is feature of interest of"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it

  i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it,
  or to a Deployment for which it is the subject.
"""@en .


###  http://www.w3.org/ns/sosa/isMemberOf
<http://www.w3.org/ns/sosa/isMemberOf> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                       rdfs:range <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                       <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Execution> ,
                                                                          <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                          <http://www.w3.org/ns/sosa/Observation> ,
                                                                          <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                       <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                       rdfs:comment "link from an Execution or Sample or Collection of these, to a collection that it is part of" ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                       rdfs:label "is member of collection" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
  link from an Execution or Sample or Collection of these, to a collection that it is part of
  """ ;
                                       <http://www.w3.org/2004/02/skos/core#editorialNote> "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types" ;
                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "rules for the consistency of values of properties of collections and properties of their members are given for each collection type" .


###  http://www.w3.org/ns/sosa/isObservedBy
<http://www.w3.org/ns/sosa/isObservedBy> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://www.w3.org/ns/sosa/observes> ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> ;
                                         <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:comment "Relation between an ObservableProperty and the Sensor able to observe it."@en ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                          <http://www.w3.org/ns/sosa/obs/> ;
                                         rdfs:label "is observed by"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Property to a Sensor that is able to observe it
  """@en ,
                                                                                          "Relation between an ObservableProperty and the Sensor able to observe it."@en .


###  http://www.w3.org/ns/sosa/isPropertyOf
<http://www.w3.org/ns/sosa/isPropertyOf> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                         <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:comment "relation from a Property to a FeatureOfInterest that it is a quality of" ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                         rdfs:label "is property of"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Property to a FeatureOfInterest that it is a quality of
  """@en .


###  http://www.w3.org/ns/sosa/madeBySensor
<http://www.w3.org/ns/sosa/madeBySensor> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://www.w3.org/ns/sosa/madeObservation> ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> ;
                                         <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                            <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                         <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Sensor> ;
                                         rdfs:comment "Relation between an Observation and the Sensor which made the Observation."@en ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                          <http://www.w3.org/ns/sosa/obs/> ;
                                         rdfs:label "made by sensor"@en ,
                                                    "made by sensor or observer"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an Observation or ObservationCollection to the Sensor involved
  """@en ,
                                                                                          "Relation between an Observation and the Sensor which made the Observation."@en .


###  http://www.w3.org/ns/sosa/madeObservation
<http://www.w3.org/ns/sosa/madeObservation> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                            rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                            <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Sensor> ;
                                            <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                              <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                            rdfs:comment "Relation between a Sensor and an Observation made by the Sensor."@en ;
                                            rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                             <http://www.w3.org/ns/sosa/obs/> ;
                                            rdfs:label "made observation"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Sensor to an Observation or ObservationCollection it has made
  """@en ,
                                                                                             "Relation between a Sensor and an Observation made by the Sensor."@en .


###  http://www.w3.org/ns/sosa/observedProperty
<http://www.w3.org/ns/sosa/observedProperty> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://www.w3.org/ns/sosa/wasObservedBy> ;
                                             rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                             rdfs:range <http://www.w3.org/ns/sosa/Property> ;
                                             <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                                <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                             <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                             rdfs:comment "relation from an Observation or ObservationCollection to the property observed" ;
                                             rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                             rdfs:label "observed property"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an Observation or ObservationCollection to the property observed
  """@en ;
                                             <http://www.w3.org/2004/02/skos/core#note> """
  'observed property' covers the concepts referred to in [VIM] as 'measurand' (quantitative values) and 'examinand' (categorical and nominal values — [VIM4]), as well as complex and structured properties whose values may be represented as lists, vectors, arrays, rasters, geometries, etc. More specific terms are used in other contexts for related concepts, such as 'analyte' (chemistry) and 'determinand' (water quality).
  """@en .


###  http://www.w3.org/ns/sosa/observes
<http://www.w3.org/ns/sosa/observes> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                     rdfs:range <http://www.w3.org/ns/sosa/Property> ;
                                     <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                     rdfs:comment "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                      <http://www.w3.org/ns/sosa/obs/> ;
                                     rdfs:label "observes"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Sensor to a Property that it is capable of sensing
  """@en ,
                                                                                      "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en .


###  http://www.w3.org/ns/sosa/wasObservedBy
<http://www.w3.org/ns/sosa/wasObservedBy> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://www.w3.org/ns/sosa/Property> ;
                                          rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                          <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                          <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                            <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                          rdfs:comment "relation from a Property to an Observation that observed it" ;
                                          rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                          rdfs:label "was observed by"@en ;
                                          <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Property to an Observation that observed it
  """@en .


###  https://purl.org/heals/eo#consumes
<https://purl.org/heals/eo#consumes> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://purl.org/heals/eo#user> ;
                                     rdfs:range <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                     <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                     rdfs:comment "The relationship between a user and an explanation they consume. The domain, range and inverse are added in AFMO." ;
                                     rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                     rdfs:label "is consumer of" .


###  https://saref.etsi.org/core/consistsOf
<https://saref.etsi.org/core/consistsOf> rdf:type owl:ObjectProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( <https://saref.etsi.org/saref4ehaw/HealthDevice>
                                                                     <https://saref.etsi.org/saref4ehaw/HealthWearable>
                                                                   )
                                                     ] ;
                                         rdfs:range <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
                                         rdfs:comment "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)"@en ;
                                         rdfs:label "consists of"@en ;
                                         <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Add local restrictions on consistsOf on feature of interest"@en .


###  https://saref.etsi.org/core/isMeasuredIn
<https://saref.etsi.org/core/isMeasuredIn> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                           rdfs:range <https://saref.etsi.org/core/UnitOfMeasure> ;
                                           rdfs:comment "A relationship identifying the unit of measure used for a certain entity."@en ;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                           rdfs:label "is measured in"@en .


###  https://saref.etsi.org/saref4wear/isLocatedOn
<https://saref.etsi.org/saref4wear/isLocatedOn> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                rdfs:range :MonitoredPerson ;
                                                rdfs:comment "The relationship between a wearable device and the person it is located on." ;
                                                rdfs:label "is located on" .


#################################################################
#    Data properties
#################################################################

###  http://prismstandard.org/namespaces/basic/2.0/doi
<http://prismstandard.org/namespaces/basic/2.0/doi> rdf:type owl:DatatypeProperty ;
                                                    rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                    rdf:type owl:FunctionalProperty ;
                                                    rdfs:domain :Publication ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "A Digital Object Identifier for a serial publication item, a dataset or some other entity."@en ;
                                                    rdfs:isDefinedBy <http://www.doi.org/> ;
                                                    rdfs:label "has DOI"@en .


###  http://prismstandard.org/namespaces/basic/2.0/edition
<http://prismstandard.org/namespaces/basic/2.0/edition> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain :Publication ;
                                                        rdfs:range xsd:positiveInteger ;
                                                        rdfs:comment "An identifier for one of several alternative issues of a magazine, a book or other resource."@en ;
                                                        rdfs:label "has edition"@en .


###  http://prismstandard.org/namespaces/basic/2.0/endingPage
<http://prismstandard.org/namespaces/basic/2.0/endingPage> rdf:type owl:DatatypeProperty ;
                                                           rdfs:subPropertyOf owl:topDataProperty ;
                                                           rdf:type owl:FunctionalProperty ;
                                                           rdfs:domain :Publication ;
                                                           rdfs:range xsd:int ;
                                                           <http://purl.org/vocab/vann/example> """
        :my-print-object a fabio:PrintObject ;
            prism:endingPage '186' .
    """ ;
                                                           rdfs:comment "A property used to identify the last page of an entity such as a journal article."@en ;
                                                           rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                           rdfs:label "has ending page"@en ;
                                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://prismstandard.org/namespaces/basic/2.0/isbn
<http://prismstandard.org/namespaces/basic/2.0/isbn> rdf:type owl:DatatypeProperty ;
                                                     rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                     rdf:type owl:FunctionalProperty ;
                                                     rdfs:domain :Publication ;
                                                     rdfs:range xsd:string ;
                                                     rdfs:comment "The International Standard Book Number, ISBN, used to identify published books or, more rarely, journal issues."@en ;
                                                     rdfs:label "has ISBN"@en .


###  http://prismstandard.org/namespaces/basic/2.0/issueIdentifier
<http://prismstandard.org/namespaces/basic/2.0/issueIdentifier> rdf:type owl:DatatypeProperty ;
                                                                rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                                rdfs:domain <http://purl.org/spar/fabio/JournalIssue> ;
                                                                rdfs:range xsd:int ;
                                                                rdfs:comment "A system generated unique publisher identifier for the issue of a serial publication.   The issue identifies should not be confused with the \"special\" issue name element, prism:issueName." ;
                                                                rdfs:isDefinedBy "http://prismstandard.org/namespaces/basic/2.0/issueIdentifier" ;
                                                                rdfs:label "has issue identifier" .


###  http://prismstandard.org/namespaces/basic/2.0/pageRange
<http://prismstandard.org/namespaces/basic/2.0/pageRange> rdf:type owl:DatatypeProperty ;
                                                          rdfs:subPropertyOf owl:topDataProperty ;
                                                          rdf:type owl:FunctionalProperty ;
                                                          rdfs:domain :Publication ;
                                                          rdfs:range xsd:string ;
                                                          <http://purl.org/vocab/vann/example> """
        :my-journal-article a fabio:JournalArticle ;
            prism:pageRange '145-162' .
    """ ;
                                                          rdfs:comment "A property used to identify the page range of an entity such as a journal article."@en ,
                                                                       "Identifies the page range of an entity such as a journal article."@en ;
                                                          rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                          rdfs:label "has page range"@en ;
                                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://prismstandard.org/namespaces/basic/2.0/startingPage
<http://prismstandard.org/namespaces/basic/2.0/startingPage> rdf:type owl:DatatypeProperty ;
                                                             rdfs:subPropertyOf owl:topDataProperty ;
                                                             rdf:type owl:FunctionalProperty ;
                                                             rdfs:domain :Publication ;
                                                             rdfs:range xsd:int ;
                                                             <http://purl.org/vocab/vann/example> """
        :my-print-object a fabio:PrintObject ;
            prism:startingPage '171' .
    """ ;
                                                             rdfs:comment "A property used to identify the first page of an entity such as a journal article."@en ;
                                                             rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                             rdfs:label "has starting page"@en ;
                                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://prismstandard.org/namespaces/basic/2.0/volume
<http://prismstandard.org/namespaces/basic/2.0/volume> rdf:type owl:DatatypeProperty ;
                                                       rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                       rdf:type owl:FunctionalProperty ;
                                                       rdfs:domain <http://purl.org/spar/fabio/JournalVolume> ;
                                                       rdfs:range xsd:int ;
                                                       <http://purl.org/vocab/vann/example> """
        :my-journal-volume a fabio:JournalVolume ;
            prism:volume '15' .
    """ ;
                                                       rdfs:comment "An identifier for a particular volume of a resource."@en ;
                                                       rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                       rdfs:label "has volume identifier"@en ;
                                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples include a journal or a multi-volume book."@en .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( :Publication
                                                                  <http://www.w3.org/ns/sosa/Observation>
                                                                  <http://xmlns.com/foaf/0.1/Person>
                                                                )
                                                  ] ;
                                      rdfs:range [ rdf:type rdfs:Datatype ;
                                                   owl:unionOf ( xsd:anyURI
                                                                 xsd:int
                                                                 xsd:string
                                                               )
                                                 ] ;
                                      rdfs:comment """A unique and unambiguous reference to the resource within a given context.

Recommended best practice is to identify the resource by means of a string conforming to a formal identification system."""@en ;
                                      rdfs:label "has identifier"@en .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :Publication ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "A name given to a resource.  Typically, the title will be the name by which the resource is formally known."@en ;
                                 rdfs:label "title"@en .


###  http://purl.org/phmo#hasAUPRC
:hasAUPRC rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :hasPerformanceMetric ;
          rdfs:domain :Model ;
          rdfs:range xsd:float ;
          rdfs:comment "The area under the precision-recall curve of a model." ;
          rdfs:label "has AUPRC" .


###  http://purl.org/phmo#hasAUROC
:hasAUROC rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :hasPerformanceMetric ;
          rdfs:domain :Model ;
          rdfs:range xsd:float ;
          rdfs:comment "The area under the receiver operating characteristic curve of a model." ;
          rdfs:label "has AUROC" .


###  http://purl.org/phmo#hasAge
:hasAge rdf:type owl:DatatypeProperty ;
        rdfs:domain :MonitoredPerson ;
        rdfs:range xsd:integer ;
        rdfs:comment "A person's age in years." ;
        rdfs:label "has age" .


###  http://purl.org/phmo#hasApprovalStatusTimestamp
:hasApprovalStatusTimestamp rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf <https://saref.etsi.org/core/hasTimestamp> ;
                            rdfs:domain :HealthIntervention ;
                            rdfs:range xsd:dateTimeStamp ;
                            rdfs:comment "The timestamp at which a health intervention's approval status was determined by a clinician. In the case of the default approval status (i.e. \"pending\"), the value is the same as the recommendation timestamp." ;
                            rdfs:label "has approval status timestamp" .


###  http://purl.org/phmo#hasBMI
:hasBMI rdf:type owl:DatatypeProperty ;
        rdfs:domain :MonitoredPerson ;
        rdfs:range xsd:decimal ;
        rdfs:comment "A monitored person's body mass index as computed from their most recent height and weight observations." ;
        rdfs:label "has BMI" .


###  http://purl.org/phmo#hasBrierScore
:hasBrierScore rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasPerformanceMetric ;
               rdfs:domain :Model ;
               rdfs:range xsd:float ;
               rdfs:comment "The Brier score of a model, i.e. the mean squared difference between its predicted probabilities and the observed outcomes." ;
               rdfs:label "has Brier Score" .


###  http://purl.org/phmo#hasCategoryWeight
:hasCategoryWeight rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CategoryRiskRelationship ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "Category weight represents how much influence a risk factor category has on the risk of the condition relative to the other categories." ;
                   rdfs:label "has category weight" .


###  http://purl.org/phmo#hasDataStoreURI
:hasDataStoreURI rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                 rdfs:domain :ContinuousObservation ;
                 rdfs:range xsd:anyURI ;
                 rdfs:comment "Link to external data store where raw time series data is stored." ;
                 rdfs:label "has data store URI" .


###  http://purl.org/phmo#hasDateOfConfirmation
:hasDateOfConfirmation rdf:type owl:DatatypeProperty ;
                       rdfs:domain :HealthRiskFactor ;
                       rdfs:range xsd:date ;
                       rdfs:comment "The date on which personal data was last confirmed and/or updated." ;
                       rdfs:label "has date of confirmation" .


###  http://purl.org/phmo#hasDecisionThreshold
:hasDecisionThreshold rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Model ;
                      rdfs:range xsd:float ;
                      rdfs:comment "The probability at or above which a model assigns the positive status, e.g. AF risk present or AF episode present." ;
                      rdfs:label "has decision threshold" .


###  http://purl.org/phmo#hasDuration
:hasDuration rdf:type owl:DatatypeProperty ;
             rdfs:domain :ContinuousObservation ;
             rdfs:range xsd:duration ;
             rdfs:comment "The duration of a continuous observation." ;
             rdfs:label "has duration" .


###  http://purl.org/phmo#hasExpectedCalibrationError
:hasExpectedCalibrationError rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf :hasPerformanceMetric ;
                             rdfs:domain :Model ;
                             rdfs:range xsd:float ;
                             rdfs:comment "The expected calibration error of a model, i.e. the weighted average difference between its predicted probabilities and the observed event frequencies across probability bins." ;
                             rdfs:label "has expected calibration error" .


###  http://purl.org/phmo#hasExpectedUtility
:hasExpectedUtility rdf:type owl:DatatypeProperty ;
                    rdfs:domain :HealthIntervention ;
                    rdfs:range xsd:float ;
                    rdfs:comment "The expected utility of a health intervention as computed by a Bayesian decision network." ;
                    rdfs:label "has expected utility" .


###  http://purl.org/phmo#hasF1Score
:hasF1Score rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :hasPerformanceMetric ;
            rdfs:domain :Model ;
            rdfs:range xsd:float ;
            <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "has F-measure" ,
                                                                           "has F-score" ;
            rdfs:comment "The F1 score of a model, i.e. the harmonic mean of its precision and recall at its decision threshold." ;
            rdfs:label "has F1 Score" .


###  http://purl.org/phmo#hasFactorWeight
:hasFactorWeight rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FactorRiskRelationship ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Factor weight represents how much influence a risk factor has on the risk of the condition relative to the other risk factors in the same category." ;
                 rdfs:label "has factor weight" .


###  http://purl.org/phmo#hasICD10Block
:hasICD10Block rdf:type owl:DatatypeProperty ;
               rdfs:domain :MedicalCondition ;
               rdfs:range xsd:string ;
               rdfs:comment "ICD10 block associated with a medical condition." ;
               rdfs:label "has ICD10 block" .


###  http://purl.org/phmo#hasICD10Code
:hasICD10Code rdf:type owl:DatatypeProperty ;
              rdfs:domain :MedicalCondition ;
              rdfs:range xsd:string ;
              rdfs:comment "ICD10 code associated with a medical condition." ;
              rdfs:label "has ICD10 code" .


###  http://purl.org/phmo#hasIDNumber
:hasIDNumber rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
             rdfs:domain :MonitoredPerson ;
             rdfs:range xsd:string ;
             rdfs:comment "Unique identifier for a monitored person, such as a national ID number." ;
             rdfs:label "has ID number" .


###  http://purl.org/phmo#hasInputType
:hasInputType rdf:type owl:DatatypeProperty ;
              rdfs:domain :ArtificialNeuralNetwork ;
              rdfs:range [ rdf:type rdfs:Datatype ;
                           owl:oneOf [ rdf:type rdf:List ;
                                       rdf:first "ECG" ;
                                       rdf:rest [ rdf:type rdf:List ;
                                                  rdf:first "RR interval" ;
                                                  rdf:rest rdf:nil
                                                ]
                                     ]
                         ] ;
              rdfs:comment "The type of input signal a model takes: the raw ECG or the RR interval series derived from it." ;
              rdfs:label "has input type" .


###  http://purl.org/phmo#hasInputWindow
:hasInputWindow rdf:type owl:DatatypeProperty ;
                rdfs:domain :HealthEventPrediction ;
                rdfs:range xsd:duration ;
                rdfs:comment "The duration of the continuous observation used as input to compute a health event prediction." ;
                rdfs:label "has input window" .


###  http://purl.org/phmo#hasPerformanceMetric
:hasPerformanceMetric rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Model ;
                      rdfs:range xsd:float ;
                      rdfs:comment "A measure of the performance of a model, evaluated on a test dataset." ;
                      rdfs:label "has performance metric" .


###  http://purl.org/phmo#hasPredictionHorizon
:hasPredictionHorizon rdf:type owl:DatatypeProperty ;
                      rdfs:domain :HealthEventPrediction ;
                      rdfs:range xsd:duration ;
                      rdfs:comment "How far ahead a health event prediction is made, i.e. the duration between the end of the input window and the start of the target window." ;
                      rdfs:label "has prediction horizon" .


###  http://purl.org/phmo#hasProbability
:hasProbability rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :HealthEventPrediction
                                            :HealthRiskAssessment
                                          )
                            ] ;
                rdfs:range xsd:float ;
                rdfs:comment "The probability associated with a health risk assessment or prediction of a health event." ;
                rdfs:label "has probability" .


###  http://purl.org/phmo#hasPublicationMonthYear
:hasPublicationMonthYear rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Publication ;
                         rdfs:range [ rdf:type rdfs:Datatype ;
                                      owl:unionOf ( xsd:gYear
                                                    xsd:gYearMonth
                                                  )
                                    ] ;
                         rdfs:comment "The month and/or year when a publication was published." ;
                         rdfs:label "has publication month and/or year" .


###  http://purl.org/phmo#hasRecall
:hasRecall rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :hasPerformanceMetric ;
           rdfs:domain :Model ;
           rdfs:range xsd:float ;
           rdfs:comment "The recall (sensitivity) of a model, i.e. the proportion of positive cases it classifies as positive at its decision threshold." ;
           rdfs:label "has recall" .


###  http://purl.org/phmo#hasRecommendationTimestamp
:hasRecommendationTimestamp rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf <https://saref.etsi.org/core/hasTimestamp> ;
                            rdfs:domain :HealthIntervention ;
                            rdfs:range xsd:dateTimeStamp ;
                            rdfs:comment "The timestamp at which a health intervention was recommended by a model." ;
                            rdfs:label "has recommendation timestamp" .


###  http://purl.org/phmo#hasSamplingFrequency
:hasSamplingFrequency rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ContinuousObservation ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "The sampling frequency in Hz of an ECG observation." ;
                      rdfs:label "has sampling frequency" .


###  http://purl.org/phmo#hasSpecificity
:hasSpecificity rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :hasPerformanceMetric ;
                rdfs:domain :Model ;
                rdfs:range xsd:float ;
                rdfs:comment "The specificity of a model, i.e. the proportion of negative cases it classifies as negative at its decision threshold." ;
                rdfs:label "has specificity" .


###  http://purl.org/phmo#hasStateRisk
:hasStateRisk rdf:type owl:DatatypeProperty ;
              rdfs:domain :StateRiskRelationship ;
              rdfs:range xsd:decimal ;
              rdfs:comment "State risk represents the risk of a condition for a particular risk factor state." ;
              rdfs:label "has state risk" .


###  http://purl.org/phmo#hasTargetWindow
:hasTargetWindow rdf:type owl:DatatypeProperty ;
                 rdfs:domain :HealthEventPrediction ;
                 rdfs:range xsd:duration ;
                 rdfs:comment "The period, following the prediction horizon, within which the predicted health event is expected to begin." ;
                 rdfs:label "has target window" .


###  http://purl.org/phmo#hasText
:hasText rdf:type owl:DatatypeProperty ;
         rdfs:domain <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
         rdfs:range xsd:string ;
         rdfs:comment "The text of an explanation as presented to a user." ;
         rdfs:label "has text" .


###  http://purl.org/spar/fabio/hasPageCount
<http://purl.org/spar/fabio/hasPageCount> rdf:type owl:DatatypeProperty ,
                                                   owl:FunctionalProperty ;
                                          rdfs:domain :Publication ;
                                          rdfs:range xsd:positiveInteger ;
                                          rdfs:comment "The count of the number of pages in a textual resource."@en ;
                                          rdfs:label "has page count"@en .


###  http://www.w3.org/ns/sosa/endTime
<http://www.w3.org/ns/sosa/endTime> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain :ContinuousObservation ;
                                    rdfs:range xsd:dateTimeStamp ;
                                    <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                       <http://www.w3.org/ns/sosa/Execution> ,
                                                                       <http://www.w3.org/ns/sosa/ExecutionCollection> ;
                                    rdfs:comment "The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear"@en ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                    rdfs:label "end time"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> """
  instant of time when the Execution or Deployment was ended or completed
  """@en .


###  http://www.w3.org/ns/sosa/startTime
<http://www.w3.org/ns/sosa/startTime> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :ContinuousObservation ;
                                      rdfs:range xsd:dateTimeStamp ;
                                      <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                         <http://www.w3.org/ns/sosa/Execution> ,
                                                                         <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                         <http://www.w3.org/ns/sosa/Observation> ,
                                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      rdfs:comment "The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear"@en ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                      rdfs:label "start time"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
  instant of time when the Execution or Deployment was initiated or tasked
  """@en .


###  http://xmlns.com/foaf/0.1/birthday
<http://xmlns.com/foaf/0.1/birthday> rdf:type owl:DatatypeProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain :MonitoredPerson ;
                                     rdfs:range xsd:date ;
                                     <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "has birthday" ;
                                     rdfs:comment "The date on which a person was born." ;
                                     rdfs:label "has date of birth" .


###  http://xmlns.com/foaf/0.1/firstName
<http://xmlns.com/foaf/0.1/firstName> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://xmlns.com/foaf/0.1/Person> ;
                                      rdfs:range xsd:string ;
                                      <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "hasGivenName" ;
                                      rdfs:comment "A person's first or given name as per their identity document." ;
                                      rdfs:label "has first name" .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <http://xmlns.com/foaf/0.1/Person> ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "A name for some thing." ,
                                              "A person's name." ;
                                 rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                 rdfs:label "has full name" ,
                                            "name" ;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://xmlns.com/foaf/0.1/surname
<http://xmlns.com/foaf/0.1/surname> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://xmlns.com/foaf/0.1/Person> ;
                                    rdfs:range xsd:string ;
                                    <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "hasFamilyName" ,
                                                                                                   "surname" ;
                                    rdfs:comment "A person's last name, family name, or surname as per their identity document." ;
                                    rdfs:label "has last name" .


###  https://saref.etsi.org/core/hasManufacturer
<https://saref.etsi.org/core/hasManufacturer> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                                              rdfs:range xsd:string ;
                                              rdfs:comment "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag."@en ;
                                              rdfs:label "has manufacturer"@en ;
                                              <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Defined domain of saref:hasManufacturer to union of feature kind and feature of interest."@en .


###  https://saref.etsi.org/core/hasModel
<https://saref.etsi.org/core/hasModel> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag."@en ;
                                       rdfs:label "has model"@en ;
                                       <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Defined domain of saref:hasModel to union of feature kind and feature of interest."@en .


###  https://saref.etsi.org/core/hasTimestamp
<https://saref.etsi.org/core/hasTimestamp> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain [ rdf:type owl:Class ;
                                                         owl:unionOf ( <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation>
                                                                       :DiscreteObservation
                                                                       <https://purl.org/heals/eo#SystemRecommendation>
                                                                     )
                                                       ] ;
                                           rdfs:range xsd:dateTimeStamp ;
                                           rdfs:comment "Links a procedure execution or a profile to an instant."@en ;
                                           rdfs:label "has timestamp"@en ;
                                           <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Tried to clarify definition of saref:hasTimestamp. Still unclear."@en ;
                                           <http://www.w3.org/2004/02/skos/core#note> "Applied on a profile, it describes the applicable instant of that profile"@en ,
                                                                                      "When the execution time and the phenomenon time are the same time instants, then DP saref:hasTimestamp can be used to simply link a procedure execution to the time of these instants, expressed as an xsd:dateTime literal."@en .


###  https://saref.etsi.org/core/hasValue
<https://saref.etsi.org/core/hasValue> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain :DiscreteObservation ;
                                       rdfs:range xsd:decimal ;
                                       rdfs:comment "A relationship defining the value of a certain property, e.g., energy or power. Note that, even if numeric values are expected to enable reasoning, measurement values could use other datatypes."@en ;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                       rdfs:label "has value"@en .


#################################################################
#    Classes
#################################################################

###  http://linkedu.eu/dedalo/explanationPattern.owl#Explanation
<http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> rdf:type owl:Class ;
                                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> ;
                                                                                owl:someValuesFrom <https://purl.org/heals/eo#SystemRecommendation>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :isConsumedBy ;
                                                                                owl:someValuesFrom <https://purl.org/heals/eo#user>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasText ;
                                                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onDataRange xsd:string
                                                                              ] ;
                                                              owl:disjointWith <http://purl.obolibrary.org/obo/MAXO_0000001> ,
                                                                               :ApprovalStatus ,
                                                                               :HealthEvent ,
                                                                               :HealthEventPredictionStatus ,
                                                                               :HealthRiskFactor ,
                                                                               :HealthRiskRelationship ,
                                                                               :HealthRiskStatus ,
                                                                               :MedicalCondition ,
                                                                               :Model ,
                                                                               :Publication ,
                                                                               <http://www.w3.org/ns/dcat#Dataset> ,
                                                                               <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                                               <http://www.w3.org/ns/sosa/Observation> ,
                                                                               <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                                               <http://www.w3.org/ns/sosa/Property> ,
                                                                               <http://www.w3.org/ns/sosa/Sensor> ,
                                                                               <http://xmlns.com/foaf/0.1/Agent> ,
                                                                               <https://purl.org/heals/eo#SystemRecommendation> ,
                                                                               <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                               <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                               <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                              <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                              rdfs:comment "An account, consumed by a user, that is based on a system recommendation and the knowledge used to produce it, and that addresses a question the user has." ;
                                                              rdfs:isDefinedBy <http://linkedu.eu/dedalo/explanationPattern.owl> ;
                                                              rdfs:label "Explanation" .


###  http://purl.obolibrary.org/obo/ECO_0000000
<http://purl.obolibrary.org/obo/ECO_0000000> rdf:type owl:Class ;
                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty :isEvidenceFor ;
                                                               owl:someValuesFrom :HealthIntervention
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :isEvidenceFor ;
                                                               owl:someValuesFrom :HealthRiskRelationship
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :isPublishedAs ;
                                                               owl:someValuesFrom :Publication
                                                             ] ;
                                             owl:disjointWith :ApprovalStatus ,
                                                              :HealthEvent ,
                                                              :HealthEventPrediction ,
                                                              :HealthEventPredictionStatus ,
                                                              :HealthIntervention ,
                                                              :HealthRiskAssessment ,
                                                              :HealthRiskFactor ,
                                                              :HealthRiskRelationship ,
                                                              :HealthRiskStatus ,
                                                              :MedicalCondition ,
                                                              :Model ,
                                                              :Publication ,
                                                              <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                              <http://www.w3.org/ns/sosa/Observation> ,
                                                              <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                              <http://www.w3.org/ns/sosa/Property> ,
                                                              <http://www.w3.org/ns/sosa/Sensor> ,
                                                              <http://xmlns.com/foaf/0.1/Agent> ,
                                                              <http://xmlns.com/foaf/0.1/Person> ,
                                                              <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                              <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                              <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "eco" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "evidence code" ,
                                                                                                              "evidence_code" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "ECO:0000000" ;
                                             rdfs:comment "A type of information that is used to support an assertion." ;
                                             rdfs:label "Evidence" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A type of information that is used to support an assertion." ;
                                             <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://purl.org/heals/eo#ScientificKnowledge> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/ECO_0000000> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "A type of information that is used to support an assertion." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ECO:MCC"
 ] .


###  http://purl.obolibrary.org/obo/ECO_0000180
<http://purl.obolibrary.org/obo/ECO_0000180> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://purl.org/spar/fabio/ClinicalTrialReport" ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "eco" ;
                                             <http://www.geneontology.org/formats/oboInOwl#id> "ECO:0000180" ;
                                             rdfs:comment "A type of experimental evidence arising from a controlled investigation that uses human subjects." ;
                                             rdfs:label "Clinical study" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A type of experimental evidence arising from a controlled investigation that uses human subjects." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/ECO_0000180> ;
   owl:annotatedProperty <http://www.geneontology.org/formats/oboInOwl#hasDbXref> ;
   owl:annotatedTarget "http://purl.org/spar/fabio/ClinicalTrialReport" ;
   <http://purl.obolibrary.org/obo/IAO_0000115> "The report of a pre-planned medical or veterinary clinical study of the safety, efficacy, or optimum dosage schedule of one or more diagnostic, therapeutic or prophylactic drugs, or of devices, treatments or techniques, involving a randomized controlled trial for evidence-based assessment in humans or animals selected according to predetermined criteria of eligibility and observed for evidence of favourable and unfavourable effects." ;
   <http://purl.obolibrary.org/obo/IAO_0000119> "FaBiO, the FRBR-aligned Bibliographic Ontology"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/ECO_0000180> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#definition> ;
   owl:annotatedTarget "A type of experimental evidence arising from a controlled investigation that uses human subjects." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ECO:MCC"
 ] .


###  http://purl.obolibrary.org/obo/MAXO_0000001
<http://purl.obolibrary.org/obo/MAXO_0000001> rdf:type owl:Class ;
                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                owl:onProperty :isMedicalActionInIntervention ;
                                                                owl:someValuesFrom :HealthIntervention
                                                              ] ;
                                              owl:disjointWith :ApprovalStatus ,
                                                               :HealthEvent ,
                                                               <https://purl.org/heals/eo#SystemRecommendation> .


###  http://purl.org/phmo#AnthropometricFactor
:AnthropometricFactor rdf:type owl:Class ;
                      rdfs:subClassOf :HealthRiskFactor ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :isDeterminedBy ;
                                        owl:someValuesFrom :DiscreteObservation
                                      ] ;
                      owl:disjointWith :ComorbidityFactor ,
                                       :DemographicFactor ,
                                       :LifestyleFactor .


###  http://purl.org/phmo#AnthropometricProperty
:AnthropometricProperty rdf:type owl:Class ;
                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Property> ;
                        owl:disjointWith <https://saref.etsi.org/saref4wear/BiometricProperty> ;
                        rdfs:comment "Class to group those properties related to the body measurements of monitored individuals." ;
                        rdfs:label "Anthropometric property" .


###  http://purl.org/phmo#ApprovalStatus
:ApprovalStatus rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( :Approved
                                                  :Pending
                                                  :Pre-approved
                                                  :Rejected
                                                )
                                    ] ;
                owl:disjointWith :HealthEvent ,
                                 :HealthEventPrediction ,
                                 :HealthEventPredictionStatus ,
                                 :HealthIntervention ,
                                 :HealthRiskAssessment ,
                                 :HealthRiskFactor ,
                                 :HealthRiskRelationship ,
                                 :HealthRiskStatus ,
                                 :MedicalCondition ,
                                 :Model ,
                                 :Publication ,
                                 <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                 <http://www.w3.org/ns/sosa/Observation> ,
                                 <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                 <http://www.w3.org/ns/sosa/Property> ,
                                 <http://www.w3.org/ns/sosa/Sensor> ,
                                 <http://xmlns.com/foaf/0.1/Agent> ,
                                 <https://purl.org/heals/eo#SystemRecommendation> ,
                                 <https://saref.etsi.org/core/UnitOfMeasure> ,
                                 <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                 <https://saref.etsi.org/saref4wear/WearableDevice> ;
                rdfs:comment "The approval status of a health intervention as determined by a clinician." ;
                rdfs:label "Approval status" .


###  http://purl.org/phmo#ArtificialNeuralNetwork
:ArtificialNeuralNetwork rdf:type owl:Class ;
                         rdfs:subClassOf :Model ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasInputType ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                         <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Deep learning model" ;
                         rdfs:comment "A neural network is a machine learning model that stacks simple \"neurons\" in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs." ;
                         rdfs:label "Artificial neural network" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ArtificialNeuralNetwork ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "A neural network is a machine learning model that stacks simple \"neurons\" in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs." ;
   rdfs:isDefinedBy "\"What is a neural network?\", IBM Think, by Fangfang Lee. https://www.ibm.com/think/topics/neural-networks#741977106, accessed 10 July 2026."
 ] .


###  http://purl.org/phmo#Author
:Author rdf:type owl:Class ;
        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isCreatorOf ;
                          owl:someValuesFrom :Publication
                        ] ;
        owl:disjointWith <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
        rdfs:comment "The author of a publication." ;
        rdfs:label "Author" .


###  http://purl.org/phmo#BMICategory
:BMICategory rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Normal
                                               :ObeseI
                                               :ObeseII
                                               :ObeseIII
                                               :Overweight
                                               :Underweight
                                             )
                                 ] ;
             rdfs:subClassOf :AnthropometricFactor ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isDeterminedBy ;
                               owl:someValuesFrom :BodyHeightObservation
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isDeterminedBy ;
                               owl:someValuesFrom :BodyWeightObservation
                             ] .


###  http://purl.org/phmo#BayesianDecisionNetwork
:BayesianDecisionNetwork rdf:type owl:Class ;
                         rdfs:subClassOf :Model ;
                         rdfs:comment "A Bayesian network extended with decision and utility nodes, used to compare the expected utility of alternative decisions, such as health interventions." ;
                         rdfs:label "Bayesian decision network" .


###  http://purl.org/phmo#BayesianNetwork
:BayesianNetwork rdf:type owl:Class ;
                 rdfs:subClassOf :Model ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasInputRiskFactor ;
                                   owl:someValuesFrom :HealthRiskFactor
                                 ] ;
                 rdfs:comment "Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction." ;
                 rdfs:label "Bayesian network" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BayesianNetwork ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction." ;
   rdfs:isDefinedBy "Bayes Server Learning Center: https://www.bayesserver.com/docs/introduction/bayesian-networks/, accessed 10 July 2026."
 ] .


###  http://purl.org/phmo#Biosignal
:Biosignal rdf:type owl:Class ;
           rdfs:subClassOf <https://saref.etsi.org/saref4wear/BiometricProperty> ;
           owl:disjointWith :VitalSign ;
           <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Biological signal" ;
           rdfs:comment "Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle." ;
           rdfs:label "Biosignal" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Biosignal ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle." ;
   rdfs:isDefinedBy "M. Escabí, “Biosignal Processing,” in Introduction to Biomedical Engineering, ch. 11, pp. 667–746, Elsevier Inc., 3 ed., 2012. https://doi.org/10.1016/B978-0-12-374979-6.00011-3"
 ] .


###  http://purl.org/phmo#BodyHeightObservation
:BodyHeightObservation rdf:type owl:Class ;
                       rdfs:subClassOf :DiscreteObservation ;
                       rdfs:comment "A monitored person's height as determined by a measuring tape or a mechanical height machine." ;
                       rdfs:label "Body height observation" .


###  http://purl.org/phmo#BodyWeightObservation
:BodyWeightObservation rdf:type owl:Class ;
                       rdfs:subClassOf :DiscreteObservation ;
                       rdfs:comment "A monitored person's observed body weight as measured on a body weight scale." ;
                       rdfs:label "Body weight observation" .


###  http://purl.org/phmo#BodyWeightScale
:BodyWeightScale rdf:type owl:Class ;
                 rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
                 rdfs:comment "A scale to measure body weight." ;
                 rdfs:label "Body weight scale" .


###  http://purl.org/phmo#Caregiver
:Caregiver rdf:type owl:Class ;
           rdfs:subClassOf <https://purl.org/heals/eo#user> ;
           owl:disjointWith :Clinician ,
                            :MonitoredPerson ,
                            <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
           rdfs:comment "A caregiver of a monitored person." ;
           rdfs:label "Caregiver" .


###  http://purl.org/phmo#CategoryRiskRelationship
:CategoryRiskRelationship rdf:type owl:Class ;
                          rdfs:subClassOf :HealthRiskRelationship ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasRiskFactorCategory ;
                                            owl:someValuesFrom :HealthRiskFactor
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasCategoryWeight ;
                                            owl:someValuesFrom xsd:decimal
                                          ] ;
                          owl:disjointWith :FactorRiskRelationship ,
                                           :StateRiskRelationship ;
                          rdfs:comment "The relationship between a risk factor category and a medical condition." ;
                          rdfs:label "Category risk relationship" .


###  http://purl.org/phmo#ClinicalRiskScore
:ClinicalRiskScore rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                   rdfs:comment "Risk scores provide a systematic and quantifiable assessment of the likelihood of health outcomes based on risk factors, allowing clinicians to stratify individuals into risk categories." ;
                   rdfs:label "Clinical risk score" .


###  http://purl.org/phmo#Clinician
:Clinician rdf:type owl:Class ;
           rdfs:subClassOf <https://purl.org/heals/eo#user> ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :determinedApprovalStatusForIntervention ;
                             owl:someValuesFrom :HealthIntervention
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :isClinicianOf ;
                             owl:someValuesFrom :MonitoredPerson
                           ] ;
           owl:disjointWith :MonitoredPerson ,
                            <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
           rdfs:comment "A clinician of a monitored person." ;
           rdfs:label "Clinician" .


###  http://purl.org/phmo#ComorbidityFactor
:ComorbidityFactor rdf:type owl:Class ;
                   rdfs:subClassOf :HealthRiskFactor ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :isComorbidityStatusOfCondition ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :MedicalCondition
                                   ] ;
                   owl:disjointWith :DemographicFactor ,
                                    :LifestyleFactor ,
                                    :MedicalCondition ;
                   rdfs:comment "A class to group comorbidity risk factors, i.e. the simultaneous presence of a medical condition co-occurring with atrial fibrillation."@en ;
                   rdfs:label "Comorbidity factor" .


###  http://purl.org/phmo#ContinuousObservation
:ContinuousObservation rdf:type owl:Class ;
                       rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasDuration ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:duration
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://www.w3.org/ns/sosa/endTime> ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTimeStamp
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://www.w3.org/ns/sosa/startTime> ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTimeStamp
                                       ] ;
                       rdfs:comment "An observation of a property made over a series of time. Also known as a time series observation." ;
                       rdfs:label "Continuous observation" .


###  http://purl.org/phmo#DemographicFactor
:DemographicFactor rdf:type owl:Class ;
                   rdfs:subClassOf :HealthRiskFactor ;
                   owl:disjointWith :LifestyleFactor .


###  http://purl.org/phmo#DiscreteObservation
:DiscreteObservation rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <https://saref.etsi.org/core/hasTimestamp> ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTimeStamp
                                     ] ;
                     rdfs:comment "An observation made at a particular instant in time." ;
                     rdfs:label "Discrete observation" .


###  http://purl.org/phmo#FactorRiskRelationship
:FactorRiskRelationship rdf:type owl:Class ;
                        rdfs:subClassOf :HealthRiskRelationship ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasRiskFactor ;
                                          owl:someValuesFrom :HealthRiskFactor
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasFactorWeight ;
                                          owl:someValuesFrom xsd:decimal
                                        ] ;
                        owl:disjointWith :StateRiskRelationship ;
                        rdfs:comment "The relationship between a risk factor and a medical condition." ;
                        rdfs:label "Factor risk relationship" .


###  http://purl.org/phmo#HealthEvent
:HealthEvent rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :isHealthEventOfCondition ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :MedicalCondition
                             ] ;
             owl:disjointWith :HealthEventPrediction ,
                              :HealthEventPredictionStatus ,
                              :HealthIntervention ,
                              :HealthRiskAssessment ,
                              :HealthRiskFactor ,
                              :HealthRiskRelationship ,
                              :HealthRiskStatus ,
                              :MedicalCondition ,
                              :Model ,
                              :Publication ,
                              <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                              <http://www.w3.org/ns/sosa/Observation> ,
                              <http://www.w3.org/ns/sosa/ObservationCollection> ,
                              <http://www.w3.org/ns/sosa/Property> ,
                              <http://www.w3.org/ns/sosa/Sensor> ,
                              <http://xmlns.com/foaf/0.1/Agent> ,
                              <http://xmlns.com/foaf/0.1/Person> ,
                              <https://purl.org/heals/eo#SystemRecommendation> ,
                              <https://saref.etsi.org/core/UnitOfMeasure> ,
                              <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                              <https://saref.etsi.org/saref4wear/WearableDevice> ;
             rdfs:comment "A short-term, imminent occurrence associated with a specific medical condition." ;
             rdfs:label "Health event" .


###  http://purl.org/phmo#HealthEventPrediction
:HealthEventPrediction rdf:type owl:Class ;
                       rdfs:subClassOf <https://purl.org/heals/eo#SystemRecommendation> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasInputObservation ;
                                         owl:someValuesFrom :ContinuousObservation
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasResponseIntervention ;
                                         owl:someValuesFrom :HealthIntervention
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasPredictionStatus ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :HealthEventPredictionStatus
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isPredictionOf ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :MonitoredPerson
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isPredictionOfCondition ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :MedicalCondition
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isPredictionOfHealthEvent ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :HealthEvent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :wasPredictedByModel ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Model
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasInputWindow ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:duration
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasPredictionHorizon ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:duration
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasProbability ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasTargetWindow ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:duration
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <https://saref.etsi.org/core/hasTimestamp> ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTimeStamp
                                       ] ;
                       owl:disjointWith :HealthEventPredictionStatus ,
                                        :HealthIntervention ,
                                        :HealthRiskAssessment ,
                                        :HealthRiskFactor ,
                                        :HealthRiskRelationship ,
                                        :HealthRiskStatus ,
                                        :MedicalCondition ,
                                        :Model ,
                                        :Publication ,
                                        <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                        <http://www.w3.org/ns/sosa/Observation> ,
                                        <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                        <http://www.w3.org/ns/sosa/Property> ,
                                        <http://www.w3.org/ns/sosa/Sensor> ,
                                        <http://xmlns.com/foaf/0.1/Agent> ,
                                        <http://xmlns.com/foaf/0.1/Person> ,
                                        <https://saref.etsi.org/core/UnitOfMeasure> ,
                                        <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                        <https://saref.etsi.org/saref4wear/WearableDevice> ;
                       rdfs:comment "A prediction of a health event in a monitored person as computed by a model." ;
                       rdfs:label "Health event prediction" .


###  http://purl.org/phmo#HealthEventPredictionStatus
:HealthEventPredictionStatus rdf:type owl:Class ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty :isPredictionStatusOf ;
                                               owl:someValuesFrom :HealthEventPrediction
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :isPredictionStatusOfCondition ;
                                               owl:someValuesFrom :MedicalCondition
                                             ] ;
                             owl:disjointWith :HealthIntervention ,
                                              :HealthRiskAssessment ,
                                              :HealthRiskFactor ,
                                              :HealthRiskRelationship ,
                                              :HealthRiskStatus ,
                                              :MedicalCondition ,
                                              :Model ,
                                              :Publication ,
                                              <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                              <http://www.w3.org/ns/sosa/Observation> ,
                                              <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                              <http://www.w3.org/ns/sosa/Property> ,
                                              <http://www.w3.org/ns/sosa/Sensor> ,
                                              <http://xmlns.com/foaf/0.1/Agent> ,
                                              <http://xmlns.com/foaf/0.1/Person> ,
                                              <https://purl.org/heals/eo#SystemRecommendation> ,
                                              <https://saref.etsi.org/core/UnitOfMeasure> ,
                                              <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                              <https://saref.etsi.org/saref4wear/WearableDevice> ;
                             rdfs:comment "The status for a medical conditon event (i.e. present or absent) in a monitored person." ;
                             rdfs:label "Health event prediction status" .


###  http://purl.org/phmo#HealthIntervention
:HealthIntervention rdf:type owl:Class ;
                    rdfs:subClassOf <https://purl.org/heals/eo#SystemRecommendation> ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasMedicalAction ;
                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/MAXO_0000001>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :isEvidencedBy ;
                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/ECO_0000000>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :isRecommendedFor ;
                                      owl:someValuesFrom :MonitoredPerson
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :isInResponseTo ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass [ rdf:type owl:Class ;
                                                    owl:unionOf ( :HealthEventPrediction
                                                                  :HealthRiskAssessment
                                                                )
                                                  ]
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :approvalStatusDeterminedByClinician ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Clinician
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :expectedUtilityCalculatedByModel ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :BayesianDecisionNetwork
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasApprovalStatus ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :ApprovalStatus
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasApprovalStatusTimestamp ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTimeStamp
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasExpectedUtility ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasRecommendationTimestamp ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTimeStamp
                                    ] ;
                    owl:disjointWith :HealthRiskAssessment ,
                                     :HealthRiskFactor ,
                                     :HealthRiskRelationship ,
                                     :HealthRiskStatus ,
                                     :MedicalCondition ,
                                     :Model ,
                                     :Publication ,
                                     <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                     <http://www.w3.org/ns/sosa/Observation> ,
                                     <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                     <http://www.w3.org/ns/sosa/Property> ,
                                     <http://www.w3.org/ns/sosa/Sensor> ,
                                     <http://xmlns.com/foaf/0.1/Agent> ,
                                     <https://saref.etsi.org/core/UnitOfMeasure> ,
                                     <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                     <https://saref.etsi.org/saref4wear/WearableDevice> ;
                    rdfs:comment "Any activity undertaken with the objective of improving human health by preventing disease, by curing or reducing the severity or duration of an existing disease, or by restoring function lost through disease or injury." ;
                    rdfs:label "Health intervention" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HealthIntervention ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Any activity undertaken with the objective of improving human health by preventing disease, by curing or reducing the severity or duration of an existing disease, or by restoring function lost through disease or injury." ;
   rdfs:isDefinedBy "Smith, Peter G., Richard H. Morrow, and David A. Ross. \"Field Trials of Health Interventions.\", ch. 2 , 3 ed., 2015. https://www.ncbi.nlm.nih.gov/books/NBK305514/"
 ] .


###  http://purl.org/phmo#HealthRiskAssessment
:HealthRiskAssessment rdf:type owl:Class ;
                      rdfs:subClassOf <https://purl.org/heals/eo#SystemRecommendation> ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasInputRiskFactorState ;
                                        owl:someValuesFrom :HealthRiskFactor
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasResponseIntervention ;
                                        owl:someValuesFrom :HealthIntervention
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :isRiskAssessmentOf ;
                                        owl:allValuesFrom :MonitoredPerson
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :isRiskAssessmentOfCondition ;
                                        owl:allValuesFrom :MedicalCondition
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasRiskStatus ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :HealthRiskStatus
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :wasAssessedByModel ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Model
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasProbability ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty <https://saref.etsi.org/core/hasTimestamp> ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTimeStamp
                                      ] ;
                      owl:disjointWith :HealthRiskFactor ,
                                       :HealthRiskRelationship ,
                                       :HealthRiskStatus ,
                                       :MedicalCondition ,
                                       :Model ,
                                       :Publication ,
                                       <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                       <http://www.w3.org/ns/sosa/Observation> ,
                                       <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                       <http://www.w3.org/ns/sosa/Sensor> ,
                                       <http://xmlns.com/foaf/0.1/Agent> ,
                                       <http://xmlns.com/foaf/0.1/Person> ,
                                       <https://saref.etsi.org/core/UnitOfMeasure> ,
                                       <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                       <https://saref.etsi.org/saref4wear/WearableDevice> ;
                      rdfs:comment "An assessment of disease risk in a monitored person as computed by a model." ;
                      rdfs:label "Health risk assessment" .


###  http://purl.org/phmo#HealthRiskFactor
:HealthRiskFactor rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :isEffectModifierInRelationship ;
                                    owl:someValuesFrom :StateRiskRelationship
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isRiskFactorCategoryInRelationship ;
                                    owl:someValuesFrom :CategoryRiskRelationship
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isRiskFactorInRelationship ;
                                    owl:someValuesFrom :FactorRiskRelationship
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isRiskFactorStateInRelationship ;
                                    owl:someValuesFrom :StateRiskRelationship
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isRiskFactorStatusOf ;
                                    owl:someValuesFrom :MonitoredPerson
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasDateOfConfirmation ;
                                    owl:someValuesFrom xsd:date
                                  ] ;
                  owl:disjointWith :HealthRiskRelationship ,
                                   :HealthRiskStatus ,
                                   :MedicalCondition ,
                                   :Model ,
                                   :Publication ,
                                   <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                   <http://www.w3.org/ns/sosa/Observation> ,
                                   <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                   <http://www.w3.org/ns/sosa/Property> ,
                                   <http://www.w3.org/ns/sosa/Sensor> ,
                                   <http://xmlns.com/foaf/0.1/Agent> ,
                                   <http://xmlns.com/foaf/0.1/Person> ,
                                   <https://purl.org/heals/eo#SystemRecommendation> ,
                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                  <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MSH:D012307"@en ,
                                                                           "SNOMEDCT_US:80943009"@en ,
                                                                           "UMLS:C0035648"@en ;
                  rdfs:comment "An aspect of personal behavior or lifestyle, environmental exposure, inborn or inherited characteristic, which, based on epidemiological evidence, is known to be associated with a health-related condition considered important to prevent."@en ,
                               "Class to group risk factors associated with atrial fibrillation."@en ;
                  rdfs:label "Health risk factor" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HealthRiskFactor ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "An aspect of personal behavior or lifestyle, environmental exposure, inborn or inherited characteristic, which, based on epidemiological evidence, is known to be associated with a health-related condition considered important to prevent."@en ;
   rdfs:isDefinedBy "Medical Subject Headings (MeSH)"
 ] .


###  http://purl.org/phmo#HealthRiskRelationship
:HealthRiskRelationship rdf:type owl:Class ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty :isEvidencedBy ;
                                          owl:someValuesFrom <http://purl.obolibrary.org/obo/ECO_0000000>
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasRiskOfCondition ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :MedicalCondition
                                        ] ;
                        owl:disjointWith :HealthRiskStatus ,
                                         :MedicalCondition ,
                                         :Model ,
                                         :Publication ,
                                         <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                         <http://www.w3.org/ns/sosa/Observation> ,
                                         <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                         <http://www.w3.org/ns/sosa/Property> ,
                                         <http://www.w3.org/ns/sosa/Sensor> ,
                                         <http://xmlns.com/foaf/0.1/Agent> ,
                                         <http://xmlns.com/foaf/0.1/Person> ,
                                         <https://purl.org/heals/eo#SystemRecommendation> ,
                                         <https://saref.etsi.org/core/UnitOfMeasure> ,
                                         <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                         <https://saref.etsi.org/saref4wear/WearableDevice> ;
                        rdfs:comment "The relationship between a risk factor, risk factory category, or risk factor state, and a medical condition." ;
                        rdfs:label "Health risk relationship" .


###  http://purl.org/phmo#HealthRiskStatus
:HealthRiskStatus rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :isRiskStatusOf ;
                                    owl:someValuesFrom :HealthRiskAssessment
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isRiskStatusOfCondition ;
                                    owl:someValuesFrom :MedicalCondition
                                  ] ;
                  owl:disjointWith :MedicalCondition ,
                                   :Publication ,
                                   <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                   <http://www.w3.org/ns/sosa/Observation> ,
                                   <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                   <http://www.w3.org/ns/sosa/Property> ,
                                   <http://www.w3.org/ns/sosa/Sensor> ,
                                   <http://xmlns.com/foaf/0.1/Agent> ,
                                   <http://xmlns.com/foaf/0.1/Person> ,
                                   <https://purl.org/heals/eo#SystemRecommendation> ,
                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                  rdfs:comment "The status for a disease risk (i.e. present or absent) in a monitored person." ;
                  rdfs:label "Health risk status" .


###  http://purl.org/phmo#LifestyleFactor
:LifestyleFactor rdf:type owl:Class ;
                 rdfs:subClassOf :HealthRiskFactor .


###  http://purl.org/phmo#MedicalCondition
:MedicalCondition rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :isConditionInComorbidityStatus ;
                                    owl:someValuesFrom :ComorbidityFactor
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isConditionInHealthEvent ;
                                    owl:someValuesFrom :HealthEvent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isConditionInRiskAssessment ;
                                    owl:someValuesFrom :HealthRiskAssessment
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isConditionInRiskRelationship ;
                                    owl:someValuesFrom :HealthRiskRelationship
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isConditionInRiskStatus ;
                                    owl:someValuesFrom :HealthRiskStatus
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasICD10Block ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasICD10Code ;
                                    owl:someValuesFrom xsd:string
                                  ] ;
                  owl:disjointWith :Model ,
                                   :Publication ,
                                   <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                   <http://www.w3.org/ns/sosa/Observation> ,
                                   <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                   <http://www.w3.org/ns/sosa/Property> ,
                                   <http://www.w3.org/ns/sosa/Sensor> ,
                                   <http://xmlns.com/foaf/0.1/Agent> ,
                                   <http://xmlns.com/foaf/0.1/Person> ,
                                   <https://purl.org/heals/eo#SystemRecommendation> ,
                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                  rdfs:comment "A broad term that includes diseases, illnesses, disorders, defects and dysfunctions." ,
                               "All subclasses of this class are punned such that they are both classes and individuals. \"In OWL 2 the same name can be used for a class, a property and an individual, a feature known as punning.\"" ;
                  rdfs:label "Medical condition" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :MedicalCondition ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "All subclasses of this class are punned such that they are both classes and individuals. \"In OWL 2 the same name can be used for a class, a property and an individual, a feature known as punning.\"" ;
   rdfs:isDefinedBy "I. Horrocks and P. F. Patel-Schneider, “Knowledge Representation and Reasoning on the Semantic Web: OWL,” in Handbook of Semantic Web Technologies, Springer, 2011, pp. 365–398. https://doi.org/10.1007/978-3-540-92913-0_9"
 ] .


###  http://purl.org/phmo#Model
:Model rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :madeEventPrediction ;
                         owl:someValuesFrom :HealthEventPrediction
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :madeRiskAssessment ;
                         owl:someValuesFrom :HealthRiskAssessment
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :wasTestedOn ;
                         owl:someValuesFrom <http://www.w3.org/ns/dcat#Dataset>
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :wasTrainedOn ;
                         owl:someValuesFrom <http://www.w3.org/ns/dcat#Dataset>
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasPerformanceMetric ;
                         owl:someValuesFrom xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAUPRC ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAUROC ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBrierScore ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDecisionThreshold ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasExpectedCalibrationError ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasF1Score ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasRecall ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSpecificity ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:float
                       ] ;
       owl:disjointWith :Publication ,
                        <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                        <http://www.w3.org/ns/sosa/Observation> ,
                        <http://www.w3.org/ns/sosa/ObservationCollection> ,
                        <http://www.w3.org/ns/sosa/Property> ,
                        <http://xmlns.com/foaf/0.1/Agent> ,
                        <http://xmlns.com/foaf/0.1/Person> ,
                        <https://purl.org/heals/eo#SystemRecommendation> ,
                        <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
       rdfs:comment "The model used to determine a health risk assessment or an event prediction." ;
       rdfs:label "Model" .


###  http://purl.org/phmo#MonitoredPerson
:MonitoredPerson rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                 <https://purl.org/heals/eo#user> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasBMICategory ;
                                   owl:someValuesFrom :BMICategory
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasComorbidityStatus ;
                                   owl:someValuesFrom :ComorbidityFactor
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasPrediction ;
                                   owl:someValuesFrom :HealthEventPrediction
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasRiskAssessment ;
                                   owl:someValuesFrom :HealthRiskAssessment
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasRiskFactorStatus ;
                                   owl:someValuesFrom :HealthRiskFactor
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasSex ;
                                   owl:someValuesFrom :Sex
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :wearsDevice ;
                                   owl:someValuesFrom <https://saref.etsi.org/saref4wear/WearableDevice>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasAge ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:integer
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasBMI ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:decimal
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasIDNumber ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://xmlns.com/foaf/0.1/birthday> ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:date
                                 ] ;
                 rdfs:comment "A person being monitored by the system." ;
                 rdfs:label "Monitored person" ;
                 <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://purl.org/heals/eo#object_record> .


###  http://purl.org/phmo#Publication
:Publication rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.org/dc/terms/creator> ;
                               owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isPublicationOf ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/ECO_0000000>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                               owl:someValuesFrom <http://purl.org/spar/fabio/Book>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.org/dc/terms/creator> ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass [ rdf:type owl:Class ;
                                             owl:unionOf ( :Author
                                                           <http://xmlns.com/foaf/0.1/Organization>
                                                         )
                                           ]
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/doi> ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasPublicationMonthYear ;
                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                    owl:unionOf ( xsd:gYear
                                                                  xsd:gYearMonth
                                                                )
                                                  ]
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/isbn> ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.org/dc/terms/title> ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ;
             owl:disjointWith <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                              <http://www.w3.org/ns/sosa/Observation> ,
                              <http://www.w3.org/ns/sosa/ObservationCollection> ,
                              <http://www.w3.org/ns/sosa/Property> ,
                              <http://www.w3.org/ns/sosa/Sensor> ,
                              <http://xmlns.com/foaf/0.1/Agent> ,
                              <http://xmlns.com/foaf/0.1/Person> ,
                              <https://purl.org/heals/eo#SystemRecommendation> ,
                              <https://saref.etsi.org/core/UnitOfMeasure> ,
                              <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                              <https://saref.etsi.org/saref4wear/WearableDevice> ;
             <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "http://purl.org/spar/fabio/Expression" ;
             rdfs:comment "A publication is a documentation of scientific knowledge released for public distribution." ;
             rdfs:label "Publication" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Publication ;
   owl:annotatedProperty <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> ;
   owl:annotatedTarget "http://purl.org/spar/fabio/Expression" ;
   <http://purl.obolibrary.org/obo/IAO_0000115> "A subclass of FRBR expression, restricted to expressions of fabio:Works.  For your latest research paper, the preprint submitted to the publisher, and the final published version to which the publisher assigned a unique digital object identifier, are both expressions of the same work." ;
   <http://purl.obolibrary.org/obo/IAO_0000119> "FaBiO, the FRBR-aligned Bibliographic Ontology" ;
   rdfs:comment "A Publication can be considered an Expression of a Work."
 ] .


###  http://purl.org/phmo#Sex
:Sex rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Class ;
                           owl:oneOf ( :Female
                                       :Male
                                       :Specified
                                     )
                         ] ;
     rdfs:subClassOf :DemographicFactor .


###  http://purl.org/phmo#Stadiometer
:Stadiometer rdf:type owl:Class ;
             rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
             rdfs:comment "Medical equipment used to measure human height." ;
             rdfs:label "Stadiometer" .


###  http://purl.org/phmo#StateRiskRelationship
:StateRiskRelationship rdf:type owl:Class ;
                       rdfs:subClassOf :HealthRiskRelationship ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasRiskFactorState ;
                                         owl:someValuesFrom :HealthRiskFactor
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasStateRisk ;
                                         owl:someValuesFrom xsd:decimal
                                       ] ;
                       rdfs:comment "The relationship between a risk factor state and a medical condition." ;
                       rdfs:label "State risk relationship" ;
                       <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://purl.org/heals/eo#Numerical_Evidence> .


###  http://purl.org/phmo#VitalSign
:VitalSign rdf:type owl:Class ;
           rdfs:subClassOf <https://saref.etsi.org/saref4wear/BiometricProperty> ;
           <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0518766" ;
           rdfs:comment "The signs of life that may be monitored or measured, namely pulse rate, respiratory rate, body temperature, and blood pressure." ;
           rdfs:label "Vital sign" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :VitalSign ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "The signs of life that may be monitored or measured, namely pulse rate, respiratory rate, body temperature, and blood pressure." ;
   rdfs:isDefinedBy "The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/?term=D055986. Accessed 21 June 2023."
 ] .


###  http://purl.org/spar/fabio/AcademicProceedings
<http://purl.org/spar/fabio/AcademicProceedings> rdf:type owl:Class ;
                                                 rdfs:subClassOf :Publication ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                                   owl:someValuesFrom <http://purl.org/spar/fabio/ProceedingsPaper>
                                                                 ] ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-academic-proceedings a fabio:AcademicProceedings ;
            dcterms:title 'Patent Infringement Proceedings'@en ;
            frbr:part :my-proceedings-paper .
    """ ;
                                                 rdfs:comment "A document containing the programme and collected papers, or their abstracts, presented at an academic meeting."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                                 rdfs:label "Academic proceedings"@en ;
                                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/Book
<http://purl.org/spar/fabio/Book> rdf:type owl:Class ;
                                  rdfs:subClassOf :Publication ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                    owl:someValuesFrom <http://purl.org/spar/fabio/BookChapter>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/isbn> ;
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:string
                                                  ] ;
                                  rdfs:comment "A non-serial document that is complete in one volume or a designated finite number of volumes.  A book published by a publisher is usually  identified by an International Standard Book Number (ISBN), and may be manifested as a physical printed publication on paper bound in a hard or soft cover, or in electronic format as an 'e-book'."@en ;
                                  rdfs:label "Book"@en .


###  http://purl.org/spar/fabio/BookChapter
<http://purl.org/spar/fabio/BookChapter> rdf:type owl:Class ;
                                         rdfs:subClassOf :Publication ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                           owl:someValuesFrom <http://purl.org/spar/fabio/Book>
                                                         ] ;
                                         rdfs:comment "A defined chapter of a book, usually with a separate title or number."@en ;
                                         rdfs:label "Book chapter"@en .


###  http://purl.org/spar/fabio/ClinicalCaseReport
<http://purl.org/spar/fabio/ClinicalCaseReport> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                                rdfs:comment "A presentation of findings following a clinical or medical investigation on a human or animal patient, that may contain a diagnosis and proposals for therapeutic treatment and/or epidemiological control measures, or may propose further evaluative studies that will eventually lead to such outcomes."@en ;
                                                rdfs:label "Clinical case report"@en .


###  http://purl.org/spar/fabio/ClinicalGuideline
<http://purl.org/spar/fabio/ClinicalGuideline> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                               rdfs:comment "A recommendation on the appropriate treatment and care of people with a specific disease or condition, based on the best available evidence, designed to help healthcare professionals in their work."@en ;
                                               rdfs:label "Clinical guideline"@en .


###  http://purl.org/spar/fabio/ConferencePaper
<http://purl.org/spar/fabio/ConferencePaper> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.org/spar/fabio/ProceedingsPaper> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                               owl:someValuesFrom <http://purl.org/spar/fabio/ConferenceProceedings>
                                                             ] ;
                                             rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually published within a conference proceedings volume."@en ;
                                             rdfs:label "Conference paper"@en .


###  http://purl.org/spar/fabio/ConferenceProceedings
<http://purl.org/spar/fabio/ConferenceProceedings> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.org/spar/fabio/AcademicProceedings> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                                     owl:someValuesFrom <http://purl.org/spar/fabio/ConferencePaper>
                                                                   ] ;
                                                   <http://purl.org/vocab/vann/example> """
        :my-conference-proceedings a fabio:ConferenceProceedings ;
            dcterms:title 'Proceedings of the 25th International Semantic Web Conference'@en ;
            frbr:part :my-conference-paper, :my-another-conference-paper ;
            dcterms:description 'The formal record of a conference, containing the collection of papers and abstracts presented.'@en .
    """ ;
                                                   rdfs:comment "A document containing the programme and collected conference papers, or their abstracts, presented at a conference, seminar, symposium or similar event."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                                   rdfs:label "Conference proceedings"@en ;
                                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/Journal
<http://purl.org/spar/fabio/Journal> rdf:type owl:Class ;
                                     rdfs:subClassOf :Publication ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                       owl:someValuesFrom <http://purl.org/spar/fabio/JournalArticle>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                       owl:someValuesFrom <http://purl.org/spar/fabio/JournalIssue>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                       owl:someValuesFrom <http://purl.org/spar/fabio/JournalVolume>
                                                     ] ;
                                     <http://purl.org/vocab/vann/example> """
        :my-journal a fabio:Journal ;
            dcterms:title 'Journal of Semantic Web Research'@en ;
            frbr:part :my-journal-issue , :my-journal-volume ;
            dcterms:description 'A scholarly periodical maintaining high standards of research and typically published at regular intervals.'@en .
    """ ;
                                     rdfs:comment "A scholarly periodical primarily devoted to the publication of original research papers."@en ;
                                     rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                     rdfs:label "Journal"@en ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Printed and electronic manifestations of the same journal are usually identified by separate print and electronic International Standard Serial Numbers (ISSN or eISSN, respectively), that identifies the journal as a whole, not to individual issues of it."@en .


###  http://purl.org/spar/fabio/JournalArticle
<http://purl.org/spar/fabio/JournalArticle> rdf:type owl:Class ;
                                            rdfs:subClassOf :Publication ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                              owl:someValuesFrom <http://purl.org/spar/fabio/JournalIssue>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                              owl:someValuesFrom <http://purl.org/spar/fabio/JournalVolume>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/doi> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:string
                                                            ] ;
                                            rdfs:comment "An article, typically the realization of a research paper reporting original research findings, published in a journal issue.  "@en ;
                                            rdfs:label "Journal article"@en .


###  http://purl.org/spar/fabio/JournalIssue
<http://purl.org/spar/fabio/JournalIssue> rdf:type owl:Class ;
                                          rdfs:subClassOf :Publication ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                            owl:someValuesFrom <http://purl.org/spar/fabio/JournalArticle>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                            owl:someValuesFrom <http://purl.org/spar/fabio/JournalVolume>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/issueIdentifier> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:int
                                                          ] ;
                                          <http://purl.org/vocab/vann/example> """
        :my-journal-issue a fabio:JournalIssue ;
            dcterms:title 'Journal of Semantic Web, Volume 1, Issue 1'@en ;
            frbr:partOf :my-journal-volume ;
            dcterms:description 'A particular issue of a journal or other periodical.'@en .
    """ ;
                                          rdfs:comment "A particular published issue of a journal, one or more of which will constitute a volume of the journal."@en ;
                                          rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                          rdfs:label "Journal issue"@en ;
                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/JournalVolume
<http://purl.org/spar/fabio/JournalVolume> rdf:type owl:Class ;
                                           rdfs:subClassOf :Publication ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/JournalArticle>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/JournalIssue>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/Journal>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/volume> ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onDataRange xsd:int
                                                           ] ;
                                           <http://purl.org/vocab/vann/example> """
        :my-journal-volume a fabio:JournalVolume ;
            dcterms:title 'Journal of Semantic Web Research, Volume 1'@en ;
            frbr:partOf :my-journal ;
            dcterms:description 'A particular volume of a journal or other periodical, usually collecting all issues published within a single year.'@en .
    """ ;
                                           rdfs:comment "A particular published volume of a journal, comprising one or more journal issues."@en ;
                                           rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                           rdfs:label "Journal volume"@en ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/ProceedingsPaper
<http://purl.org/spar/fabio/ProceedingsPaper> rdf:type owl:Class ;
                                              rdfs:subClassOf :Publication ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                                owl:someValuesFrom <http://purl.org/spar/fabio/AcademicProceedings>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/doi> ;
                                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:string
                                                              ] ;
                                              rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually published within an academic proceedings volume."@en ;
                                              rdfs:label "Proceedings paper"@en .


###  http://purl.org/spar/fabio/ResearchPaper
<http://purl.org/spar/fabio/ResearchPaper> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                           rdfs:comment """A scholarly work that reports original research contributions addressing theoretical, analytical or experimental aspects of a particular scholarly domain.

E.g. see http://iswc2018.semanticweb.org/call-for-research-track-papers/."""@en ;
                                           rdfs:label "Research paper"@en .


###  http://purl.org/spar/fabio/Review
<http://purl.org/spar/fabio/Review> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                    rdfs:comment "A review of others' work."@en ;
                                    rdfs:label "Review"@en .


###  http://purl.org/spar/fabio/ReviewPaper
<http://purl.org/spar/fabio/ReviewPaper> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.org/spar/fabio/Review> ;
                                         rdfs:comment """A scholarly work that surveys the state of the art of topics central to a particular subject or relating to a specific domain (e.g. the scope of a certain journal or conference). Papers of this kind may contain a selective bibliography listing key papers related to the subject or providing advice on information sources, or they may strive to be comprehensive, covering all contributions to the development of a topic and exploring their different findings or views.

E.g. see http://www.emeraldgrouppublishing.com/products/journals/author_guidelines.htm?id=JD"""@en ;
                                         rdfs:label "Review paper"@en .


###  http://purl.org/spar/fabio/SystematicReview
<http://purl.org/spar/fabio/SystematicReview> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.org/spar/fabio/Review> ;
                                              rdfs:comment "A literature review focused on a single question that tries to identify, appraise, select and synthesize all high quality research evidence relevant to that question. Systematic reviews of high-quality randomized controlled trials are crucial to evidence-based medicine. An understanding of systematic reviews and how to implement them in practice is becoming mandatory for all professionals involved in the delivery of health care. Systematic reviews are not limited to medicine,  and are quite common in other sciences such as psychology, educational research and sociology."@en ;
                                              rdfs:label "Systematic review"@en .


###  http://purl.org/spar/fabio/WorkshopPaper
<http://purl.org/spar/fabio/WorkshopPaper> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.org/spar/fabio/ProceedingsPaper> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/WorkshopProceedings>
                                                           ] ;
                                           rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually presented at a workshop and published within a workshop proceedings volume."@en ;
                                           rdfs:label "Workshop paper"@en .


###  http://purl.org/spar/fabio/WorkshopProceedings
<http://purl.org/spar/fabio/WorkshopProceedings> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.org/spar/fabio/AcademicProceedings> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                                   owl:someValuesFrom <http://purl.org/spar/fabio/WorkshopPaper>
                                                                 ] ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-workshop-proceedings a fabio:WorkshopProceedings ;
            dcterms:title 'Proceedings of the International Workshop on Linked Open Data 2026'@en ;
            frbr:part :my-workshop-paper ;
            dcterms:description 'A collection of papers presented at a workshop.'@en .
    """ ;
                                                 rdfs:comment "A document containing the programme and collected workshop papers, or their abstracts, presented at a workshop or similar event."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                                 rdfs:label "Workshop proceedings"@en ;
                                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://www.w3.org/ns/dcat#Dataset
<http://www.w3.org/ns/dcat#Dataset> rdf:type owl:Class ;
                                    owl:disjointWith <https://purl.org/heals/eo#SystemRecommendation> ;
                                    rdfs:comment "A collection of data, published or curated by a single agent, and available for access or download in one or more representations." ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/dcat#> ;
                                    rdfs:label "Dataset" .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
<http://www.w3.org/ns/sosa/FeatureOfInterest> rdf:type owl:Class ;
                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                                owl:someValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                                owl:someValuesFrom <http://www.w3.org/ns/sosa/ObservationCollection>
                                                              ] ;
                                              owl:disjointWith <http://www.w3.org/ns/sosa/Observation> ,
                                                               <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                               <http://www.w3.org/ns/sosa/Property> ,
                                                               <http://www.w3.org/ns/sosa/Sensor> ,
                                                               <http://xmlns.com/foaf/0.1/Organization> ,
                                                               <https://purl.org/heals/eo#SystemRecommendation> ,
                                                               <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                               <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                               <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                              rdfs:comment "entity that is the target of an Execution or Deployment i.e., whose property is being estimated by an Observation, or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling, or which is the target of Executions planned as part of a Deployment." ;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                              rdfs:label "Feature of interest"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> """
  entity that is the target of an Execution or Deployment

  i.e., whose property is being estimated by an Observation, 
  or whose property is being manipulated by an Actuator, 
  or which is being sampled or transformed in an act of Sampling, 
  or which is the target of Executions planned as part of a Deployment.
  """@en ;
                                              <http://www.w3.org/2004/02/skos/core#example> "When measuring the height of a tree, the height is the observed Property, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuation."@en .


###  http://www.w3.org/ns/sosa/Observation
<http://www.w3.org/ns/sosa/Observation> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/isMemberOf> ;
                                                          owl:someValuesFrom <http://www.w3.org/ns/sosa/ObservationCollection>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
                                                          owl:someValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <http://www.w3.org/ns/sosa/Property>
                                                        ] ;
                                        owl:disjointWith <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                         <http://www.w3.org/ns/sosa/Property> ,
                                                         <http://www.w3.org/ns/sosa/Sensor> ,
                                                         <http://xmlns.com/foaf/0.1/Agent> ,
                                                         <http://xmlns.com/foaf/0.1/Person> ,
                                                         <https://purl.org/heals/eo#SystemRecommendation> ,
                                                         <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                         <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                         <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                        rdfs:comment "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                         <http://www.w3.org/ns/sosa/obs/> ;
                                        rdfs:label "Observation"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> """
  act of carrying out an ObservingProcedure using a Sensor to estimate or calculate a value of an observable Property of a FeatureOfInterest
  """@en ,
                                                                                         "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
                                        <http://www.w3.org/2004/02/skos/core#example> "The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake."@en ;
                                        <http://www.w3.org/2004/02/skos/core#note> """
  When the feature of interest cannot be observed directly, a sample of it might be used in Observations as a proxy for it. In such case, the Sample is the proximate Feature of Interest of the Observation, while the (ultimate) Feature of Interest of the act of Sampling (i.e., the entity that the Sample is ultimately 'isSampleOf') is the ultimate Feature of Interest of the Observation.
  """ ;
                                        <http://www.w3.org/2004/02/skos/core#scopeNote> """
  An Observation primarily concerns a single Property of a single FeatureOfInterest. 
  Observations of multiple properties, or other combinations of Observations, may be described in an ObservationCollection. 
  
  Alternatively, applications may choose to encapsulate complexity by defining a complex property with multiple individual components, and a corresponding complex result (e.g., a vector). 
  This approach is not prohibited by the SSN Ontology, but the details are beyond the scope of SSN.
  """@en .


###  http://www.w3.org/ns/sosa/ObservationCollection
<http://www.w3.org/ns/sosa/ObservationCollection> rdf:type owl:Class ;
                                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                    owl:someValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasMember> ;
                                                                    owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                    owl:onClass <http://www.w3.org/ns/sosa/Observation>
                                                                  ] ;
                                                  owl:disjointWith <http://www.w3.org/ns/sosa/Property> ,
                                                                   <http://www.w3.org/ns/sosa/Sensor> ,
                                                                   <http://xmlns.com/foaf/0.1/Agent> ,
                                                                   <http://xmlns.com/foaf/0.1/Person> ,
                                                                   <https://purl.org/heals/eo#SystemRecommendation> ,
                                                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                  rdfs:comment "set of Observations or ObservationCollections; collections may be nested All Observation properties may appear in an Observation Collection, including: hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. The following consistency rules apply with respect to the Observation properties listed above: 1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property. 2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property. That property MAY then be omitted in any member Observation or Observation Collection. 3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. 4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval. 5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals." ;
                                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                                  rdfs:label "Observation collection"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> """
  set of Observations or ObservationCollections; collections may be nested

  All Observation properties may appear in an Observation Collection, including: 
  hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : 
  If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. 
  The following consistency rules apply with respect to the Observation properties listed above: 
  
  1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property.

  2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property.  That property MAY then be omitted in any member Observation or Observation Collection.

  3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. 
  
  4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval.

  5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals.
  """@en ;
                                                  <http://www.w3.org/2004/02/skos/core#note> """An instance of ObservationCollection represents a container for a set of data derived from observations.
  This broadly corresponds with the class Dataset from DCAT."""@en ,
                                                                                             "The members of a collection do not necessarily share a common value for any property. "@en ,
                                                                                             """The results of collections of observations are often packaged in a 'data cube' whose axes define the
      range of properties of the set of observations.""" .


###  http://www.w3.org/ns/sosa/Property
<http://www.w3.org/ns/sosa/Property> rdf:type owl:Class ;
                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/isObservedBy> ;
                                                       owl:someValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/wasObservedBy> ;
                                                       owl:someValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                     ] ;
                                     owl:disjointWith <http://www.w3.org/ns/sosa/Sensor> ,
                                                      <http://xmlns.com/foaf/0.1/Agent> ,
                                                      <http://xmlns.com/foaf/0.1/Person> ,
                                                      <https://purl.org/heals/eo#SystemRecommendation> ,
                                                      <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                      <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                      <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                     rdfs:comment "identifiable quality of features of interest that can be observed or acted upon A property can apply to different features of interest." ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                     rdfs:label "Property"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> """
  identifiable quality of features of interest that can be observed or acted upon

  A property can apply to different features of interest.

  """@en ;
                                     <http://www.w3.org/2004/02/skos/core#example> "Cars (a feature type) all have a characteristic colour, where 'colour' is a property."@en ;
                                     <http://www.w3.org/2004/02/skos/core#note> "Concepts from existing code lists, vocabularies, and taxonomies, may be used as instances of Property"@en .


###  http://www.w3.org/ns/sosa/Sensor
<http://www.w3.org/ns/sosa/Sensor> rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/madeObservation> ;
                                                     owl:someValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                     owl:someValuesFrom <http://www.w3.org/ns/sosa/Property>
                                                   ] ;
                                   owl:disjointWith <http://xmlns.com/foaf/0.1/Person> ,
                                                    <https://purl.org/heals/eo#SystemRecommendation> ,
                                                    <https://saref.etsi.org/core/UnitOfMeasure> ;
                                   rdfs:comment "System that implements an ObservingProcedure to determine the value of an observable Property This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation). A Sensor responds to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations." ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                   rdfs:label "Sensor"@en ;
                                   <http://www.w3.org/2004/02/skos/core#altLabel> "Observer"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> """
  System that implements an ObservingProcedure to determine the value of an observable Property

  This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation).

  A Sensor responds to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations.
  """@en ;
                                   <http://www.w3.org/2004/02/skos/core#example> "Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smartphone (which acts as Host or Platform). Other examples of Sensors include the human eyes."@en ;
                                   <http://www.w3.org/2004/02/skos/core#note> "The UML class 'Observer' from ISO 19156:2023 is implemented in SOSA by the OWL/RDFS class 'Sensor'. The class name 'Sensor' is preferred for backward compatibility with existing SOSA deployments. " ;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensor"@en .


###  http://xmlns.com/foaf/0.1/Agent
<http://xmlns.com/foaf/0.1/Agent> rdf:type owl:Class ;
                                  owl:disjointWith <https://purl.org/heals/eo#SystemRecommendation> ,
                                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                  rdfs:comment "An agent (eg. person, group, software or physical artifact)." ;
                                  rdfs:label "Agent" ;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :isCreatorOf ;
                                                           owl:someValuesFrom :Publication
                                                         ] ;
                                         owl:disjointWith <http://xmlns.com/foaf/0.1/Person> ;
                                         rdfs:comment "An organization." ;
                                         rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                         rdfs:label "Organization" ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://xmlns.com/foaf/0.1/firstName> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://xmlns.com/foaf/0.1/name> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://xmlns.com/foaf/0.1/surname> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ;
                                   owl:disjointWith <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                    <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                    <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                   rdfs:comment "A person." ;
                                   rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                   rdfs:label "Person" ;
                                   <http://www.w3.org/2003/06/sw-vocab-status/nsterm_status> "stable" .


###  https://purl.org/heals/eo#ContrastiveExplanation
<https://purl.org/heals/eo#ContrastiveExplanation> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                   <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                   rdfs:comment "Answers the question “Why this output instead of that output,” making a contrast between the given output and the facts that led to it (inputs and other considerations), and an alternate output of interest and the foil (facts that would have led to it)." ;
                                                   rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                   rdfs:label "Contrastive explanation" ;
                                                   <http://www.w3.org/2004/02/skos/core#example> "Why choose option A over option B that I typically choose?" ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ that was made (let’s call it A)? What facts led to it? Is there another ‘system recommendation’ that could have happened or did occur, (let’s call it B)? What was the ‘foil’ that led to B? Can A and B be compared?" .


###  https://purl.org/heals/eo#CounterfactualExplanation
<https://purl.org/heals/eo#CounterfactualExplanation> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                      <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                      rdfs:comment "Addresses the question of what solutions would have been obtained with a different set of inputs than those used." ;
                                                      rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                      rdfs:label "Counterfactual explanation" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "What if input A was over 1000?" ;
                                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a different set of inputs that can be considered? If so what is the alternate ‘system recommendation’?" .


###  https://purl.org/heals/eo#DataExplanation
<https://purl.org/heals/eo#DataExplanation> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.org/heals/eo#SafetyAndPerformanceExplanation> ;
                                            <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                            rdfs:comment "Focuses on what the data is and how it has been used in a particular decision, as well as what data and how it has been used to train and test the ML model. This type of explanation can help users understand the influence of data on decisions." ;
                                            rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                            rdfs:label "Data explanation" ;
                                            <http://www.w3.org/2004/02/skos/core#example> "How has the data been used to train the ML model?" ,
                                                                                          "How it has been used in a particular decision?" ,
                                                                                          "What the data is?" ;
                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ from an ‘AI method’ that has as input, a ‘dataset’ or part of it? Is there a ‘system recommendation’ that includes ‘object records’ that are used to train / test the ‘AI method’?" .


###  https://purl.org/heals/eo#RationaleExplanation
<https://purl.org/heals/eo#RationaleExplanation> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                 <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                 rdfs:comment "About the “why” of an ML decision and provides reasons that led to a decision, and is delivered in an accessible and understandable way, especially for lay users. If the ML decision was not what users expected, rationale explanations allows users to assess whether they believe the reasoning of the decision is flawed. While, if so, the explanation supports them to formulate reasonable arguments for why they think this is the case." ;
                                                 rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                 rdfs:label "Rationale explanation" ;
                                                 <http://www.w3.org/2004/02/skos/core#example> "Why was this ML decision made and provide reasons that led to a decision?" ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ from an ‘AI method’ that has a ‘system trace’? Is there a ‘local explanation’ output that an ‘explanation’ is based on?" .


###  https://purl.org/heals/eo#SafetyAndPerformanceExplanation
<https://purl.org/heals/eo#SafetyAndPerformanceExplanation> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                            <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                            rdfs:comment "Deals with steps taken across the design and implementation of an ML system to maximise the accuracy, reliability, security, and robustness of its decisions and behaviours. Safety and performance explanations help to assure individuals that an ML system is safe and reliable by explanation to test and monitor the accuracy, reliability, security, and robustness of the ML model." ;
                                                            rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                            rdfs:label "Safety and performance explanation" ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "How has the data been used to train the ML model?" ,
                                                                                                          "What steps were taken to ensure robustness and reliability of AI method?" ,
                                                                                                          "What steps were taken to ensure robustness and reliability of system?" ,
                                                                                                          "What were the plans for the system development?" ;
                                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ from an ‘AI method’ that is part of a ‘system’ that exposes its design ‘plans’? Is there a ‘system recommendation’ that includes ‘object records’ that are used to train / test the ‘AI method’?" .


###  https://purl.org/heals/eo#StatisticalExplanation
<https://purl.org/heals/eo#StatisticalExplanation> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                   <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                   rdfs:comment "Presents an account of the outcome based on data about the occurrence of events under specified (e.g., experimental) conditions. Statistical explanations refer to numerical evidence on the likelihood of factors or processes influencing the result." ;
                                                   rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                   rdfs:label "Statistical explanation" ;
                                                   <http://www.w3.org/2004/02/skos/core#example> "What percentage of people with this condition have recovered?" ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there ‘numerical evidence’/likelihood account of the ‘system recommendation’ based on data about the occurrence of the outcome described in the recommendation?" .


###  https://purl.org/heals/eo#SystemRecommendation
<https://purl.org/heals/eo#SystemRecommendation> rdf:type owl:Class ;
                                                 owl:disjointWith <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                  <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                  <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                 <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                 rdfs:comment "An output of an AI system, generated by an AI task using an AI method, on which an explanation is based." ;
                                                 rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                 rdfs:label "System recommendation" .


###  https://purl.org/heals/eo#scientificExplanation
<https://purl.org/heals/eo#scientificExplanation> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                  <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                  rdfs:comment "References the results of rigorous scientific methods, observations, and measurements." ;
                                                  rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                  rdfs:label "Scientific explanation" ;
                                                  <http://www.w3.org/2004/02/skos/core#example> "What studies have backed this recommendation?" ;
                                                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Are there results of rigorous ‘scientific methods’ to explain the situation? Is there ‘evidence’ from the literature to explain this ‘system recommendation’, ‘situation’ or ‘object record’?" .


###  https://purl.org/heals/eo#user
<https://purl.org/heals/eo#user> rdf:type owl:Class ;
                                 rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ;
                                 <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                 rdfs:comment "A person who consumes an explanation." ;
                                 rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                 rdfs:label "User" .


###  https://saref.etsi.org/core/UnitOfMeasure
<https://saref.etsi.org/core/UnitOfMeasure> rdf:type owl:Class ;
                                            owl:disjointWith <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                             <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                            rdfs:comment "The unit of measure is a standard for measurement of a quantity, such as a Property. For example,  Power is a property and Watt is a unit of power that represents a definite predetermined power: when we say 10 Watt, we actually mean 10 times the definite predetermined power called \\\"watt\\\". Our definition is based on the definition of unit of measure in the Ontology of units of Measure (OM). We propose here a list of some units of measure that are relevant for the purpose of SAREF, but this list can be extended, also using some other ontologies rather than the Ontology of units of Measure (OM)."@en ;
                                            rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                            rdfs:label "Unit of measure"@en .


###  https://saref.etsi.org/saref4ehaw/HealthDevice
<https://saref.etsi.org/saref4ehaw/HealthDevice> rdf:type owl:Class ;
                                                 rdfs:comment "Health devices, e.g. BAN hub, health sensor/actuator/Wereable."@en ;
                                                 rdfs:label "Health device"@en .


###  https://saref.etsi.org/saref4ehaw/HealthSensor
<https://saref.etsi.org/saref4ehaw/HealthSensor> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor> ,
                                                                 <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                                                 owl:disjointWith <https://saref.etsi.org/saref4ehaw/HealthWearable> ;
                                                 rdfs:comment "Health-related Sensor, sub-class of SAREF Sensor."@en ;
                                                 rdfs:label "Health sensor"@en .


###  https://saref.etsi.org/saref4ehaw/HealthWearable
<https://saref.etsi.org/saref4ehaw/HealthWearable> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                   <https://saref.etsi.org/saref4wear/WearableDevice> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/core/consistsOf> ;
                                                                     owl:someValuesFrom <https://saref.etsi.org/saref4ehaw/HealthSensor>
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/saref4wear/isLocatedOn> ;
                                                                     owl:someValuesFrom :MonitoredPerson
                                                                   ] ;
                                                   rdfs:comment "Health-related Wearable, sub-class of SAREF4WEAR Wearable."@en ;
                                                   rdfs:label "Health wearable"@en .


###  https://saref.etsi.org/saref4wear/BiometricProperty
<https://saref.etsi.org/saref4wear/BiometricProperty> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Property> ;
                                                      rdfs:comment "Class to group those properties related to the biometric characteristics of monitored individuals."@en ;
                                                      rdfs:label "Biometric property"@en .


###  https://saref.etsi.org/saref4wear/WearableDevice
<https://saref.etsi.org/saref4wear/WearableDevice> rdf:type owl:Class ;
                                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/saref4wear/isLocatedOn> ;
                                                                     owl:someValuesFrom :MonitoredPerson
                                                                   ] ;
                                                   rdfs:comment "A wearable device is a device that is intended to be located near, on or in an organism."@en ;
                                                   rdfs:label "Wearable device"@en .


#################################################################
#    Individuals
#################################################################

###  http://purl.obolibrary.org/obo/MAXO_0000001
<http://purl.obolibrary.org/obo/MAXO_0000001> rdf:type owl:NamedIndividual .


###  http://purl.org/phmo#AnthropometricFactor
:AnthropometricFactor rdf:type owl:NamedIndividual ,
                               :AnthropometricFactor .


###  http://purl.org/phmo#Approved
:Approved rdf:type owl:NamedIndividual ,
                   :ApprovalStatus ;
          rdfs:comment "Approval status of a health intervention that a clinician has reviewed and approved." ;
          rdfs:label "Approved" .


###  http://purl.org/phmo#BMI
:BMI rdf:type owl:NamedIndividual ,
              :AnthropometricProperty ;
     <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C1305855" ;
     <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Body mass index" ;
     rdfs:comment "An indicator of body density as determined by the relationship of body weight to body height. BMI = weight (kg)/height squared (m2)." ;
     rdfs:label "BMI" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BMI ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "An indicator of body density as determined by the relationship of body weight to body height. BMI = weight (kg)/height squared (m2)." ;
   rdfs:isDefinedBy "The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/D015992. Accessed 21 June 2023."
 ] .


###  http://purl.org/phmo#BMICategory
:BMICategory rdf:type owl:NamedIndividual ,
                      :AnthropometricFactor .


###  http://purl.org/phmo#BloodPressure
:BloodPressure rdf:type owl:NamedIndividual ,
                        :VitalSign ;
               <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0005823" ;
               rdfs:comment "Pressure of the blood on the arteries and other blood vessels." ;
               rdfs:label "Blood pressure" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BloodPressure ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Pressure of the blood on the arteries and other blood vessels." ;
   rdfs:isDefinedBy "The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/?term=D001794. Accessed 21 June 2023."
 ] .


###  http://purl.org/phmo#BodyHeight
:BodyHeight rdf:type owl:NamedIndividual ,
                     :AnthropometricProperty ;
            <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0005890" ;
            rdfs:comment "The distance from the sole to the crown of the head with body standing on a flat surface and fully extended." ;
            rdfs:label "Body height" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BodyHeight ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "The distance from the sole to the crown of the head with body standing on a flat surface and fully extended." ;
   rdfs:isDefinedBy "The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/68001827. Accessed 21 June 2023."
 ] .


###  http://purl.org/phmo#BodyWeight
:BodyWeight rdf:type owl:NamedIndividual ,
                     :AnthropometricProperty ;
            rdfs:comment "The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms." ;
            rdfs:label "Body weight" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :BodyWeight ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms." ;
   rdfs:isDefinedBy "The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/68001835. Accessed 21 June 2023."
 ] .


###  http://purl.org/phmo#Centimetre
:Centimetre rdf:type owl:NamedIndividual ,
                     <https://saref.etsi.org/core/UnitOfMeasure> ;
            rdfs:comment "Unit of measure for body height." ;
            rdfs:label "cm" .


###  http://purl.org/phmo#DemographicFactor
:DemographicFactor rdf:type owl:NamedIndividual ,
                            :DemographicFactor .


###  http://purl.org/phmo#Female
:Female rdf:type owl:NamedIndividual ,
                 :Sex ,
                 [ rdf:type owl:Class ;
                   owl:oneOf ( :Female
                               :Male
                               :Specified
                             )
                 ] ;
        rdfs:comment "Female sex, as a summary classification based on one or more clinical observations." ;
        rdfs:label "Female" .


###  http://purl.org/phmo#KGPerSquareMetre
:KGPerSquareMetre rdf:type owl:NamedIndividual ,
                           <https://saref.etsi.org/core/UnitOfMeasure> ;
                  rdfs:comment "Unit of measure for body mass index." ;
                  rdfs:label "kg/m2" .


###  http://purl.org/phmo#Kilogram
:Kilogram rdf:type owl:NamedIndividual ,
                   <https://saref.etsi.org/core/UnitOfMeasure> ;
          rdfs:comment "Unit of measure for body weight." ;
          rdfs:label "kg" .


###  http://purl.org/phmo#LifestyleFactor
:LifestyleFactor rdf:type owl:NamedIndividual ,
                          :HealthRiskFactor .


###  http://purl.org/phmo#Male
:Male rdf:type owl:NamedIndividual ,
               :Sex ,
               [ rdf:type owl:Class ;
                 owl:oneOf ( :Female
                             :Male
                             :Specified
                           )
               ] ;
      rdfs:comment "Male sex, as a summary classification based on one or more clinical observations." ;
      rdfs:label "Male" .


###  http://purl.org/phmo#MillimetersOfMercury
:MillimetersOfMercury rdf:type owl:NamedIndividual ,
                               <https://saref.etsi.org/core/UnitOfMeasure> ;
                      rdfs:comment "A non-SI unit of pressure equal to 1/760 of a standard atmosphere (a standard atmosphere being defined as equal to 101 325 pascals). One Torr is equal to 133.3223684 pascals." ;
                      rdfs:label "mmHg" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :MillimetersOfMercury ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "A non-SI unit of pressure equal to 1/760 of a standard atmosphere (a standard atmosphere being defined as equal to 101 325 pascals). One Torr is equal to 133.3223684 pascals." ;
   rdfs:isDefinedBy "https://ncithesaurus.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;ns=ncit&amp;code=C49670. Accessed 21 June 2023."
 ] .


###  http://purl.org/phmo#Normal
:Normal rdf:type owl:NamedIndividual ,
                 :BMICategory ;
        :hasHigherBMIThan :Underweight ;
        :hasLowerBMIThan :ObeseI ;
        rdfs:comment "BMI category" ;
        rdfs:label "Normal" .


###  http://purl.org/phmo#ObeseI
:ObeseI rdf:type owl:NamedIndividual ,
                 :BMICategory ;
        :hasHigherBMIThan :Normal ,
                          :Overweight ,
                          :Underweight ;
        :hasLowerBMIThan :ObeseII ;
        rdfs:comment "BMI category for a BMI from 30.0 to 34.9 kg/m2 (obesity class I)." ;
        rdfs:label "Obese I" .


###  http://purl.org/phmo#ObeseII
:ObeseII rdf:type owl:NamedIndividual ,
                  :BMICategory ;
         rdfs:comment "BMI category for a BMI from 35.0 to 39.9 kg/m2 (obesity class II)." ;
         rdfs:label "Obese II" .


###  http://purl.org/phmo#ObeseIII
:ObeseIII rdf:type owl:NamedIndividual ,
                   :BMICategory ;
          :hasHigherBMIThan :ObeseII ;
          rdfs:comment "BMI category for a BMI of 40.0 kg/m2 or above (obesity class III)." ;
          rdfs:label "Obese III" .


###  http://purl.org/phmo#Overweight
:Overweight rdf:type owl:NamedIndividual ,
                     :BMICategory ;
            :hasHigherBMIThan :Normal ,
                              :Underweight ;
            :hasLowerBMIThan :ObeseI ;
            rdfs:comment "BMI category for a BMI from 25.0 to 29.9 kg/m2." ;
            rdfs:label "Overweight" .


###  http://purl.org/phmo#Pending
:Pending rdf:type owl:NamedIndividual ,
                  :ApprovalStatus ;
         rdfs:comment "Default approval status of a health intervention that has not yet been reviewed by a clinician." ;
         rdfs:label "Pending" .


###  http://purl.org/phmo#Pre-approved
:Pre-approved rdf:type owl:NamedIndividual ,
                       :ApprovalStatus ;
              rdfs:comment "Approval status of a health intervention covered by a clinician's standing approval for the same intervention, monitored person and predicted event type." ;
              rdfs:label "Pre-approved" .


###  http://purl.org/phmo#Rejected
:Rejected rdf:type owl:NamedIndividual ,
                   :ApprovalStatus ;
          rdfs:comment "Approval status of a health intervention that a clinician has reviewed and rejected." ;
          rdfs:label "Rejected" .


###  http://purl.org/phmo#Sex
:Sex rdf:type owl:NamedIndividual ,
              :DemographicFactor .


###  http://purl.org/phmo#Specified
:Specified rdf:type owl:NamedIndividual ,
                    :Sex ,
                    [ rdf:type owl:Class ;
                      owl:oneOf ( :Female
                                  :Male
                                  :Specified
                                )
                    ] ;
           rdfs:comment "To quote directly from McClure et al. (2022): \" 'Specified' is preferable to the term 'Other' that is found in many value sets because it is nonstigmatizing and explicit.''" ;
           rdfs:label "Specified" .


###  http://purl.org/phmo#Underweight
:Underweight rdf:type owl:NamedIndividual ,
                      :BMICategory ;
             :hasLowerBMIThan :Normal ,
                              :ObeseI ,
                              :Overweight ;
             rdfs:comment "BMI category for a BMI below 18.5 kg/m2." ;
             rdfs:label "Underweight" .


