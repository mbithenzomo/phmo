    <rdfs:label xml:lang="en">Proceedings paper</rdfs:label>
    <rdfs:comment xml:lang="en">A paper, typically the realization of a research paper reporting original research findings, usually published within an academic proceedings volume.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#hasApprovalStatus">
    <rdfs:comment>The relationship between a health intervention and its approval status (approved, pre-approved, rejected, or pending).</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
