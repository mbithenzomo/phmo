    <rdfs:range rdf:nodeID="N4cbcb154fae048baa8ec2bc1db9e2497"/>
    <rdfs:label>is evidence for</rdfs:label>
    <rdfs:comment>The relationship between supporting evidence and a health risk relationship or health intervention.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://purl.org/phmo#isEvidencedBy"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
  </rdf:Description>
