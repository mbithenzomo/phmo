    <rdfs:label>is condition in prediction</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#isHealthEventInPrediction">
    <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionOfHealthEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is health event in prediction</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEvent"/>
    <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
    <rdfs:comment>The relationship between a health event and a health event prediction</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4ehaw/HealthDevice">
