  <rdf:Description rdf:about="https://purl.org/heals/eo#scientificExplanation">
    <skos:example>What studies have backed this recommendation?</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://purl.org/heals/eo"/>
    <dcterms:source>Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., &amp; McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282</dcterms:source>
    <skos:scopeNote>Are there results of rigorous ‘scientific methods’ to explain the situation? Is there ‘evidence’ from the literature to explain this ‘system recommendation’, ‘situation’ or ‘object record’?</skos:scopeNote>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
    <rdfs:label>Scientific explanation</rdfs:label>
    <rdfs:comment>References the results of rigorous scientific methods, observations, and measurements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc95db9dd6fa743918fdf5ce956fc0233">
