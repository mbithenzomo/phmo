    <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8faabe5224534e1d89c41ed681a88339">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:isDefinedBy>https://ncithesaurus.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;amp;ns=ncit&amp;amp;code=C49670. Accessed 21 June 2023.</rdfs:isDefinedBy>
    <owl:annotatedTarget>A non-SI unit of pressure equal to 1/760 of a standard atmosphere (a standard atmosphere being defined as equal to 101 325 pascals). One Torr is equal to 133.3223684 pascals.</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    <owl:annotatedSource rdf:resource="http://purl.org/phmo#MillimetersOfMercury"/>
  </rdf:Description>
