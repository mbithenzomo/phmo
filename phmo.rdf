  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/heals/eo#SystemRecommendation">
    <dcterms:source>Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., &amp; McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282</dcterms:source>
    <rdfs:comment>An output of an AI system, generated by an AI task using an AI method, on which an explanation is based.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
    <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
    <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
    <rdfs:label>System recommendation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://purl.org/heals/eo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#isComorbidityStatusOf">
    <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#isRiskFactorStatusOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is comorbidity status of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
    <rdfs:domain rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
    <rdfs:comment>The relationship between  a comorbidity risk factor status and a monitored person.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#isInputRiskFactorStateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
    <rdfs:comment>The relationship between a risk factor state and a health risk assessment for which it was an input.</rdfs:comment>
    <rdfs:label>is input risk factor state of</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncd85e9eadc5f49559704ff7eff68d4e8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:isDefinedBy>I. Horrocks and P. F. Patel-Schneider, “Knowledge Representation and Reasoning on the Semantic Web: OWL,” in Handbook of Semantic Web Technologies, Springer, 2011, pp. 365–398. https://doi.org/10.1007/978-3-540-92913-0_9</rdfs:isDefinedBy>
    <owl:annotatedSource rdf:resource="http://purl.org/phmo#MedicalCondition"/>
    <owl:annotatedTarget>All subclasses of this class are punned such that they are both classes and individuals. "In OWL 2 the same name can be used for a class, a property and an individual, a feature known as punning."</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0f6363a5cb4b45ebae2a108bc03785af">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onProperty rdf:resource="http://purl.org/phmo#hasRiskOfCondition"/>
    <owl:onClass rdf:resource="http://purl.org/phmo#MedicalCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/startTime">
    <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Deployment"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:comment xml:lang="en">The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
    <rdfs:label xml:lang="en">start time</rdfs:label>
    <skos:definition xml:lang="en">
  instant of time when the Execution or Deployment was initiated or tasked
  </skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#approvalStatusDeterminedByClinician">
    <rdfs:range rdf:resource="http://purl.org/phmo#Clinician"/>
    <rdfs:comment>The relationship between a health intervention and the clinician that determined its approval status.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://purl.org/phmo#determinedApprovalStatusForIntervention"/>
    <rdfs:label>approval status determined by clinician</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#isConditionInPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionOfCondition"/>
    <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
