  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/observedProperty">
    <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/wasObservedBy"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Property"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:comment>relation from an Observation or ObservationCollection to the property observed</rdfs:comment>
    <rdfs:label xml:lang="en">observed property</rdfs:label>
    <skos:note xml:lang="en">
  'observed property' covers the concepts referred to in [VIM] as 'measurand' (quantitative values) and 'examinand' (categorical and nominal values — [VIM4]), as well as complex and structured properties whose values may be represented as lists, vectors, arrays, rasters, geometries, etc. More specific terms are used in other contexts for related concepts, such as 'analyte' (chemistry) and 'determinand' (water quality).
  </skos:note>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
    <skos:definition xml:lang="en">
  relation from an Observation or ObservationCollection to the property observed
  </skos:definition>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
