  <rdf:Description rdf:nodeID="N43ba8a9d685d4f7c848c1f8972099d41">
    <owl:annotatedSource rdf:resource="http://purl.org/phmo#ArtificialNeuralNetwork"/>
    <owl:annotatedTarget>A neural network is a machine learning model that stacks simple "neurons" in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs.</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:isDefinedBy>"What is a neural network?", IBM Think, by Fangfang Lee. https://www.ibm.com/think/topics/neural-networks#741977106, accessed 10 July 2026.</rdfs:isDefinedBy>
  </rdf:Description>
