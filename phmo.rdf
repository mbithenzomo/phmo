  <rdf:Description rdf:about="http://purl.org/phmo#BMICategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:subClassOf rdf:nodeID="Na0d58a889a774eee82ad9782d007eabc"/>
    <rdfs:subClassOf rdf:nodeID="N9cf30af6266f4b02a4cbcd91d582377e"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
    <rdfs:label>BMI category</rdfs:label>
    <owl:equivalentClass rdf:nodeID="N88958c4e86744f5489e18f5eea7c440d"/>
    <rdfs:comment>For adults, BMI falls into the following categories:

- Underweight: below 18.5
- Normal: 18.5 - 24.9
- Overweight: 25.0 - 29.9
- Obese I: 30.0 - 34.9
- Obese II: 35.0 - 39.9
- Obese III: above 40.0</rdfs:comment>
  </rdf:Description>
