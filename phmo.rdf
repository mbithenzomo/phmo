  <rdf:Description rdf:nodeID="N99e5a918bd8b4ee8b33d3a3200502716">
    <rdfs:comment>A Publication can be considered an Expression of a Work.</rdfs:comment>
    <owl:annotatedTarget>http://purl.org/spar/fabio/Expression</owl:annotatedTarget>
    <obo:IAO_0000115>A subclass of FRBR expression, restricted to expressions of fabio:Works.  For your latest research paper, the preprint submitted to the publisher, and the final published version to which the publisher assigned a unique digital object identifier, are both expressions of the same work.</obo:IAO_0000115>
    <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
    <obo:IAO_0000119>FaBiO, the FRBR-aligned Bibliographic Ontology</obo:IAO_0000119>
    <owl:annotatedSource rdf:resource="http://purl.org/phmo#Publication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
