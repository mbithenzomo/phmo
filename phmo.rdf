  <rdf:Description rdf:nodeID="N50c3fd7ae88049d4a0ece0404978adca">
    <owl:annotatedTarget>Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction.</owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="http://purl.org/phmo#BayesianNetwork"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    <rdfs:isDefinedBy>Bayes Server Learning Center: https://www.bayesserver.com/docs/introduction/bayesian-networks/, accessed 10 July 2026.</rdfs:isDefinedBy>
  </rdf:Description>
