  <rdf:Description rdf:about="http://purl.org/phmo#hasInputObservation">
    <rdfs:label>has input observation</rdfs:label>
    <rdfs:comment>The relationship between a health event prediction and the continuous observation used as input to the model that computes it.</rdfs:comment>
