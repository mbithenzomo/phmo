<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/phmo#"
     xml:base="http://purl.org/phmo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:phmo="http://purl.org/phmo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:skos1="http://www.w3.org/2008/05/skos#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:sw-vocab-status="http://www.w3.org/2003/06/sw-vocab-status/">
    <owl:Ontology rdf:about="http://purl.org/phmo">
        <owl:versionIRI rdf:resource="http://purl.org/phmo/v1.0"/>
        <dc:creator>Mbithe Nzomo</dc:creator>
        <dc:title>Personal Health Monitoring Ontology (PHMO)</dc:title>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <rdfs:comment>The Personal Health Monitoring Ontology (PHMO) is a general ontology for personal health monitoring systems. It contains concepts reused from the following ontologies:

- Sensor, Observation, Sample, and Actuator (SOSA) Ontology
- Smart Applications REFerence (SAREF) Core Ontology
- SAREF4Wear Ontology
- SAREF4EHAW (eHealth and Ageing Well) Ontology
- Evidence and Conclusion Ontology (ECO)
- Medical Action Ontology (MAxO)
- FRBR-aligned Bibliographic Ontology (FaBiO)
- Friend of a Friend (FOAF) Ontology
- Data Catalog Vocabulary (DCAT)
- Explanation Ontology (EO) and Explanation Patterns Ontology (EP)

Metadata terms are reused from the Dublin Core Metadata Initiative (DCMI) Metadata Terms and the PRISM Basic Metadata Specification.

Health domain concepts have been manually cross-referenced to concepts from the Unified Medical Language System (UMLS) metathesaurus, which maps to several medical vocabularies and terminologies, including:

- SNOMED CT (US)
- Medical Subject Headings (MeSH) Thesaurus
- National Cancer Institute (NCI) Thesaurus
- MedlinePlus</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


