    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#BMI -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#BMI">
        <rdf:type rdf:resource="http://purl.org/phmo#AnthropometricProperty"/>
        <oboInOwl:hasDbXref>UMLS:C1305855</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Body mass index</oboInOwl:hasExactSynonym>
        <rdfs:comment>An indicator of body density as determined by the relationship of body weight to body height. BMI = weight (kg)/height squared (m2).</rdfs:comment>
        <rdfs:label>BMI</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#BMI"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>An indicator of body density as determined by the relationship of body weight to body height. BMI = weight (kg)/height squared (m2).</owl:annotatedTarget>
        <rdfs:isDefinedBy>The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/D015992. Accessed 21 June 2023.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#BMICategory -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#BMICategory">
        <rdf:type rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#BloodPressure -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#BloodPressure">
