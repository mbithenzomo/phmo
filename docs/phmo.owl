        <oboInOwl:hasDbXref>UMLS:C0005823</oboInOwl:hasDbXref>
        <rdfs:comment>Pressure of the blood on the arteries and other blood vessels.</rdfs:comment>
        <rdfs:label>Blood pressure</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#BloodPressure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Pressure of the blood on the arteries and other blood vessels.</owl:annotatedTarget>
        <rdfs:isDefinedBy>The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/?term=D001794. Accessed 21 June 2023.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#BodyHeight -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#BodyHeight">
        <rdf:type rdf:resource="http://purl.org/phmo#AnthropometricProperty"/>
        <oboInOwl:hasDbXref>UMLS:C0005890</oboInOwl:hasDbXref>
