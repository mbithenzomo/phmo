    <!-- http://www.geneontology.org/formats/oboInOwl#hasAlternativeId -->


    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasAlternativeId">
        <rdfs:comment>An alternative identifier of a term, typically that of a term merged into it.</rdfs:comment>
        <rdfs:label>has alternative identifier</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym -->


    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym">
