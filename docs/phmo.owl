        <rdfs:label>Body height</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#BodyHeight"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>The distance from the sole to the crown of the head with body standing on a flat surface and fully extended.</owl:annotatedTarget>
        <rdfs:isDefinedBy>The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/68001827. Accessed 21 June 2023.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#BodyWeight -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#BodyWeight">
        <rdf:type rdf:resource="http://purl.org/phmo#AnthropometricProperty"/>
        <rdfs:comment>The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms.</rdfs:comment>
        <rdfs:label>Body weight</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#BodyWeight"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>The mass or quantity of heaviness of an individual. It is expressed by units of pounds or kilograms.</owl:annotatedTarget>
        <rdfs:isDefinedBy>The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/68001835. Accessed 21 June 2023.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#Centimetre -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Centimetre">
        <rdf:type rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment>Unit of measure for body height.</rdfs:comment>
        <rdfs:label>cm</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#DemographicFactor -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#DemographicFactor">
        <rdf:type rdf:resource="http://purl.org/phmo#DemographicFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Female -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Female">
        <rdf:type rdf:resource="http://purl.org/phmo#Sex"/>
        <rdf:type>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Female"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Male"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Specified"/>
                </owl:oneOf>
            </owl:Class>
        </rdf:type>
        <rdfs:comment>Female sex, as a summary classification based on one or more clinical observations.</rdfs:comment>
        <rdfs:label>Female</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#KGPerSquareMetre -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#KGPerSquareMetre">
        <rdf:type rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment>Unit of measure for body mass index.</rdfs:comment>
        <rdfs:label>kg/m2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Kilogram -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Kilogram">
        <rdf:type rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment>Unit of measure for body weight.</rdfs:comment>
        <rdfs:label>kg</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#LifestyleFactor -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#LifestyleFactor">
        <rdf:type rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Male -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Male">
        <rdf:type rdf:resource="http://purl.org/phmo#Sex"/>
        <rdf:type>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Female"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Male"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Specified"/>
                </owl:oneOf>
            </owl:Class>
        </rdf:type>
        <rdfs:comment>Male sex, as a summary classification based on one or more clinical observations.</rdfs:comment>
        <rdfs:label>Male</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#MillimetersOfMercury -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#MillimetersOfMercury">
        <rdf:type rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment>A non-SI unit of pressure equal to 1/760 of a standard atmosphere (a standard atmosphere being defined as equal to 101 325 pascals). One Torr is equal to 133.3223684 pascals.</rdfs:comment>
        <rdfs:label>mmHg</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#MillimetersOfMercury"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>A non-SI unit of pressure equal to 1/760 of a standard atmosphere (a standard atmosphere being defined as equal to 101 325 pascals). One Torr is equal to 133.3223684 pascals.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://ncithesaurus.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;amp;ns=ncit&amp;amp;code=C49670. Accessed 21 June 2023.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#Normal -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Normal">
        <rdf:type rdf:resource="http://purl.org/phmo#BMICategory"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#Underweight"/>
        <hasLowerBMIThan rdf:resource="http://purl.org/phmo#ObeseI"/>
        <rdfs:comment>BMI category</rdfs:comment>
        <rdfs:label>Normal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#ObeseI -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#ObeseI">
        <rdf:type rdf:resource="http://purl.org/phmo#BMICategory"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#Normal"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#Overweight"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#Underweight"/>
        <hasLowerBMIThan rdf:resource="http://purl.org/phmo#ObeseII"/>
        <rdfs:comment>BMI category for a BMI from 30.0 to 34.9 kg/m2 (obesity class I).</rdfs:comment>
        <rdfs:label>Obese I</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#ObeseII -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#ObeseII">
        <rdf:type rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:comment>BMI category for a BMI from 35.0 to 39.9 kg/m2 (obesity class II).</rdfs:comment>
        <rdfs:label>Obese II</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#ObeseIII -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#ObeseIII">
        <rdf:type rdf:resource="http://purl.org/phmo#BMICategory"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#ObeseII"/>
        <rdfs:comment>BMI category for a BMI of 40.0 kg/m2 or above (obesity class III).</rdfs:comment>
        <rdfs:label>Obese III</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Overweight -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Overweight">
        <rdf:type rdf:resource="http://purl.org/phmo#BMICategory"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#Normal"/>
        <hasHigherBMIThan rdf:resource="http://purl.org/phmo#Underweight"/>
        <hasLowerBMIThan rdf:resource="http://purl.org/phmo#ObeseI"/>
        <rdfs:comment>BMI category for a BMI from 25.0 to 29.9 kg/m2.</rdfs:comment>
        <rdfs:label>Overweight</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Pending -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Pending">
        <rdf:type rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <rdfs:comment>Default approval status of a health intervention that has not yet been reviewed by a clinician.</rdfs:comment>
        <rdfs:label>Pending</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Pre-approved -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Pre-approved">
        <rdf:type rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <rdfs:comment>Approval status of a health intervention covered by a clinician&apos;s standing approval for the same intervention, monitored person and predicted event type.</rdfs:comment>
        <rdfs:label>Pre-approved</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Rejected -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Rejected">
        <rdf:type rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <rdfs:comment>Approval status of a health intervention that a clinician has reviewed and rejected.</rdfs:comment>
        <rdfs:label>Rejected</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Sex -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Sex">
        <rdf:type rdf:resource="http://purl.org/phmo#DemographicFactor"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Specified -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Specified">
        <rdf:type rdf:resource="http://purl.org/phmo#Sex"/>
        <rdf:type>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Female"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Male"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Specified"/>
                </owl:oneOf>
            </owl:Class>
        </rdf:type>
        <rdfs:comment>To quote directly from McClure et al. (2022): &quot; &apos;Specified&apos; is preferable to the term &apos;Other&apos; that is found in many value sets because it is nonstigmatizing and explicit.&apos;&apos;</rdfs:comment>
        <rdfs:label>Specified</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/phmo#Underweight -->


    <owl:NamedIndividual rdf:about="http://purl.org/phmo#Underweight">
        <rdf:type rdf:resource="http://purl.org/phmo#BMICategory"/>
        <hasLowerBMIThan rdf:resource="http://purl.org/phmo#Normal"/>
        <hasLowerBMIThan rdf:resource="http://purl.org/phmo#ObeseI"/>
        <hasLowerBMIThan rdf:resource="http://purl.org/phmo#Overweight"/>
        <rdfs:comment>BMI category for a BMI below 18.5 kg/m2.</rdfs:comment>
        <rdfs:label>Underweight</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MAXO_0000001">
        <obo:IAO_0000115>A clinically prescribed procedure, therapy, intervention, or recommendation.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-16T20:07:28+00:00</dc:date>
        <oboInOwl:hasDbXref>OGMS:0000096</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>health care process</oboInOwl:hasNarrowSynonym>
        <rdfs:comment>A clinically prescribed procedure, therapy, intervention, or recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical action</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>health care process</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OGMS:0000096</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/creator">
        <rdfs:comment>An entity primarily responsible for making the resource.</rdfs:comment>
        <rdfs:label>creator</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/title">
        <rdfs:comment>A name given to the resource.</rdfs:comment>
        <rdfs:label>title</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
        <vann:example>
        :my-report a fabio:Report ;
            dcterms:creator :john-doe .
    </vann:example>
        <rdfs:comment xml:lang="en">An entity primarily responsible for making the resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms"/>
        <rdfs:label xml:lang="en">has creator</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <skos:scopeNote xml:lang="en">Examples of a Creator include a person, an organization, or a service. Typically, the name of a Creator should be used to indicate the entity.</skos:scopeNote>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/dc/terms/license">
        <rdfs:comment>A legal document giving official permission to do something with the resource.</rdfs:comment>
        <rdfs:label>license</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/phmo#AnthropometricFactor">
        <rdfs:comment>A class to group risk factors for atrial fribrillation related to a person&apos;s body, e.g. height and BMI.</rdfs:comment>
        <rdfs:label>Anthropometric factor</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/phmo#BMICategory">
        <rdfs:comment>For adults, BMI falls into the following categories:

- Underweight: below 18.5
- Normal: 18.5 - 24.9
- Overweight: 25.0 - 29.9
- Obese I: 30.0 - 34.9
- Obese II: 35.0 - 39.9
- Obese III: above 40.0</rdfs:comment>
        <rdfs:label>BMI category</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/phmo#DemographicFactor">
        <rdfs:comment xml:lang="en">A class to group risk factors for atrial fribrillation related to a person&apos;s demographics. Demographics: the qualities (such as age and sex) of a specific group of people.</rdfs:comment>
        <rdfs:label>Demographic factor</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/phmo#LifestyleFactor">
        <rdfs:comment xml:lang="en">A class to group risk factors for atrial fribrillation related to a person&apos;s lifestyle and choices.</rdfs:comment>
        <rdfs:label>Lifestyle factor</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/phmo#Sex">
        <rdfs:comment>Summary sex classification element based on one or more clinical observations such as an organ survey, hormone levels, and chromosomal analysis.</rdfs:comment>
        <rdfs:label>Sex</rdfs:label>
        <skos:definition>Summary sex classification element based on one or more clinical observations such as an organ survey, hormone levels, and chromosomal analysis.</skos:definition>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#Sex"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
        <owl:annotatedTarget>Summary sex classification element based on one or more clinical observations such as an organ survey, hormone levels, and chromosomal analysis.</owl:annotatedTarget>
        <rdfs:isDefinedBy>McClure, Robert C., et al. &quot;Gender harmony: improved standards to support affirmative care of gender-marginalized people through inclusive gender and sex representation.&quot; Journal of the American Medical Informatics Association 29.2 (2022): 354-363. https://doi-org.ezproxy.uct.ac.za/10.1093/jamia/ocab196</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMI"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">18.5</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</xsd:maxExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMICategory"/>
                <owl:hasValue rdf:resource="http://purl.org/phmo#Normal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMI"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30.0</xsd:maxExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMICategory"/>
                <owl:hasValue rdf:resource="http://purl.org/phmo#Overweight"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMI"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</xsd:maxExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMICategory"/>
                <owl:hasValue rdf:resource="http://purl.org/phmo#ObeseI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasBMI"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
