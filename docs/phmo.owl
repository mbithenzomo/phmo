    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYearMonth -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn -->


    <owl:ObjectProperty rdf:about="http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isBasisOf"/>
        <rdfs:domain rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
        <rdfs:range rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <terms:source>Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., &amp; McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282</terms:source>
        <rdfs:comment>The relationship between an explanation and the system recommendation it is based on. The domain, range and inverse are added in AFMO.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl"/>
        <rdfs:label>is based on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/creator">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Author"/>
                    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#approvalStatusDeterminedByClinician -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#approvalStatusDeterminedByClinician">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#determinedApprovalStatusForIntervention"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Clinician"/>
        <rdfs:comment>The relationship between a health intervention and the clinician that determined its approval status.</rdfs:comment>
        <rdfs:label>approval status determined by clinician</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#calculatedExpectedUtilityForIntervention -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#calculatedExpectedUtilityForIntervention">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#expectedUtilityCalculatedByModel"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#BayesianDecisionNetwork"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a model (specifically a Bayesian decision network) and a health intervention whose expected utility it calculated.</rdfs:comment>
        <rdfs:label>recommended intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#determinedApprovalStatusForIntervention -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#determinedApprovalStatusForIntervention">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Clinician"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a clinician and a health intervention that they approved, pre-approved, or rejected.</rdfs:comment>
        <rdfs:label>determined approval status for intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#expectedUtilityCalculatedByModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#expectedUtilityCalculatedByModel">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#BayesianDecisionNetwork"/>
        <rdfs:comment>The relationship between a health intervention and the model (specifically a Bayesian decision network) that calculated its expected utility.</rdfs:comment>
        <rdfs:label>expected utility calculated by model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasApprovalStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasApprovalStatus">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isApprovalStatusOfIntervention"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <rdfs:comment>The relationship between a health intervention and its approval status (approved, pre-approved, rejected, or pending).</rdfs:comment>
        <rdfs:label>has approval status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasBMICategory -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasBMICategory">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasRiskFactorStatus"/>
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isBMICategoryOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:comment>The relationship between a monitored person and their BMI category.</rdfs:comment>
        <rdfs:label>has BMI category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasComorbidityStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasComorbidityStatus">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasRiskFactorStatus"/>
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isComorbidityStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
        <rdfs:comment>The relationship between a monitored person and a comorbidity risk factor status.</rdfs:comment>
        <rdfs:label>has comorbidity status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasEffectModifier -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasEffectModifier">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isEffectModifierInRelationship"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>Links a health risk relationship to another risk factor state that modifies the risk associated with the relationship&apos;s primary risk factor state.</rdfs:comment>
        <rdfs:label>has effect modifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasHigherBMIThan -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasHigherBMIThan">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#hasLowerBMIThan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:comment>Transitive property to add order to the BMICategory class.</rdfs:comment>
        <rdfs:label>has higher BMI than</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasInputObservation -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasInputObservation">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isInputOfPrediction"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:comment>The relationship between a health event prediction and the continuous observation used as input to the model that computes it.</rdfs:comment>
        <rdfs:label>has input observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasInputRiskFactor -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasInputRiskFactor">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isInputRiskFactorOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The relationship between a model and a risk factor it takes as input.</rdfs:comment>
        <rdfs:label>has input risk factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasInputRiskFactorState -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasInputRiskFactorState">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isInputRiskFactorStateOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The relationship between a health risk assessment and a risk factor state used as input to the model that computes it.</rdfs:comment>
        <rdfs:label>has input risk factor state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasLowerBMIThan -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasLowerBMIThan">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:comment>Transitive property to add order to the BMICategory class.</rdfs:comment>
        <rdfs:label>has lower BMI than</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasMedicalAction -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasMedicalAction">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isMedicalActionInIntervention"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <rdfs:comment>The relationship between a health intervention and the medical action it involves.</rdfs:comment>
        <rdfs:label>has medical action</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasPrediction -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasPrediction">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:comment>The relationship betweena monitored person and a health event prediction.</rdfs:comment>
        <rdfs:label>has prediction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasPredictionStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasPredictionStatus">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <rdfs:comment>The relationship between a health event prediction and its status (present or absent).</rdfs:comment>
        <rdfs:label>has prediction status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRecommendedIntervention -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRecommendedIntervention">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRecommendedFor"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a monitored person and a health intervention that has been recommended for them.</rdfs:comment>
        <rdfs:label>has recommended intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasResponseIntervention -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasResponseIntervention">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isInResponseTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthEventPrediction"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthRiskAssessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a health risk assessment or health event prediction and the health intervention that responds to it.</rdfs:comment>
        <rdfs:label>has response intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskAssessment -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskAssessment">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskAssessmentOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:comment>The relationship betweena monitored person and a health risk assessment.</rdfs:comment>
        <rdfs:label>has risk assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskFactor -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskFactor">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskFactorInRelationship"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#FactorRiskRelationship"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The link between a factor risk relationship and a risk factor.</rdfs:comment>
        <rdfs:label>has risk factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskFactorCategory -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskFactorCategory">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskFactorCategoryInRelationship"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#CategoryRiskRelationship"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The link between a category risk relationship and risk factor category.</rdfs:comment>
        <rdfs:label>has risk factor category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskFactorState -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskFactorState">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskFactorStateInRelationship"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The link between a state risk relationship and the risk factor state.</rdfs:comment>
        <rdfs:label>has risk factor state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskFactorStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskFactorStatus">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskFactorStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The relationship between a monitored person and their status for a specific risk factor.</rdfs:comment>
        <rdfs:label>has risk factor status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskOfCondition">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isConditionInRiskRelationship"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a health risk relationship and a medical condition.</rdfs:comment>
        <rdfs:label>has risk of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasRiskStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasRiskStatus">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <rdfs:comment>The relationship between a health risk assessment and a risk status (present or absent).</rdfs:comment>
        <rdfs:label>has risk status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#hasSex -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#hasSex">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasRiskFactorStatus"/>
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isSexOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Sex"/>
        <rdfs:comment>The relationship between a monitored person and their sex.</rdfs:comment>
        <rdfs:label>has sex</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isApprovalStatusOfIntervention -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isApprovalStatusOfIntervention">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:comment>The relationship between an approval status (approved, pre-approved, rejected, or pending) and a health intervention.</rdfs:comment>
        <rdfs:label>is approval status of intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isBMICategoryOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isBMICategoryOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#isRiskFactorStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#BMICategory"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a BMI category and a person who belongs to it.</rdfs:comment>
        <rdfs:label>is BMI category of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isBasisOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isBasisOf">
        <rdfs:domain rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <rdfs:range rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
        <rdfs:comment>The relationship between a system recommendation, knowledge or other entity and an explanation that is based on it.</rdfs:comment>
        <rdfs:label>is basis of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isCareRecipientOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isCareRecipientOf">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isCaregiverOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Caregiver"/>
        <rdfs:comment>The relationship between a monitored person and their caregiver.</rdfs:comment>
        <rdfs:label>is care recipient of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isCaregiverOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isCaregiverOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Caregiver"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a caregiver and their care recipient, a monitored person.</rdfs:comment>
        <rdfs:label>is caregiver of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isClinicianOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isClinicianOf">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPatientOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Clinician"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a clinician and their patient, a monitored person.</rdfs:comment>
        <rdfs:label>is clinician of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isComorbidityStatusOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isComorbidityStatusOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#isRiskFactorStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between  a comorbidity risk factor status and a monitored person.</rdfs:comment>
        <rdfs:label>is comorbidity status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isComorbidityStatusOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isComorbidityStatusOfCondition">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isConditionInComorbidityStatus"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a comorbidity factor status (i.e. present or absent) and a medical condition.</rdfs:comment>
        <rdfs:label>is comorbidity status of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isComponentOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isComponentOf">
        <owl:inverseOf rdf:resource="https://saref.etsi.org/core/consistsOf"/>
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4ehaw/HealthSensor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
                    <rdf:Description rdf:about="https://saref.etsi.org/saref4ehaw/HealthWearable"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The relationship between a component sensor and a wearable device.</rdfs:comment>
        <rdfs:label>is component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInComorbidityStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInComorbidityStatus">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
        <rdfs:comment>The relationship between a medical condition and its status as a comorbidity (i.e. present or absent).</rdfs:comment>
        <rdfs:label>is condition in comorbidity status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInHealthEvent -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInHealthEvent">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isHealthEventOfCondition"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <rdfs:comment>The relationship between a medical condition and a health event</rdfs:comment>
        <rdfs:label>is condition in health event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInPrediction -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInPrediction">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionOfCondition"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:comment>The relationship between medical condition and a health event prediction.</rdfs:comment>
        <rdfs:label>is condition in prediction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInPredictionStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInPredictionStatus">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionStatusOfCondition"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <rdfs:comment>The relationship between a medical condition and a health event prediction status (i.e. present or absent).</rdfs:comment>
        <rdfs:label>is condition in prediction status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInRiskAssessment -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInRiskAssessment">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskAssessmentOfCondition"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:comment>The relationship between medical condition and a health risk assessment.</rdfs:comment>
        <rdfs:label>is condition in risk assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInRiskRelationship -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInRiskRelationship">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <rdfs:comment>The relationship between a medical condition and a health risk relationship.</rdfs:comment>
        <rdfs:label>is condition in risk relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConditionInRiskStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConditionInRiskStatus">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskStatusOfCondition"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <rdfs:comment>The relationship between a medical condition and its status as a risk in a monitored person  (i.e. present or absent).</rdfs:comment>
        <rdfs:label>is condition in risk status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isConsumedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isConsumedBy">
        <owl:inverseOf rdf:resource="https://purl.org/heals/eo#consumes"/>
        <rdfs:domain rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
        <rdfs:range rdf:resource="https://purl.org/heals/eo#user"/>
        <rdfs:comment>The relationship between an explanation and a user it is provided to.</rdfs:comment>
        <rdfs:label>is consumed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isCreatorOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isCreatorOf">
        <owl:inverseOf rdf:resource="http://purl.org/dc/terms/creator"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Author"/>
                    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:comment>The relationship between an agent (author or organisation) and a publication they created or contributed to.</rdfs:comment>
        <rdfs:label>is creator of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isDeterminantOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isDeterminantOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isDeterminedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:comment>The relationship between an observation and a risk factor.  E.g. a BMI observation is a determinant of the BMI category.</rdfs:comment>
        <rdfs:label>is determinant of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isDeterminedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isDeterminedBy">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment>The relationship between a risk factor and an observation that is determined by it. E.g. BMI category is determined by a BMI observation.</rdfs:comment>
        <rdfs:label>is determined by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isEffectModifierInRelationship -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isEffectModifierInRelationship">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:comment>Links a risk factor state to a health risk relationship whose associated risk it modifies.</rdfs:comment>
        <rdfs:label>is effect modifier in relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isEvidenceFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isEvidenceFor">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isEvidencedBy"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthIntervention"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthRiskRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The relationship between supporting evidence and a health risk relationship or health intervention.</rdfs:comment>
        <rdfs:label>is evidence for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isEvidencedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isEvidencedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthIntervention"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthRiskRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <rdfs:comment>The relationship between a health risk relationship or health intervention and the  evidence that supports it.</rdfs:comment>
        <rdfs:label>is evidenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isHealthEventInPrediction -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isHealthEventInPrediction">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPredictionOfHealthEvent"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:comment>The relationship between a health event and a health event prediction</rdfs:comment>
        <rdfs:label>is health event in prediction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isHealthEventOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isHealthEventOfCondition">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a health event and a medical condition.</rdfs:comment>
        <rdfs:label>is health event of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isInResponseTo -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isInResponseTo">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthEventPrediction"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthRiskAssessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The relationship between a health intervention and the health risk assessment or health event prediction that it responds to.</rdfs:comment>
        <rdfs:label>is in response to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isInputOfPrediction -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isInputOfPrediction">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:comment>The relationship between a continuous observation and a health event prediction for which it was the input.</rdfs:comment>
        <rdfs:label>is input of prediction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isInputRiskFactorOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isInputRiskFactorOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:comment>The relationship between a risk factor and a model that takes it as input.</rdfs:comment>
        <rdfs:label>is input risk factor of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isInputRiskFactorStateOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isInputRiskFactorStateOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:comment>The relationship between a risk factor state and a health risk assessment for which it was an input.</rdfs:comment>
        <rdfs:label>is input risk factor state of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isMedicalActionInIntervention -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isMedicalActionInIntervention">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a medical action and a health intervention that involves it.</rdfs:comment>
        <rdfs:label>is medical action in intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPatientOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPatientOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Clinician"/>
        <rdfs:comment>The relationship between a monitored person and their clinician.</rdfs:comment>
        <rdfs:label>is patient of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPredictionOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPredictionOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a prediction of a health event and the monitored person for whom the event is predicted to occur.</rdfs:comment>
        <rdfs:label>is prediction of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPredictionOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPredictionOfCondition">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a health event prediction and the medical condition it is associated with.</rdfs:comment>
        <rdfs:label>is prediction of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPredictionOfHealthEvent -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPredictionOfHealthEvent">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <rdfs:comment>The relationship between a health event prediction and the health event it predicts, e.g. an AF episode.</rdfs:comment>
        <rdfs:label>is prediction of health event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPredictionStatusOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPredictionStatusOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:comment>The relationship between a health event prediction status (present or absent) and a health event prediction.</rdfs:comment>
        <rdfs:label>is prediction status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPredictionStatusOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPredictionStatusOfCondition">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a health event prediction status (i.e. present or absent) and a medical condition.</rdfs:comment>
        <rdfs:label>is prediction status of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPublicationOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPublicationOf">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#isPublishedAs"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <rdfs:comment>The relationship between a publication and the work (evidence) that is expressed within it.</rdfs:comment>
        <rdfs:label>is publication of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isPublishedAs -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isPublishedAs">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:comment>The relationship between evidence and the publication that reports it.</rdfs:comment>
        <rdfs:label>is published as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRecommendedFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRecommendedFor">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a health intervention and the monitored person for whom it is recommended.</rdfs:comment>
        <rdfs:label>is recommended for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskAssessmentOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskAssessmentOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a health risk assessment and the monitored person it assesses.</rdfs:comment>
        <rdfs:label>is risk assessment of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskAssessmentOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskAssessmentOfCondition">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a health risk assessment and the medical condition it assesses.</rdfs:comment>
        <rdfs:label>is risk assessment of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskFactorCategoryInRelationship -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskFactorCategoryInRelationship">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#CategoryRiskRelationship"/>
        <rdfs:comment>The link between a risk factor category and a category risk relationship.</rdfs:comment>
        <rdfs:label>is risk factor category in relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskFactorInRelationship -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskFactorInRelationship">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#FactorRiskRelationship"/>
        <rdfs:comment>The link between a risk factor and a factor risk relationship.</rdfs:comment>
        <rdfs:label>is risk factor in relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskFactorStateInRelationship -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskFactorStateInRelationship">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:comment>The link between a risk factor state and a state risk relationship.</rdfs:comment>
        <rdfs:label>is risk factor state in relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskFactorStatusOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskFactorStatusOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>A generalised relationship between a risk factor and a monitored person.</rdfs:comment>
        <rdfs:label>is risk factor status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskStatusOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskStatusOf">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:comment>The relationship between a risk status (present or absent) and a health risk assessment.</rdfs:comment>
        <rdfs:label>is risk status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isRiskStatusOfCondition -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isRiskStatusOfCondition">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment>The relationship between a risk status in a monitored individual (i.e. present or absent) and a medical condition.</rdfs:comment>
        <rdfs:label>is risk status of condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isSexOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isSexOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#isRiskFactorStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Sex"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a sex category and a person who belongs to it.</rdfs:comment>
        <rdfs:label>is sex of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#isUnitOfMeasureOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#isUnitOfMeasureOf">
        <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isMeasuredIn"/>
        <rdfs:domain rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment>The relationship between a unit of measure and a measurement.</rdfs:comment>
        <rdfs:label>is unit of measure of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#madeEventPrediction -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#madeEventPrediction">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#wasPredictedByModel"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:comment>The relationship between a model and a health event prediction that it made.</rdfs:comment>
        <rdfs:label>made event prediction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#madeRiskAssessment -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#madeRiskAssessment">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#wasAssessedByModel"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:comment>The relationship between a model and a health risk assessment that it made.</rdfs:comment>
        <rdfs:label>made risk assessment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wasAssessedByModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wasAssessedByModel">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:comment>The relationship between a health risk assessment and the model that made it.</rdfs:comment>
        <rdfs:label>was assessed by model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wasPredictedByModel -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wasPredictedByModel">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:comment>The relationship between a health event prediction and the model that made it.</rdfs:comment>
        <rdfs:label>was predicted by model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wasTestDataFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wasTestDataFor">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#wasTestedOn"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:comment>The relationship between a dataset and a model whose performance was evaluated on it.</rdfs:comment>
        <rdfs:label>was test data for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wasTestedOn -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wasTestedOn">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:comment>The relationship between a model and a dataset on which its performance was evaluated.</rdfs:comment>
        <rdfs:label>was tested on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wasTrainedOn -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wasTrainedOn">
        <owl:inverseOf rdf:resource="http://purl.org/phmo#wasTrainingDataFor"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:comment>The relationship between a model and a dataset from which it was constructed or trained.</rdfs:comment>
        <rdfs:label>was trained on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wasTrainingDataFor -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wasTrainingDataFor">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:comment>The relationship between a dataset and a model that was constructed or trained from it.</rdfs:comment>
        <rdfs:label>was training data for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/phmo#wearsDevice -->


    <owl:ObjectProperty rdf:about="http://purl.org/phmo#wearsDevice">
        <owl:inverseOf rdf:resource="https://saref.etsi.org/saref4wear/isLocatedOn"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:comment>The relationship between a person and the wearable device that is located on them.</rdfs:comment>
        <rdfs:label>wears device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/vocab/frbr/core#part -->


    <owl:ObjectProperty rdf:about="http://purl.org/vocab/frbr/core#part">
        <owl:inverseOf rdf:resource="http://purl.org/vocab/frbr/core#partOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Publication"/>
        <vann:example>
        :my-journal-issue a fabio:JournalIssue ;
            frbr:part :my-journal-article .
        </vann:example>
        <rdfs:comment xml:lang="en">A part of an endeavour.</rdfs:comment>
        <rdfs:comment xml:lang="en">A property indicating that one entity includes another entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/fabio"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <skos1:note xml:lang="en">Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive.</skos1:note>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/vocab/frbr/core#partOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/vocab/frbr/core#partOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#Publication"/>
        <vann:example>
        :my-journal-article a fabio:JournalArticle ;
            frbr:partOf :my-journal-issue .
    </vann:example>
        <rdfs:comment xml:lang="en">A property indicating that one entity is a part of another entity.</rdfs:comment>
        <rdfs:comment xml:lang="en">An endeavour incorporating another endeavour.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/fabio"/>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <skos1:note xml:lang="en">Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive.</skos1:note>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Deployment"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>relation from an Execution or Deployment to its subject entity i.e., from an Actuation to the entity whose property was modified; from an Observation to the entity whose quality was observed; from an act of Sampling to the entity that was sampled; or from a Deployment to its target</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
        <skos:definition xml:lang="en">
  relation from an Execution or Deployment to its subject entity

  i.e., from an Actuation to the entity whose property was modified;
  from an Observation to the entity whose quality was observed;
  from an act of Sampling to the entity that was sampled;
  or from a Deployment to its target
  </skos:definition>
        <skos:example xml:lang="en">For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight.</skos:example>
        <skos:scopeNote>This is the _proximate_ feature of interest, which may be a proxy entity such as a sample of the _ultimate_ feature of interest. Use `hasUltimateFeatureOfInterest` if the intention is to link to the _ultimate_ feature of interest. </skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasMember -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasMember">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isMemberOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment>link from a Collection to an Execution or Sample or Collection of these that is part of it</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label>has member of collection</rdfs:label>
        <skos:definition>
  link from a Collection to an Execution or Sample or Collection of these that is part of it
  </skos:definition>
        <skos:editorialNote>Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types</skos:editorialNote>
        <skos:scopeNote>rules for the consistency of values of properties of collections and properties of their members are given for each collection type</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasProperty">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isPropertyOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment>relation from an entity to a Property of that entity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">has property</rdfs:label>
        <skos:definition xml:lang="en">
  relation from an entity to a Property of that entity
  </skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isFeatureOfInterestOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isFeatureOfInterestOf">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Deployment"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment>relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it, or to a Deployment for which it is the subject.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">is feature of interest of</rdfs:label>
        <skos:definition xml:lang="en">
  relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it

  i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it,
  or to a Deployment for which it is the subject.
</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isMemberOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isMemberOf">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment>link from an Execution or Sample or Collection of these, to a collection that it is part of</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label>is member of collection</rdfs:label>
        <skos:definition>
  link from an Execution or Sample or Collection of these, to a collection that it is part of
  </skos:definition>
        <skos:editorialNote>Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types</skos:editorialNote>
        <skos:scopeNote>rules for the consistency of values of properties of collections and properties of their members are given for each collection type</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isObservedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isObservedBy">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/observes"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment xml:lang="en">Relation between an ObservableProperty and the Sensor able to observe it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">is observed by</rdfs:label>
        <skos:definition xml:lang="en">
  relation from a Property to a Sensor that is able to observe it
  </skos:definition>
        <skos:definition xml:lang="en">Relation between an ObservableProperty and the Sensor able to observe it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isPropertyOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isPropertyOf">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment>relation from a Property to a FeatureOfInterest that it is a quality of</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">is property of</rdfs:label>
        <skos:definition xml:lang="en">
  relation from a Property to a FeatureOfInterest that it is a quality of
  </skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">made by sensor</rdfs:label>
        <rdfs:label xml:lang="en">made by sensor or observer</rdfs:label>
        <skos:definition xml:lang="en">
  relation from an Observation or ObservationCollection to the Sensor involved
  </skos:definition>
        <skos:definition xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeObservation -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeObservation">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an Observation made by the Sensor.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">made observation</rdfs:label>
        <skos:definition xml:lang="en">
  relation from a Sensor to an Observation or ObservationCollection it has made
  </skos:definition>
        <skos:definition xml:lang="en">Relation between a Sensor and an Observation made by the Sensor.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observedProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/wasObservedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment>relation from an Observation or ObservationCollection to the property observed</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">observed property</rdfs:label>
        <skos:definition xml:lang="en">
  relation from an Observation or ObservationCollection to the property observed
  </skos:definition>
        <skos:note xml:lang="en">
  &apos;observed property&apos; covers the concepts referred to in [VIM] as &apos;measurand&apos; (quantitative values) and &apos;examinand&apos; (categorical and nominal values — [VIM4]), as well as complex and structured properties whose values may be represented as lists, vectors, arrays, rasters, geometries, etc. More specific terms are used in other contexts for related concepts, such as &apos;analyte&apos; (chemistry) and &apos;determinand&apos; (water quality).
  </skos:note>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observes -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observes">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an ObservableProperty that it is capable of sensing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">observes</rdfs:label>
        <skos:definition xml:lang="en">
  relation from a Sensor to a Property that it is capable of sensing
  </skos:definition>
        <skos:definition xml:lang="en">Relation between a Sensor and an ObservableProperty that it is capable of sensing.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/wasObservedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/wasObservedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment>relation from a Property to an Observation that observed it</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">was observed by</rdfs:label>
        <skos:definition xml:lang="en">
  relation from a Property to an Observation that observed it
  </skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/heals/eo#consumes -->


    <owl:ObjectProperty rdf:about="https://purl.org/heals/eo#consumes">
        <rdfs:domain rdf:resource="https://purl.org/heals/eo#user"/>
        <rdfs:range rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
        <terms:source>Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., &amp; McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282</terms:source>
        <rdfs:comment>The relationship between a user and an explanation they consume. The domain, range and inverse are added in AFMO.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://purl.org/heals/eo"/>
        <rdfs:label>is consumer of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/core/consistsOf -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/consistsOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
                    <rdf:Description rdf:about="https://saref.etsi.org/saref4ehaw/HealthWearable"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4ehaw/HealthSensor"/>
        <rdfs:comment xml:lang="en">A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)</rdfs:comment>
        <rdfs:label xml:lang="en">consists of</rdfs:label>
        <skos:historyNote xml:lang="en">V3.2.1: Add local restrictions on consistsOf on feature of interest</skos:historyNote>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/core/isMeasuredIn -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/isMeasuredIn">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment xml:lang="en">A relationship identifying the unit of measure used for a certain entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label xml:lang="en">is measured in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4wear/isLocatedOn -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4wear/isLocatedOn">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a wearable device and the person it is located on.</rdfs:comment>
        <rdfs:label>is located on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://prismstandard.org/namespaces/basic/2.0/doi -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/doi">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A Digital Object Identifier for a serial publication item, a dataset or some other entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.doi.org/"/>
        <rdfs:label xml:lang="en">has DOI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/edition -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/edition">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">An identifier for one of several alternative issues of a magazine, a book or other resource.</rdfs:comment>
        <rdfs:label xml:lang="en">has edition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/endingPage -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/endingPage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <vann:example>
        :my-print-object a fabio:PrintObject ;
            prism:endingPage &apos;186&apos; .
    </vann:example>
        <rdfs:comment xml:lang="en">A property used to identify the last page of an entity such as a journal article.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://prismstandard.org/namespaces/basic/2.0"/>
        <rdfs:label xml:lang="en">has ending page</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/isbn -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/isbn">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The International Standard Book Number, ISBN, used to identify published books or, more rarely, journal issues.</rdfs:comment>
        <rdfs:label xml:lang="en">has ISBN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/issueIdentifier -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/issueIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/JournalIssue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>A system generated unique publisher identifier for the issue of a serial publication.   The issue identifies should not be confused with the &quot;special&quot; issue name element, prism:issueName.</rdfs:comment>
        <rdfs:isDefinedBy>http://prismstandard.org/namespaces/basic/2.0/issueIdentifier</rdfs:isDefinedBy>
        <rdfs:label>has issue identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/pageRange -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/pageRange">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <vann:example>
        :my-journal-article a fabio:JournalArticle ;
            prism:pageRange &apos;145-162&apos; .
    </vann:example>
        <rdfs:comment xml:lang="en">A property used to identify the page range of an entity such as a journal article.</rdfs:comment>
        <rdfs:comment xml:lang="en">Identifies the page range of an entity such as a journal article.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://prismstandard.org/namespaces/basic/2.0"/>
        <rdfs:label xml:lang="en">has page range</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/startingPage -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/startingPage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <vann:example>
        :my-print-object a fabio:PrintObject ;
            prism:startingPage &apos;171&apos; .
    </vann:example>
        <rdfs:comment xml:lang="en">A property used to identify the first page of an entity such as a journal article.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://prismstandard.org/namespaces/basic/2.0"/>
        <rdfs:label xml:lang="en">has starting page</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://prismstandard.org/namespaces/basic/2.0/volume -->


    <owl:DatatypeProperty rdf:about="http://prismstandard.org/namespaces/basic/2.0/volume">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/spar/fabio/JournalVolume"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <vann:example>
        :my-journal-volume a fabio:JournalVolume ;
            prism:volume &apos;15&apos; .
    </vann:example>
        <rdfs:comment xml:lang="en">An identifier for a particular volume of a resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://prismstandard.org/namespaces/basic/2.0"/>
        <rdfs:label xml:lang="en">has volume identifier</rdfs:label>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <skos:scopeNote xml:lang="en">Examples include a journal or a multi-volume book.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Publication"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#anyURI"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#int"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A unique and unambiguous reference to the resource within a given context.

Recommended best practice is to identify the resource by means of a string conforming to a formal identification system.</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A name given to a resource.  Typically, the title will be the name by which the resource is formally known.</rdfs:comment>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasAUPRC -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasAUPRC">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The area under the precision-recall curve of a model.</rdfs:comment>
        <rdfs:label>has AUPRC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasAUROC -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasAUROC">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The area under the receiver operating characteristic curve of a model.</rdfs:comment>
        <rdfs:label>has AUROC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasAge -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasAge">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>A person&apos;s age in years.</rdfs:comment>
        <rdfs:label>has age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasApprovalStatusTimestamp -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasApprovalStatusTimestamp">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/hasTimestamp"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment>The timestamp at which a health intervention&apos;s approval status was determined by a clinician. In the case of the default approval status (i.e. &quot;pending&quot;), the value is the same as the recommendation timestamp.</rdfs:comment>
        <rdfs:label>has approval status timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasBMI -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasBMI">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>A monitored person&apos;s body mass index as computed from their most recent height and weight observations.</rdfs:comment>
        <rdfs:label>has BMI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasBrierScore -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasBrierScore">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The Brier score of a model, i.e. the mean squared difference between its predicted probabilities and the observed outcomes.</rdfs:comment>
        <rdfs:label>has Brier Score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasCategoryWeight -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasCategoryWeight">
        <rdfs:domain rdf:resource="http://purl.org/phmo#CategoryRiskRelationship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Category weight represents how much influence a risk factor category has on the risk of the condition relative to the other categories.</rdfs:comment>
        <rdfs:label>has category weight</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasDataStoreURI -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasDataStoreURI">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Link to external data store where raw time series data is stored.</rdfs:comment>
        <rdfs:label>has data store URI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasDateOfConfirmation -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasDateOfConfirmation">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>The date on which personal data was last confirmed and/or updated.</rdfs:comment>
        <rdfs:label>has date of confirmation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasDecisionThreshold -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasDecisionThreshold">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The probability at or above which a model assigns the positive status, e.g. AF risk present or AF episode present.</rdfs:comment>
        <rdfs:label>has decision threshold</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasDuration -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasDuration">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment>The duration of a continuous observation.</rdfs:comment>
        <rdfs:label>has duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasExpectedCalibrationError -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasExpectedCalibrationError">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The expected calibration error of a model, i.e. the weighted average difference between its predicted probabilities and the observed event frequencies across probability bins.</rdfs:comment>
        <rdfs:label>has expected calibration error</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasExpectedUtility -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasExpectedUtility">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The expected utility of a health intervention as computed by a Bayesian decision network.</rdfs:comment>
        <rdfs:label>has expected utility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasF1Score -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasF1Score">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <oboInOwl:hasExactSynonym>has F-measure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>has F-score</oboInOwl:hasExactSynonym>
        <rdfs:comment>The F1 score of a model, i.e. the harmonic mean of its precision and recall at its decision threshold.</rdfs:comment>
        <rdfs:label>has F1 Score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasFactorWeight -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasFactorWeight">
        <rdfs:domain rdf:resource="http://purl.org/phmo#FactorRiskRelationship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Factor weight represents how much influence a risk factor has on the risk of the condition relative to the other risk factors in the same category.</rdfs:comment>
        <rdfs:label>has factor weight</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasICD10Block -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasICD10Block">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ICD10 block associated with a medical condition.</rdfs:comment>
        <rdfs:label>has ICD10 block</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasICD10Code -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasICD10Code">
        <rdfs:domain rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ICD10 code associated with a medical condition.</rdfs:comment>
        <rdfs:label>has ICD10 code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasIDNumber -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasIDNumber">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier for a monitored person, such as a national ID number.</rdfs:comment>
        <rdfs:label>has ID number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasInputType -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasInputType">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ArtificialNeuralNetwork"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>ECG</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>RR interval</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>The type of input signal a model takes: the raw ECG or the RR interval series derived from it.</rdfs:comment>
        <rdfs:label>has input type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasInputWindow -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasInputWindow">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment>The duration of the continuous observation used as input to compute a health event prediction.</rdfs:comment>
        <rdfs:label>has input window</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasPerformanceMetric -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasPerformanceMetric">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>A measure of the performance of a model, evaluated on a test dataset.</rdfs:comment>
        <rdfs:label>has performance metric</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasPredictionHorizon -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasPredictionHorizon">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment>How far ahead a health event prediction is made, i.e. the duration between the end of the input window and the start of the target window.</rdfs:comment>
        <rdfs:label>has prediction horizon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasProbability -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasProbability">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthEventPrediction"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#HealthRiskAssessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The probability associated with a health risk assessment or prediction of a health event.</rdfs:comment>
        <rdfs:label>has probability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasPublicationMonthYear -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasPublicationMonthYear">
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>The month and/or year when a publication was published.</rdfs:comment>
        <rdfs:label>has publication month and/or year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasRecall -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasRecall">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The recall (sensitivity) of a model, i.e. the proportion of positive cases it classifies as positive at its decision threshold.</rdfs:comment>
        <rdfs:label>has recall</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasRecommendationTimestamp -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasRecommendationTimestamp">
        <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/hasTimestamp"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment>The timestamp at which a health intervention was recommended by a model.</rdfs:comment>
        <rdfs:label>has recommendation timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasSamplingFrequency -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasSamplingFrequency">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The sampling frequency in Hz of an ECG observation.</rdfs:comment>
        <rdfs:label>has sampling frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasSpecificity -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasSpecificity">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/phmo#hasPerformanceMetric"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The specificity of a model, i.e. the proportion of negative cases it classifies as negative at its decision threshold.</rdfs:comment>
        <rdfs:label>has specificity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasStateRisk -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasStateRisk">
        <rdfs:domain rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>State risk represents the risk of a condition for a particular risk factor state.</rdfs:comment>
        <rdfs:label>has state risk</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasTargetWindow -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasTargetWindow">
        <rdfs:domain rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment>The period, following the prediction horizon, within which the predicted health event is expected to begin.</rdfs:comment>
        <rdfs:label>has target window</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/phmo#hasText -->


    <owl:DatatypeProperty rdf:about="http://purl.org/phmo#hasText">
        <rdfs:domain rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The text of an explanation as presented to a user.</rdfs:comment>
        <rdfs:label>has text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/spar/fabio/hasPageCount -->


    <owl:DatatypeProperty rdf:about="http://purl.org/spar/fabio/hasPageCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">The count of the number of pages in a textual resource.</rdfs:comment>
        <rdfs:label xml:lang="en">has page count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/endTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/endTime">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Deployment"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <rdfs:comment xml:lang="en">The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">end time</rdfs:label>
        <skos:definition xml:lang="en">
  instant of time when the Execution or Deployment was ended or completed
  </skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/startTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/startTime">
        <rdfs:domain rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Deployment"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment xml:lang="en">The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">start time</rdfs:label>
        <skos:definition xml:lang="en">
  instant of time when the Execution or Deployment was initiated or tasked
  </skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/birthday -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/birthday">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <oboInOwl:hasRelatedSynonym>has birthday</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The date on which a person was born.</rdfs:comment>
        <rdfs:label>has date of birth</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/firstName -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/firstName">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <oboInOwl:hasExactSynonym>hasGivenName</oboInOwl:hasExactSynonym>
        <rdfs:comment>A person&apos;s first or given name as per their identity document.</rdfs:comment>
        <rdfs:label>has first name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/name -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/name">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A name for some thing.</rdfs:comment>
        <rdfs:comment>A person&apos;s name.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://xmlns.com/foaf/0.1/"/>
        <rdfs:label>has full name</rdfs:label>
        <rdfs:label>name</rdfs:label>
        <ns:term_status>testing</ns:term_status>
    </owl:DatatypeProperty>
    


    <!-- http://xmlns.com/foaf/0.1/surname -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/surname">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <oboInOwl:hasExactSynonym>hasFamilyName</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>surname</oboInOwl:hasExactSynonym>
        <rdfs:comment>A person&apos;s last name, family name, or surname as per their identity document.</rdfs:comment>
        <rdfs:label>has last name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/core/hasManufacturer -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/core/hasManufacturer">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
        <skos:historyNote xml:lang="en">V3.2.1: Defined domain of saref:hasManufacturer to union of feature kind and feature of interest.</skos:historyNote>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/core/hasModel -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/core/hasModel">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag.</rdfs:comment>
        <rdfs:label xml:lang="en">has model</rdfs:label>
        <skos:historyNote xml:lang="en">V3.2.1: Defined domain of saref:hasModel to union of feature kind and feature of interest.</skos:historyNote>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/core/hasTimestamp -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/core/hasTimestamp">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#DiscreteObservation"/>
                    <rdf:Description rdf:about="https://purl.org/heals/eo#SystemRecommendation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">Links a procedure execution or a profile to an instant.</rdfs:comment>
        <rdfs:label xml:lang="en">has timestamp</rdfs:label>
        <skos:historyNote xml:lang="en">V3.2.1: Tried to clarify definition of saref:hasTimestamp. Still unclear.</skos:historyNote>
        <skos:note xml:lang="en">Applied on a profile, it describes the applicable instant of that profile</skos:note>
        <skos:note xml:lang="en">When the execution time and the phenomenon time are the same time instants, then DP saref:hasTimestamp can be used to simply link a procedure execution to the time of these instants, expressed as an xsd:dateTime literal.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/core/hasValue -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/core/hasValue">
        <rdfs:domain rdf:resource="http://purl.org/phmo#DiscreteObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A relationship defining the value of a certain property, e.g., energy or power. Note that, even if numeric values are expected to enable reasoning, measurement values could use other datatypes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://linkedu.eu/dedalo/explanationPattern.owl#Explanation -->


    <owl:Class rdf:about="http://linkedu.eu/dedalo/explanationPattern.owl#Explanation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isConsumedBy"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/heals/eo#user"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasText"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Model"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Publication"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <owl:disjointWith rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <terms:source>Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., &amp; McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282</terms:source>
        <rdfs:comment>An account, consumed by a user, that is based on a system recommendation and the knowledge used to produce it, and that addresses a question the user has.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://linkedu.eu/dedalo/explanationPattern.owl"/>
        <rdfs:label>Explanation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000000 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000000">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isEvidenceFor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isEvidenceFor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPublishedAs"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#Publication"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Model"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Publication"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>evidence code</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>evidence_code</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECO:0000000</oboInOwl:id>
        <rdfs:comment>A type of information that is used to support an assertion.</rdfs:comment>
        <rdfs:label>Evidence</rdfs:label>
        <skos:definition>A type of information that is used to support an assertion.</skos:definition>
        <skos:relatedMatch rdf:resource="https://purl.org/heals/eo#ScientificKnowledge"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
        <owl:annotatedTarget>A type of information that is used to support an assertion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:MCC</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000180 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <oboInOwl:hasDbXref>http://purl.org/spar/fabio/ClinicalTrialReport</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000180</oboInOwl:id>
        <rdfs:comment>A type of experimental evidence arising from a controlled investigation that uses human subjects.</rdfs:comment>
        <rdfs:label>Clinical study</rdfs:label>
        <skos:definition>A type of experimental evidence arising from a controlled investigation that uses human subjects.</skos:definition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000180"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.org/spar/fabio/ClinicalTrialReport</owl:annotatedTarget>
        <obo:IAO_0000115>The report of a pre-planned medical or veterinary clinical study of the safety, efficacy, or optimum dosage schedule of one or more diagnostic, therapeutic or prophylactic drugs, or of devices, treatments or techniques, involving a randomized controlled trial for evidence-based assessment in humans or animals selected according to predetermined criteria of eligibility and observed for evidence of favourable and unfavourable effects.</obo:IAO_0000115>
        <obo:IAO_0000119>FaBiO, the FRBR-aligned Bibliographic Ontology</obo:IAO_0000119>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000180"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
        <owl:annotatedTarget>A type of experimental evidence arising from a controlled investigation that uses human subjects.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:MCC</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000001">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isMedicalActionInIntervention"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <owl:disjointWith rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
    </owl:Class>
    


    <!-- http://purl.org/phmo#AnthropometricFactor -->


    <owl:Class rdf:about="http://purl.org/phmo#AnthropometricFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isDeterminedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#DiscreteObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#DemographicFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#LifestyleFactor"/>
    </owl:Class>
    


    <!-- http://purl.org/phmo#AnthropometricProperty -->


    <owl:Class rdf:about="http://purl.org/phmo#AnthropometricProperty">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/BiometricProperty"/>
        <rdfs:comment>Class to group those properties related to the body measurements of monitored individuals.</rdfs:comment>
        <rdfs:label>Anthropometric property</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#ApprovalStatus -->


    <owl:Class rdf:about="http://purl.org/phmo#ApprovalStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Approved"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Pending"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Pre-approved"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Rejected"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Model"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Publication"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <owl:disjointWith rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:comment>The approval status of a health intervention as determined by a clinician.</rdfs:comment>
        <rdfs:label>Approval status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#ArtificialNeuralNetwork -->


    <owl:Class rdf:about="http://purl.org/phmo#ArtificialNeuralNetwork">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasInputType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasExactSynonym>Deep learning model</oboInOwl:hasExactSynonym>
        <rdfs:comment>A neural network is a machine learning model that stacks simple &quot;neurons&quot; in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs.</rdfs:comment>
        <rdfs:label>Artificial neural network</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#ArtificialNeuralNetwork"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>A neural network is a machine learning model that stacks simple &quot;neurons&quot; in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs.</owl:annotatedTarget>
        <rdfs:isDefinedBy>&quot;What is a neural network?&quot;, IBM Think, by Fangfang Lee. https://www.ibm.com/think/topics/neural-networks#741977106, accessed 10 July 2026.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#Author -->


    <owl:Class rdf:about="http://purl.org/phmo#Author">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isCreatorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#Publication"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>The author of a publication.</rdfs:comment>
        <rdfs:label>Author</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#BMICategory -->


    <owl:Class rdf:about="http://purl.org/phmo#BMICategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/phmo#Normal"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#ObeseI"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#ObeseII"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#ObeseIII"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Overweight"/>
                    <rdf:Description rdf:about="http://purl.org/phmo#Underweight"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isDeterminedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#BodyHeightObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isDeterminedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#BodyWeightObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/phmo#BayesianDecisionNetwork -->


    <owl:Class rdf:about="http://purl.org/phmo#BayesianDecisionNetwork">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:comment>A Bayesian network extended with decision and utility nodes, used to compare the expected utility of alternative decisions, such as health interventions.</rdfs:comment>
        <rdfs:label>Bayesian decision network</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#BayesianNetwork -->


    <owl:Class rdf:about="http://purl.org/phmo#BayesianNetwork">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasInputRiskFactor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction.</rdfs:comment>
        <rdfs:label>Bayesian network</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#BayesianNetwork"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction.</owl:annotatedTarget>
        <rdfs:isDefinedBy>Bayes Server Learning Center: https://www.bayesserver.com/docs/introduction/bayesian-networks/, accessed 10 July 2026.</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#Biosignal -->


    <owl:Class rdf:about="http://purl.org/phmo#Biosignal">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4wear/BiometricProperty"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#VitalSign"/>
        <oboInOwl:hasExactSynonym>Biological signal</oboInOwl:hasExactSynonym>
        <rdfs:comment>Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle.</rdfs:comment>
        <rdfs:label>Biosignal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.org/phmo#Biosignal"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle.</owl:annotatedTarget>
        <rdfs:isDefinedBy>M. Escabí, “Biosignal Processing,” in Introduction to Biomedical Engineering, ch. 11, pp. 667–746, Elsevier Inc., 3 ed., 2012. https://doi.org/10.1016/B978-0-12-374979-6.00011-3</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/phmo#BodyHeightObservation -->


    <owl:Class rdf:about="http://purl.org/phmo#BodyHeightObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#DiscreteObservation"/>
        <rdfs:comment>A monitored person&apos;s height as determined by a measuring tape or a mechanical height machine.</rdfs:comment>
        <rdfs:label>Body height observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#BodyWeightObservation -->


    <owl:Class rdf:about="http://purl.org/phmo#BodyWeightObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#DiscreteObservation"/>
        <rdfs:comment>A monitored person&apos;s observed body weight as measured on a body weight scale.</rdfs:comment>
        <rdfs:label>Body weight observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#BodyWeightScale -->


    <owl:Class rdf:about="http://purl.org/phmo#BodyWeightScale">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4ehaw/HealthSensor"/>
        <rdfs:comment>A scale to measure body weight.</rdfs:comment>
        <rdfs:label>Body weight scale</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#Caregiver -->


    <owl:Class rdf:about="http://purl.org/phmo#Caregiver">
        <rdfs:subClassOf rdf:resource="https://purl.org/heals/eo#user"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Clinician"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>A caregiver of a monitored person.</rdfs:comment>
        <rdfs:label>Caregiver</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#CategoryRiskRelationship -->


    <owl:Class rdf:about="http://purl.org/phmo#CategoryRiskRelationship">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasRiskFactorCategory"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasCategoryWeight"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#FactorRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:comment>The relationship between a risk factor category and a medical condition.</rdfs:comment>
        <rdfs:label>Category risk relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#ClinicalRiskScore -->


    <owl:Class rdf:about="http://purl.org/phmo#ClinicalRiskScore">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
        <rdfs:comment>Risk scores provide a systematic and quantifiable assessment of the likelihood of health outcomes based on risk factors, allowing clinicians to stratify individuals into risk categories.</rdfs:comment>
        <rdfs:label>Clinical risk score</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#Clinician -->


    <owl:Class rdf:about="http://purl.org/phmo#Clinician">
        <rdfs:subClassOf rdf:resource="https://purl.org/heals/eo#user"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#determinedApprovalStatusForIntervention"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isClinicianOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>A clinician of a monitored person.</rdfs:comment>
        <rdfs:label>Clinician</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#ComorbidityFactor -->


    <owl:Class rdf:about="http://purl.org/phmo#ComorbidityFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isComorbidityStatusOfCondition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#MedicalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#DemographicFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#LifestyleFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <rdfs:comment xml:lang="en">A class to group comorbidity risk factors, i.e. the simultaneous presence of a medical condition co-occurring with atrial fibrillation.</rdfs:comment>
        <rdfs:label>Comorbidity factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#ContinuousObservation -->


    <owl:Class rdf:about="http://purl.org/phmo#ContinuousObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasDuration"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/endTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/startTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An observation of a property made over a series of time. Also known as a time series observation.</rdfs:comment>
        <rdfs:label>Continuous observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#DemographicFactor -->


    <owl:Class rdf:about="http://purl.org/phmo#DemographicFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#LifestyleFactor"/>
    </owl:Class>
    


    <!-- http://purl.org/phmo#DiscreteObservation -->


    <owl:Class rdf:about="http://purl.org/phmo#DiscreteObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasTimestamp"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An observation made at a particular instant in time.</rdfs:comment>
        <rdfs:label>Discrete observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#FactorRiskRelationship -->


    <owl:Class rdf:about="http://purl.org/phmo#FactorRiskRelationship">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasRiskFactor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasFactorWeight"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#StateRiskRelationship"/>
        <rdfs:comment>The relationship between a risk factor and a medical condition.</rdfs:comment>
        <rdfs:label>Factor risk relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#HealthEvent -->


    <owl:Class rdf:about="http://purl.org/phmo#HealthEvent">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isHealthEventOfCondition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#MedicalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Model"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Publication"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <owl:disjointWith rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:comment>A short-term, imminent occurrence associated with a specific medical condition.</rdfs:comment>
        <rdfs:label>Health event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#HealthEventPrediction -->


    <owl:Class rdf:about="http://purl.org/phmo#HealthEventPrediction">
        <rdfs:subClassOf rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasInputObservation"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasResponseIntervention"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthIntervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasPredictionStatus"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionOfCondition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#MedicalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionOfHealthEvent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#HealthEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#wasPredictedByModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasInputWindow"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasPredictionHorizon"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasProbability"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasTargetWindow"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/hasTimestamp"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Model"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Publication"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:comment>A prediction of a health event in a monitored person as computed by a model.</rdfs:comment>
        <rdfs:label>Health event prediction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#HealthEventPredictionStatus -->


    <owl:Class rdf:about="http://purl.org/phmo#HealthEventPredictionStatus">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionStatusOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionStatusOfCondition"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#MedicalCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthIntervention"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskStatus"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#MedicalCondition"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Model"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#Publication"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <owl:disjointWith rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:comment>The status for a medical conditon event (i.e. present or absent) in a monitored person.</rdfs:comment>
        <rdfs:label>Health event prediction status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/phmo#HealthIntervention -->


    <owl:Class rdf:about="http://purl.org/phmo#HealthIntervention">
        <rdfs:subClassOf rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasMedicalAction"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isEvidencedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isRecommendedFor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isInResponseTo"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/phmo#HealthEventPrediction"/>
                            <rdf:Description rdf:about="http://purl.org/phmo#HealthRiskAssessment"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#approvalStatusDeterminedByClinician"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#Clinician"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#expectedUtilityCalculatedByModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#BayesianDecisionNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasApprovalStatus"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#ApprovalStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasApprovalStatusTimestamp"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasExpectedUtility"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasRecommendationTimestamp"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#HealthRiskRelationship"/>
