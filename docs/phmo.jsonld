  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A neural network is a machine learning model that stacks simple \"neurons\" in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
