  "@id" : "http://purl.org/phmo#BMI",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.geneontology.org/formats/oboInOwl#hasDbXref" : [ {
    "@value" : "UMLS:C1305855"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@value" : "Body mass index"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/phmo#AnthropometricProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An indicator of body density as determined by the relationship of body weight to body height. BMI = weight (kg)/height squared (m2)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BMI"
  } ]
}, {
  "@id" : "http://purl.org/phmo#BMICategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/phmo#AnthropometricFactor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "For adults, BMI falls into the following categories:\n\n- Underweight: below 18.5\n- Normal: 18.5 - 24.9\n- Overweight: 25.0 - 29.9\n- Obese I: 30.0 - 34.9\n- Obese II: 35.0 - 39.9\n- Obese III: above 40.0"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "BMI category"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/phmo#AnthropometricFactor"
  }, {
    "@id" : "_:genid78"
  }, {
    "@id" : "_:genid79"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid71"
  } ]
}, {
  "@id" : "http://purl.org/phmo#BayesianDecisionNetwork",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A Bayesian network extended with decision and utility nodes, used to compare the expected utility of alternative decisions, such as health interventions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Bayesian decision network"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/phmo#Model"
  } ]
}, {
  "@id" : "http://purl.org/phmo#BayesianNetwork",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Bayesian network"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/phmo#Model"
  }, {
    "@id" : "_:genid80"
  } ]
}, {
  "@id" : "http://purl.org/phmo#Biosignal",
