    "@value" : "The status of a vocabulary term, as used in some imported terms; a variant of the term status property."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "term status (variant)"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#altLabel",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An alternative lexical label for a resource."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "alternative label"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#definition",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A statement or formal explanation of the meaning of a concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "definition"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#editorialNote",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A note for an editor, translator or maintainer of the vocabulary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "editorial note"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#exactMatch",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A link between two concepts, indicating a high degree of confidence that they can be used interchangeably."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "exact match"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#example",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An example of the use of a concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "example"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#historyNote",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A note about the past state, use or meaning of a concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "history note"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#note",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A general note, for any purpose."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "note"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#prefLabel",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The preferred lexical label for a resource, in a given language."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "preferred label"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#relatedMatch",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A link between two concepts in different schemes, indicating an associative, non-hierarchical relationship."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "related match"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#scopeNote",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A note that helps to clarify the meaning or use of a concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "scope note"
  } ]
}, {
  "@id" : "http://www.w3.org/2008/05/skos#note",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A general note, for any purpose, using an earlier SKOS namespace."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "note (SKOS 2008)"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/dcat#Dataset",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A collection of data, published or curated by a single agent, and available for access or download in one or more representations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/dcat#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Dataset"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://purl.org/heals/eo#SystemRecommendation"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "entity that is the target of an Execution or Deployment i.e., whose property is being estimated by an Observation, or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling, or which is the target of Executions planned as part of a Deployment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Feature of interest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid219"
  }, {
    "@id" : "_:genid220"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Organization"
  }, {
    "@id" : "https://purl.org/heals/eo#SystemRecommendation"
  }, {
    "@id" : "https://saref.etsi.org/core/UnitOfMeasure"
  }, {
    "@id" : "https://saref.etsi.org/saref4ehaw/HealthDevice"
  }, {
    "@id" : "https://saref.etsi.org/saref4wear/WearableDevice"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  entity that is the target of an Execution or Deployment\n\n  i.e., whose property is being estimated by an Observation, \n  or whose property is being manipulated by an Actuator, \n  or which is being sampled or transformed in an act of Sampling, \n  or which is the target of Executions planned as part of a Deployment.\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "When measuring the height of a tree, the height is the observed Property, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuation."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/Observation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/obs/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid221"
  }, {
    "@id" : "_:genid222"
  }, {
    "@id" : "_:genid223"
  }, {
    "@id" : "_:genid224"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Agent"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Person"
  }, {
    "@id" : "https://purl.org/heals/eo#SystemRecommendation"
  }, {
    "@id" : "https://saref.etsi.org/core/UnitOfMeasure"
  }, {
    "@id" : "https://saref.etsi.org/saref4ehaw/HealthDevice"
  }, {
    "@id" : "https://saref.etsi.org/saref4wear/WearableDevice"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  act of carrying out an ObservingProcedure using a Sensor to estimate or calculate a value of an observable Property of a FeatureOfInterest\n  "
  }, {
    "@language" : "en",
    "@value" : "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@value" : "\n  When the feature of interest cannot be observed directly, a sample of it might be used in Observations as a proxy for it. In such case, the Sample is the proximate Feature of Interest of the Observation, while the (ultimate) Feature of Interest of the act of Sampling (i.e., the entity that the Sample is ultimately 'isSampleOf') is the ultimate Feature of Interest of the Observation.\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "\n  An Observation primarily concerns a single Property of a single FeatureOfInterest. \n  Observations of multiple properties, or other combinations of Observations, may be described in an ObservationCollection. \n  \n  Alternatively, applications may choose to encapsulate complexity by defining a complex property with multiple individual components, and a corresponding complex result (e.g., a vector). \n  This approach is not prohibited by the SSN Ontology, but the details are beyond the scope of SSN.\n  "
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/ObservationCollection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "set of Observations or ObservationCollections; collections may be nested All Observation properties may appear in an Observation Collection, including: hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. The following consistency rules apply with respect to the Observation properties listed above: 1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property. 2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property. That property MAY then be omitted in any member Observation or Observation Collection. 3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. 4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval. 5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/obs/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Observation collection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid225"
  }, {
    "@id" : "_:genid226"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Agent"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Person"
  }, {
    "@id" : "https://purl.org/heals/eo#SystemRecommendation"
  }, {
    "@id" : "https://saref.etsi.org/core/UnitOfMeasure"
  }, {
    "@id" : "https://saref.etsi.org/saref4ehaw/HealthDevice"
  }, {
    "@id" : "https://saref.etsi.org/saref4wear/WearableDevice"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  set of Observations or ObservationCollections; collections may be nested\n\n  All Observation properties may appear in an Observation Collection, including: \n  hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : \n  If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. \n  The following consistency rules apply with respect to the Observation properties listed above: \n  \n  1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property.\n\n  2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property.  That property MAY then be omitted in any member Observation or Observation Collection.\n\n  3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. \n  \n  4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval.\n\n  5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals.\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "An instance of ObservationCollection represents a container for a set of data derived from observations.\n  This broadly corresponds with the class Dataset from DCAT."
  }, {
    "@language" : "en",
    "@value" : "The members of a collection do not necessarily share a common value for any property. "
  }, {
    "@value" : "The results of collections of observations are often packaged in a 'data cube' whose axes define the\n      range of properties of the set of observations."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/Property",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "identifiable quality of features of interest that can be observed or acted upon A property can apply to different features of interest."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid227"
  }, {
    "@id" : "_:genid228"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Agent"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/Person"
  }, {
    "@id" : "https://purl.org/heals/eo#SystemRecommendation"
  }, {
    "@id" : "https://saref.etsi.org/core/UnitOfMeasure"
  }, {
    "@id" : "https://saref.etsi.org/saref4ehaw/HealthDevice"
  }, {
    "@id" : "https://saref.etsi.org/saref4wear/WearableDevice"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  identifiable quality of features of interest that can be observed or acted upon\n\n  A property can apply to different features of interest.\n\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Cars (a feature type) all have a characteristic colour, where 'colour' is a property."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Concepts from existing code lists, vocabularies, and taxonomies, may be used as instances of Property"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/Sensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "System that implements an ObservingProcedure to determine the value of an observable Property This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation). A Sensor responds to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/obs/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Sensor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid229"
  }, {
    "@id" : "_:genid230"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://xmlns.com/foaf/0.1/Person"
  }, {
    "@id" : "https://purl.org/heals/eo#SystemRecommendation"
  }, {
    "@id" : "https://saref.etsi.org/core/UnitOfMeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Observer"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  System that implements an ObservingProcedure to determine the value of an observable Property\n\n  This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation).\n\n  A Sensor responds to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations.\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smartphone (which acts as Host or Platform). Other examples of Sensors include the human eyes."
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@value" : "The UML class 'Observer' from ISO 19156:2023 is implemented in SOSA by the OWL/RDFS class 'Sensor'. The class name 'Sensor' is preferred for backward compatibility with existing SOSA deployments. "
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Sensor"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/endTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Deployment"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Execution"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ExecutionCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://purl.org/phmo#ContinuousObservation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "end time"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  instant of time when the Execution or Deployment was ended or completed\n  "
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/hasFeatureOfInterest",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Deployment"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Execution"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ExecutionCollection"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  } ],
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relation from an Execution or Deployment to its subject entity i.e., from an Actuation to the entity whose property was modified; from an Observation to the entity whose quality was observed; from an act of Sampling to the entity that was sampled; or from a Deployment to its target"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid22"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has feature of interest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/isFeatureOfInterestOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  relation from an Execution or Deployment to its subject entity\n\n  i.e., from an Actuation to the entity whose property was modified;\n  from an Observation to the entity whose quality was observed;\n  from an act of Sampling to the entity that was sampled;\n  or from a Deployment to its target\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "This is the _proximate_ feature of interest, which may be a proxy entity such as a sample of the _ultimate_ feature of interest. Use `hasUltimateFeatureOfInterest` if the intention is to link to the _ultimate_ feature of interest. "
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/hasMember",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ExecutionCollection"
