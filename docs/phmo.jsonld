}, {
  "@id" : "http://purl.org/phmo",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Mbithe Nzomo"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@value" : "Personal Health Monitoring Ontology (PHMO)"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Personal Health Monitoring Ontology (PHMO) is a general ontology for personal health monitoring systems. It contains concepts reused from the following ontologies:\n\n- Sensor, Observation, Sample, and Actuator (SOSA) Ontology\n- Smart Applications REFerence (SAREF) Core Ontology\n- SAREF4Wear Ontology\n- SAREF4EHAW (eHealth and Ageing Well) Ontology\n- Evidence and Conclusion Ontology (ECO)\n- Medical Action Ontology (MAxO)\n- FRBR-aligned Bibliographic Ontology (FaBiO)\n- Friend of a Friend (FOAF) Ontology\n- Data Catalog Vocabulary (DCAT)\n- Explanation Ontology (EO) and Explanation Patterns Ontology (EP)\n\nMetadata terms are reused from the Dublin Core Metadata Initiative (DCMI) Metadata Terms and the PRISM Basic Metadata Specification.\n\nHealth domain concepts have been manually cross-referenced to concepts from the Unified Medical Language System (UMLS) metathesaurus, which maps to several medical vocabularies and terminologies, including:\n\n- SNOMED CT (US)\n- Medical Subject Headings (MeSH) Thesaurus\n- National Cancer Institute (NCI) Thesaurus\n- MedlinePlus"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "http://purl.org/phmo/v1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.0"
  } ]
}, {
  "@id" : "http://purl.org/phmo#AnthropometricFactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/phmo#AnthropometricFactor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A class to group risk factors for atrial fribrillation related to a person's body, e.g. height and BMI."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Anthropometric factor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/phmo#HealthRiskFactor"
  }, {
    "@id" : "_:genid62"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
