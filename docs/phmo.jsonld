    "@value" : "hasFamilyName"
  }, {
    "@value" : "surname"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A person's last name, family name, or surname as per their identity document."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
