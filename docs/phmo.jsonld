    "@value" : "Biological signal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Biosignal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
