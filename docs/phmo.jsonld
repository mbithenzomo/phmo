    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has member of collection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/isMemberOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "\n  link from a Collection to an Execution or Sample or Collection of these that is part of it\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "rules for the consistency of values of properties of collections and properties of their members are given for each collection type"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/hasProperty",
